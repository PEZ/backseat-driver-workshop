arts ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2016-11-04 09:28:17", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Bitter lemon", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Highball glass", :strInstructionsDE "Im Highball-Glas untermischen. Rühren. Mit einer Scheibe Kiwi garnieren.", :strDrinkAlternate nil, :strIngredient3 "Ice", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Versez Absolut Kurant dans une grande tasse à thé. Ajoutez le thé aux pommes pas trop chaud (!) et, si vous le souhaitez, un peu de sucre. Apprécier!", :strVideo nil, :strInstructions "Pour Absolut Kurant into a comfortably big tea-cup. Add the not too hot(!) apple tea and, if you like, some sugar. Enjoy!", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "4 cl ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Kurant Tea", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/xrsrpr1441247464.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 " (if needed)\n", :strInstructionsES "Vierta Absolut Kurant en una taza de té cómodamente grande. Añade el té de manzana no demasiado caliente (!) y, si quieres, un poco de azúcar. ¡Disfrutar!", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Absolut Kurant", :idDrink "14456", :strInstructionsZH-HANT "將 Absolut Kurant 倒入舒適的大茶杯中。加入不太熱（！）的蘋果茶，如果您願意，可以添加一些糖。享受！", :strInstructionsZH-HANS "将 Absolut Kurant 倒入一个舒适的大茶杯中。添加不太热（！）的苹果茶，如果您愿意，可以添加一些糖。享受！", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Versare Absolut Kurant in una tazza da tè comodamente grande.\r\nAggiungete il tè alla mela non troppo caldo (!) E, se vi piace, dello zucchero.\r\nGodere!", :strMeasure2 "Turkish apple ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-09-03 03:31:04", :strMeasure8 nil, :strCategory "Coffee / Tea", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Tea", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Champagne flute", :strInstructionsDE "Geben Sie Absolut Kurant in eine bequeme, große Teetasse. Füge den nicht zu heißen(!) Apfeltee und, wenn du willst, etwas Zucker hinzu. Viel Spaß!", :strDrinkAlternate nil, :strIngredient3 "Sugar", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Remuer. Ajouter la crème fouettée sur le dessus.", :strVideo nil, :strInstructions "Stir. Add whipped cream to the top.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Kioki Coffee", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/uppqty1441247374.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 nil, :strInstructionsES "Remover. Agrega crema batida por encima.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Kahlua", :idDrink "16951", :strInstructionsZH-HANT "攪拌。在上面添加生奶油。", :strInstructionsZH-HANS "搅拌。在上面添加生奶油。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Versare tutti gli ingredienti nel bicchiere. Aggiungere la panna montata in cima. Agitare.", :strMeasure2 "1/2 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-09-03 03:29:34", :strMeasure8 nil, :strCategory "Coffee / Tea", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Brandy", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Coffee mug", :strInstructionsDE "Rühren. Die geschlagene Sahne dazugeben.", :strDrinkAlternate nil, :strIngredient3 "Coffee", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Kiwi", :strMeasure11 nil, :strInstructionsFR "Le martini au kiwi est un cocktail à la vodka très amusant et l'une des meilleures boissons à base de fruits frais. Bien qu'il existe plusieurs recettes, celle-ci est l'une des plus faciles à réaliser et c'est un martini vert absolument délicieux à boire.\n\nPour cette recette, il suffit de mélanger des tranches de kiwi avec du sirop simple, puis de secouer le tout avec de la vodka. C'est une boisson que tout le monde peut préparer en quelques minutes et un cocktail parfait pour mettre en valeur votre vodka préférée.", :strVideo nil, :strInstructions "The kiwi martini is a very fun vodka cocktail and it is one of the best drinks that makes use of fresh fruit. Though there are a few recipes floating around, this is one of the easiest and it is an absolutely delightful green martini to drink.\n\nFor this recipe, you'll simply muddle slices of kiwi with simple syrup, then shake it with vodka. It's a drink that anyone can mix up in minutes and a perfect cocktail to show off your favorite vodka.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "Green, Sharp", :strMeasure1 "1/2", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Kiwi Martini", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/bmxmyq1630407098.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 1/2 oz", :strInstructionsES "El martini de kiwi es un cóctel de vodka muy divertido y una de las mejores bebidas que utilizan fruta fresca. Aunque hay algunas recetas circulando por ahí, esta es una de las más fáciles y es un martini verde absolutamente delicioso de beber.\r\n\r\nPara esta receta, basta con mezclar rodajas de kiwi con sirope simple y agitarlo con vodka. Es una bebida que cualquiera puede preparar en minutos y un cóctel perfecto para presumir de tu vodka favorito.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Kiwi", :idDrink "178359", :strInstructionsZH-HANT "獼猴桃馬丁尼是一種非常有趣的伏特加雞尾酒，也是利用新鮮水果的最佳飲料之一。儘管有一些食譜，但這是最簡單的食譜之一，而且它是一種絕對令人愉悅的綠色馬丁尼。\n\n對於這個食譜，您只需將獼猴桃片與簡單的糖漿混合，然後與伏特加搖勻即可。這是一款任何人都可以在幾分鐘內調製的飲料，也是一款完美的雞尾酒，可以展示您最喜歡的伏特加。", :strInstructionsZH-HANS "猕猴桃马提尼是一种非常有趣的伏特加鸡尾酒，也是利用新鲜水果的最佳饮料之一。尽管有一些食谱，但这是最简单的食谱之一，而且它是一种绝对令人愉悦的绿色马提尼酒。\n\n对于这个食谱，您只需将猕猴桃片与简单的糖浆混合，然后与伏特加摇匀即可。这是一款任何人都可以在几分钟内调配出来的饮料，也是一款完美的鸡尾酒，可以展示您最喜欢的伏特加。", :strMeasure9 nil, :strMeasure7 "", :strInstructionsIT "Il kiwi martini è un cocktail a base di vodka molto divertente ed è uno dei migliori drink a base di frutta fresca. Anche se ci sono alcune ricette in giro, questa è una delle più facili ed è un martini verde assolutamente delizioso da bere.\n\nPer questa ricetta, dovrai semplicemente confondere le fette di kiwi con lo sciroppo e poi shakerarle con la vodka. È un drink che chiunque può preparare in pochi minuti ed è un cocktail perfetto per esaltare la tua vodka preferita.", :strMeasure2 "1 tsp", :strMeasure12 nil, :strMeasure10 nil, :dateModified nil, :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 "", :strMeasure14 nil, :strIngredient2 "Sugar Syrup", :strMeasure4 "Garnish with", :strMeasure5 "", :strIngredient6 nil, :strImageSource "https://www.instagram.com/p/CPbleOTsANf", :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "Der Kiwi Martini ist ein sehr lustiger Wodka-Cocktail und eines der besten Getränke, bei dem frisches Obst verwendet wird. Obwohl es ein paar Rezepte gibt, ist dies eines der einfachsten und ein absolut köstlicher grüner Martini zum Trinken.\n\nFür dieses Rezept vermischen Sie einfach Kiwischeiben mit Zuckersirup und schütteln sie dann mit Wodka. Es ist ein Getränk, das jeder in wenigen Minuten mixen kann, und ein perfekter Cocktail, um Ihren Lieblingswodka zur Geltung zu bringen.", :strDrinkAlternate nil, :strIngredient3 "Vodka", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Apple juice", :strMeasure11 nil, :strInstructionsFR "mélanger dans le verre", :strVideo nil, :strInstructions "mix in the glass", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "4 cl ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Ice", :strImageAttribution nil, :strDrink "Kiss me Quick", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/m7iaxu1504885119.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "7 cl ", :strInstructionsES "mezclar en el vaso", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Cranberry vodka", :idDrink "15026", :strInstructionsZH-HANT "在玻璃杯中混合", :strInstructionsZH-HANS "在玻璃杯中混合", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Versare tutti gli ingredienti in un bicchiere, mescola bene.", :strMeasure2 "2 cl ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-08 16:38:39", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Apfelkorn", :strMeasure4 "8 cl ", :strMeasure5 "cubes", :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Highball glass", :strInstructionsDE "Im Glas mischen.", :strDrinkAlternate nil, :strIngredient3 "Schweppes Russchian", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Triple sec", :strMeasure11 nil, :strInstructionsFR "Verser dans un grand verre avec des glaçons et remuer. Ajouter un peu de jus de canneberge selon le goût.", :strVideo nil, :strInstructions "Pour into a large glass with ice and stir. Add a little cranberry juice to taste.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 shot ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Cranberry juice", :strImageAttribution nil, :strDrink "Kool-Aid Shot", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/fegm621503564966.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 shot ", :strInstructionsES "Verter en un vaso grande con hielo y remover. Añada un poco de zumo de arándanos al gusto.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Vodka", :idDrink "13190", :strInstructionsZH-HANT "倒入裝有冰塊的大玻璃杯中並攪拌。加入少許酸果蔓汁調味。", :strInstructionsZH-HANS "倒入装有冰块的大玻璃杯中并搅拌。加入少许酸果蔓汁调味。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Versare in un bicchiere grande con ghiaccio e mescolare.\r\nAggiungere un po 'di succo di mirtillo rosso a piacere.", :strMeasure2 "1 shot ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-08-24 09:56:06", :strMeasure8 nil, :strCategory "Shot", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Amaretto", :strMeasure4 "1 shot ", :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Old-fashioned glass", :strInstructionsDE "In ein großes Glas mit Eis gießen und umrühren. Nach Belieben etwas Preiselbeersaft hinzufügen.", :strDrinkAlternate nil, :strIngredient3 "Sloe gin", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Ajoutez le Kool Aid dans un verre à double shot et garnissez de rhum. Claquez et tirez.", :strVideo nil, :strInstructions "Add Kool Aid to a double shot glass, and top with rum. Slam and shoot.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 oz light ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Kool First Aid", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/hfp6sv1503564824.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 nil, :strInstructionsES "Agregue Kool Aid a un vaso doble y cubra con ron. Golpea y dispara.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "151 proof rum", :idDrink "1