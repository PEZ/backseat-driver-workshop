Ingredient13 nil, :strIngredient5 "Cherry", :strImageAttribution nil, :strDrink "Casino", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/1mvjxg1504348579.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1/4 tsp ", :strInstructionsES "Vierta todos los ingredientes en una coctelera con cubitos de hielo. Agitar bien. Colar en una copa de cóctel fría. Decorar con un twist de limón y una cereza al marrasquino. Servir sin pajita.", :strIngredient15 nil, :strIBA "Unforgettables", :strIngredient11 nil, :strIngredient1 "Gin", :idDrink "17185", :strInstructionsZH-HANT "將所有原料倒入裝有冰塊的搖酒壺中。搖勻。濾入冰鎮的雞尾酒杯中。用檸檬片和櫻桃裝飾。無需吸管即可食用。", :strInstructionsZH-HANS "将所有原料倒入装有冰块的摇酒壶中。摇匀。滤入冰镇的鸡尾酒杯中。用柠檬片和樱桃装饰。无需吸管即可食用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Versare tutti gli ingredienti in uno shaker con cubetti di ghiaccio.\r\nAgitare bene.\r\nFiltrare in una coppetta da cocktail ghiacciata.\r\nGuarnire con una scorza di limone e una ciliegia al maraschino.\r\nServire senza cannuccia.", :strMeasure2 "1/4 tsp ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-02 11:36:19", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Maraschino liqueur", :strMeasure4 "2 dashes ", :strMeasure5 "1 ", :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "Alle Zutaten in den Shaker mit Eiswürfeln geben. Gut schütteln. In ein gekühltes Cocktailglas abseihen. Mit einer Zitronenscheibe und einer Maraschinokirsche garnieren. Ohne Strohhalm servieren.", :strDrinkAlternate nil, :strIngredient3 "Lemon juice", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Brandy", :strMeasure11 nil, :strInstructionsFR "Remplissez la tasse presque jusqu'au sommet avec du café. Ajoutez le lait, le triple sec et le cognac. Remuer.", :strVideo nil, :strInstructions "Fill mug almost to top with coffee.Add milk, triple sec and brandy. Stir.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 nil, :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Cafe Savoy", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/vqwptt1441247711.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1/2 oz ", :strInstructionsES "Llene la taza casi hasta arriba con café. Agregue la leche, el triple seco y el brandy. Remover.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Coffee", :idDrink "14181", :strInstructionsZH-HANT "將咖啡裝滿杯子，幾乎達到頂部。加入牛奶、橙皮秒和白蘭地。攪拌。", :strInstructionsZH-HANS "将咖啡装满杯子，几乎达到顶部。加入牛奶、橙皮秒和白兰地。搅拌。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Riempi la tazza quasi fino in cima con il caffè.\r\nAggiungi latte, triple sec e brandy.\r\nAgitare.", :strMeasure2 "1/2 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-09-03 03:35:11", :strMeasure8 nil, :strCategory "Coffee / Tea", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Milk", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Coffee mug", :strInstructionsDE "Füllen Sie die Tasse fast bis zum Rand mit Kaffee, fügen Sie Milch, Triple Sec und Brandy hinzu. Rühren.", :strDrinkAlternate nil, :strIngredient3 "Triple sec", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Placer le citron vert et le sucre dans un verre old fashioned et mélanger (écraser les deux ingrédients ensemble à l'aide d'un mélangeur ou d'une cuillère en bois). Remplir le verre de glace et ajouter la Cachaça.", :strVideo nil, :strInstructions "Place lime and sugar into old fashioned glass and muddle (mash the two ingredients together using a muddler or a wooden spoon). Fill the glass with ice and add the Cachaça.", :strIngredient10 nil, :strMeasure13 nil, 