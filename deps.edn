{:paths   ["src"]
 :deps    {org.clojure/clojure  {:mvn/version "1.12.4"}
           joyride/tic-tac-toe  {:local/root "projects/scittle-replicant-tic-tac-toe/.joyride"}
           scittle/tic-tac-toe  {:local/root "projects/scittle-replicant-tic-tac-toe/resources/scittle"}
           pez/pirate-lang      {:local/root "projects/pirate-lang"}
           pez/shadow-w-backend {:local/root "projects/shadow-w-backend"}}
 :aliases {; clj -X:test
           :test    {:extra-paths ["test"]
                     :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" 
                                                                         :git/sha "dfb30dd"}}
                     :main-opts   ["-m" "cognitect.test-runner"]
                     :exec-fn     cognitect.test-runner.api/test}
           :joyride {:extra-deps {joyride/workspace {:local/root ".joyride"}}}}}
