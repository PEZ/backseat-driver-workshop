{"https://www.thecocktaildb.com/api/json/v1/1/search.php?f=s" {:data {:drinks [{:strIngredient4 "Orange juice", :strMeasure11 nil, :strInstructionsFR "Mélangez le tout et servez froid.", :strVideo nil, :strInstructions "Throw it all together and serve real cold.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1/3 part ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Smut", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/rx8k8e1504365812.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1/3 part ", :strInstructionsES "Mézclalo todo y sírvelo bien frío.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Red wine", :idDrink "17141", :strInstructionsZH-HANT "把它們放在一起，然後冷飲。", :strInstructionsZH-HANS "把它们放在一起，然后冷饮。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Metti tutto insieme e servi freddo.", :strMeasure2 "1 shot ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-02 16:23:32", :strMeasure8 nil, :strCategory "Punch / Party Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Peach schnapps", :strMeasure4 "1/3 part ", :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Beer mug", :strInstructionsDE "Schütte alles zusammen und serviere es kalt.", :strDrinkAlternate nil, :strIngredient3 "Pepsi Cola", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Verser dans un verre avec des glaçons, garnir et servir.", :strVideo nil, :strInstructions "Build into glass over ice, garnish and serve.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "6 cl", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Spritz", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/j9