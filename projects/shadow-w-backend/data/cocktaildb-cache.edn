ideo nil, :strInstructions "Layer in order into a shot glass.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1/4 ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Bubble Gum", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/spuurv1468878783.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1/4 ", :strInstructionsES "Coloque en capas en orden en un vaso de chupito.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Vodka", :idDrink "14730", :strInstructionsZH-HANT "依序分層放入小玻璃杯中。", :strInstructionsZH-HANS "按顺序分层放入小玻璃杯中。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Versare a strati nell'ordine di ingrediente", :strMeasure2 "1/4 ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2016-07-18 22:53:03", :strMeasure8 nil, :strCategory "Shot", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Banana liqueur", :strMeasure4 "1/4 ", :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Shot glass", :strInstructionsDE "Nacheinander in ein Schnapsglas schichten.", :strDrinkAlternate nil, :strIngredient3 "Orange juice", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Il s'agit d'une photo en couches. Versez d’abord le Bailey’s dans le verre à shot. Prenez ensuite une cuillère renversée et touchez-la à la paroi intérieure du verre. Ajoutez délicatement le Kahlua. Répétez ce processus pour le Sambuca. Si cela est fait correctement, l'alcool restera séparé et ressemblera à un bourdon. Apprécier!!!", :strVideo nil, :strInstructions "This is a layered shot. First pour the Bailey's into the shot glass. Then take an upside down spoon and touch it to the inside wall of the glass. Carefully add the Kahlua. Repeat this process for the Sambuca. If done properly, the alcohol will stay separated and resemble a bumble bee. Enjoy!!!", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1/3 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Bumble Bee", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/uwqpvv1461866378.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1/3 oz ", :strInstructionsES "Esta es una toma en capas. Primero vierte el Bailey's en el vaso de chupito. Luego toma una cuchara invertida y toca la pared interior del vaso. Agrega con cuidado el Kahlua. Repita este proceso para la Sambuca. Si se hace correctamente, el alcohol permanecerá separado y se parecerá a un abejorro. ¡¡¡Disfrutar!!!", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Baileys irish cream", :idDrink "14538", :strInstructionsZH-HANT "這是一個分層的鏡頭。首先將貝利酒倒入小酒杯中。然後拿一個倒置的勺子，將其接觸到玻璃的內壁。小心地添加咖啡壺。對 Sambuca 重複此過程。如果操作得當，酒精會保持分離狀態，就像大黃蜂一樣。享受！ ！ ！", :strInstructionsZH-HANS "这是一个分层的镜头。首先将贝利酒倒入小酒杯中。然后拿一个倒置的勺子，将其接触到玻璃的内壁。小心地添加咖啡壶。对 Sambuca 重复此过程。如果操作得当，酒精会保持分离状态，就像大黄蜂一样。享受！！！", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Questo è uno scatto a strati.\r\nPer prima cosa, versa il Bailey's nel bicchierino.\r\nQuindi prendi un cucchiaio capovolto e toccalo sulla parete interna del vetro.\r\nAggiungi con attenzione il Kahlua.\r\nRipeti questo processo per la Sambuca.\r\nSe fatto correttamente, l'alcol rimarrà separato e assomiglierà a un calabrone", :strMeasure2 "1/3 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2016-04-28 18:59:38", :strMeasure8 nil, :strCategory "Shot", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Kahlua", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Shot glass", :strInstructionsDE "Dies ist ein mehrschichtiges Getränk. Zuerst gießt man die Bailey's in das Schnapsglas. Nehmen Sie dann einen umgedrehten Löffel und berühren Sie ihn an der Innenwand des Glases. Füge das Kahlua vorsichtig hinzu. Wiederholen Sie diesen Vorgang für den Sambuca. Bei richtiger Anwendung bleibt der Alkohol getrennt und ähnelt einer Hummel. Genießt es!!!!!!", :strDrinkAlternate nil, :strIngredient3 "Sambuca", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Laisser la crème glacée reposer pendant environ 10 minutes. Ajouter les ingrédients dans l'ordre, mélanger avec une baguette (un couteau à beurre ou une cuillère peut également faire l'affaire). Consommer immédiatement et souvent. Agréable et léger, idéal pour succéder à une boisson lourde.", :strVideo nil, :strInstructions "Leave ice-cream out for about 10 minutes. Add ingredients in order, stir with chopstick (butter knife or spoon works too). Consume immediately and often. Nice and light, great for following a heavy drink.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Baby Eskimo", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/wywrtw1472720227.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "2 scoops ", :strInstructionsES "Dejar el helado fuera unos 10 minutos. Añadir los ingredientes en orden, remover con un palillo (un cuchillo de mantequilla o una cuchara también sirven). Consumir inmediatamente y a menudo. Agradable y ligero, ideal para después de una bebida fuerte.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Kahlua", :idDrink "15511", :strInstructionsZH-HANT "將冰淇淋放置約 10 分鐘。依序加入材料，用筷子攪拌（黃油刀或湯匙也可以）。立即並經常食用。美味又清淡，非常適合在喝了很多酒後飲用。", :strInstructionsZH-HANS "将冰淇淋放置约 10 分钟。按顺序加入材料，用筷子搅拌（黄油刀或勺子也可以）。立即并经常食用。美味又清淡，非常适合在喝了很多酒后饮用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Lasciare fuori il gelato per circa 10 minuti.\r\nAggiungere gli ingredienti in ordine, mescolare con una bacchetta (anche un coltello da burro o un cucchiaio funziona).\r\nConsumare subito.", :strMeasure2 "8 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2016-09-01 09:57:07", :strMeasure8 nil, :strCategory "Shake", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Milk", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Collins Glass", :strInstructionsDE "Das Speiseeis ca. 10 Minuten ruhen lassen. Die Zutaten in der Reihenfolge hinzufügen, mit dem Essstäbchen umrühren (Buttermesser oder Löffel funktioniert auch).", :strDrinkAlternate nil, :strIngredient3 "Vanilla ice-cream", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Egg white", :strMeasure11 nil, :strInstructionsFR "Agiter le jus de citron, le sucre en poudre, le whisky mélangé et le blanc d'œuf avec de la glace concassée et filtrer dans un verre à whisky acidulé. Ajoutez la tranche de citron, complétez avec la cerise et servez.", :strVideo nil, :strInstructions "Shake juice of lemon, powdered sugar, blended whiskey, and egg white with cracked ice and strain into a whiskey sour glass. Add the slice of lemon, top with the cherry, and serve.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Lemon", :strImageAttribution nil, :strDrink "Boston Sour", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/kxlgbi1504366100.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 tsp ", :strInstructionsES "Agitar el zumo de limón, el azúcar en polvo, el whisky mezclado y la clara de huevo con hielo picado y colar en un vaso de whisky sour. Añadir la rodaja de limón, coronar con la cereza y servir.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Blended whiskey", :idDrink "11129", :strInstructionsZH-HANT "將檸檬汁、糖粉、混合威士忌和蛋白與碎冰一起搖勻，濾入威士忌酸杯中。加入檸檬片，上面放上櫻桃，即可食用。", :strInstructionsZH-HANS "将柠檬汁、糖粉、混合威士忌和蛋清与碎冰一起摇匀，滤入威士忌酸杯中。添加柠檬片，上面放上樱桃，即可食用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Shakerare il succo di limone, lo zucchero a velo, il whisky miscelato e l'albume con ghiaccio tritato e filtrare in un bicchiere da whisky sour.Aggiungere la fetta di limone, guarnire con la ciliegia e servire.", :strMeasure2 "Juice of 1/2 ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-02 16:28:20", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 "1 ", :strMeasure14 nil, :strIngredient2 "Lemon", :strMeasure4 "1 ", :strMeasure5 "1 slice ", :strIngredient6 "Cherry", :strImageSource nil, :strIngredient8 nil, :strGlass "Whiskey sour glass", :strInstructionsDE "Den Saft von Zitrone, Puderzucker, gemischtem Whiskey und Eiweiß mit zerkleinertem Eis schütteln und in ein Whisky Sour Glas abseihen. Die Zitronenscheibe dazugeben, mit der Kirsche garnieren und servieren.", :strDrinkAlternate nil, :strIngredient3 "Powdered sugar", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Grenadine", :strMeasure11 nil, :strInstructionsFR "Ajouter 2 mesures de club soda ou plus ou moins selon le goût.\r\n\r\nMélangez le tout et versez sur des glaçons. Boire avec une paille.", :strVideo nil, :strInstructions "Add 2 parts club soda or more or less to taste.\r\n\r\nMix it all together and pour over a bunch of ice. Drink with a straw.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "3 parts", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Pineapple Juice", :strImageAttribution nil, :strDrink "Bahama Mama", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/tyb4a41515793339.jpg", :strMeasure15 nil, :strIngredient7 "Sweet and Sour", :strMeasure3 "1 part", :strInstructionsES "Añada 2 partes de club soda o más o menos al gusto.\r\n\r\nMézclelo todo y viértalo sobre un montón de hielo. Bébelo con una pajita.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Rum", :idDrink "17267", :strInstructionsZH-HANT "加入 2 份蘇打水或依口味添加或添加少量。\r\n\r\n將它們混合在一起並倒在一堆冰上。用吸管喝。", :strInstructionsZH-HANS "添加 2 份苏打水或根据口味添加或添加少量。\r\n\r\n将它们混合在一起并倒在一堆冰上。用吸管喝。", :strMeasure9 nil, :strMeasure7 "1 part", :strInstructionsIT "Aggiungere 2 bicchieri da shot con acqua di selt.\r\nMescola il tutto e versa sopra un po 'di ghiaccio.\r\nBevi con una cannuccia.", :strMeasure2 "1 part", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2018-01-12 21:42:19", :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 "2 parts", :strMeasure14 nil, :strIngredient2 "Dark Rum", :strMeasure4 "1 part", :strMeasure5 "2 parts", :strIngredient6 "Orange Juice", :strImageSource nil, :strIngredient8 nil, :strGlass "Highball glass", :strInstructionsDE "Füge 2 Teile Club-Soda oder mehr oder weniger nach Belieben hinzu. Alles zusammen mischen und über reichlich Eis gießen. Trink mit einem Strohhalm.", :strDrinkAlternate nil, :strIngredient3 "Banana liqueur", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil}]}, :fetched-at 1790009882369}, "https://www.thecocktaildb.com/api/json/v1/1/search.php?f=m" {:data {:drinks [{:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Préparez un expresso. Dans une tasse à café, placez 1 cuillère à café de cacao en poudre non sucré, puis recouvrez une cuillère à café de miel et versez-en un filet dans la tasse. Remuez pendant que le café infuse, c'est la partie amusante. Le cacao semble enrober le miel sans se mélanger, vous obtenez donc une masse poussiéreuse et collante qui semble ne jamais se mélanger. Et puis tout d’un coup, hop ! Cela ressemble à une sauce au chocolat noir. Versez l'espresso chaud sur le miel en remuant pour le dissoudre. Servir avec de la crème.", :strVideo nil, :strInstructions "Brew espresso. In a coffee mug, place 1 teaspoon of unsweetened powdered cocoa, then cover a teaspoon with honey and drizzle it into the cup. Stir while the coffee brews, this is the fun part. The cocoa seems to coat the honey without mixing, so you get a dusty, sticky mass that looks as though it will never mix. Then all at once, presto! It looks like dark chocolate sauce. Pour hot espresso over the honey, stirring to dissolve. Serve with cream.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 nil, :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Melya", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/xwtptq1441247579.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 nil, :strInstructionsES "Prepara café expreso. En una taza de café, coloca 1 cucharadita de cacao en polvo sin azúcar, luego cubre una cucharadita con miel y rocíala en la taza. Revuelve mientras se prepara el café, esta es la parte divertida. El cacao parece cubrir la miel sin mezclarse, por lo que se obtiene una masa polvorienta y pegajosa que parece que nunca se mezclará. Entonces, de repente, ¡listo! Parece salsa de chocolate amargo. Vierta el espresso caliente sobre la miel, revolviendo para que se disuelva. Servir con crema.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Espresso", :idDrink "12776", :strInstructionsZH-HANT "沖泡濃縮咖啡。在咖啡杯中放入一茶匙不加糖的可可粉，然後在一茶匙上塗上蜂蜜，淋入杯中。煮咖啡時攪拌，這是有趣的部分。可可似乎在沒有混合的情況下覆蓋了蜂蜜，所以你會得到一種佈滿灰塵的粘稠物質，看起來好像永遠不會混合。然後突然間，急！它看起來像黑巧克力醬。將熱濃縮咖啡倒在蜂蜜上，攪拌使其溶解。與奶油一起食用。", :strInstructionsZH-HANS "冲泡浓缩咖啡。在咖啡杯中放入一茶匙不加糖的可可粉，然后在一茶匙上涂上蜂蜜，淋入杯中。煮咖啡时搅拌，这是有趣的部分。可可似乎在没有混合的情况下覆盖了蜂蜜，所以你会得到一种布满灰尘的粘稠物质，看起来好像永远不会混合。然后突然间，急！它看起来像黑巧克力酱。将热浓缩咖啡倒在蜂蜜上，搅拌使其溶解。与奶油一起食用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Prepara l'espresso.\r\nIn una tazza da caffè, mettete 1 cucchiaino di cacao amaro in polvere, quindi coprite un cucchiaino con del miele e versatelo nella tazza.\r\nMescola mentre il caffè si prepara, questa è la parte divertente.\r\nIl cacao sembra ricoprire il miele senza mescolarsi, quindi si ottiene una massa polverosa e appiccicosa che sembra non si mescolerà mai.\r\nVersare l'espresso caldo sul miele, mescolando per scioglierlo.\r\nServire con la panna.", :strMeasure2 "Unsweetened ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-09-03 03:32:59", :strMeasure8 nil, :strCategory "Coffee / Tea", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Honey", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Coffee mug", :strInstructionsDE "Espresso zubereiten. In eine Kaffeetasse 1 Teelöffel ungesüßten, pulverisierten Kakao geben, dann einen Teelöffel Honig in die Tasse träufeln. Rühren Sie um, während der Kaffee brüht, das ist der lustige Teil. Der Kakao scheint den Honig ohne Mischen zu überziehen, so dass Sie eine dichte, klebrige Masse erhalten, die aussieht, als würde sie sich nie vermischen. Dann auf einmal, presto! Es sieht aus wie dunkle Schokoladensoße. Heißen Espresso über den Honig gießen und unter Rühren auflösen. Mit Sahne servieren.", :strDrinkAlternate nil, :strIngredient3 "Cocoa powder", :strCreativeCommonsConfirmed "No", :strAlcoholic "Non alcoholic", :strIngredient14 nil} {:strIngredient4 "Mint", :strMeasure11 nil, :strInstructionsFR "Mélanger les feuilles de menthe avec le sucre et le jus de citron vert. Ajoutez un filet d'eau gazeuse et remplissez le verre de glace concassée. Verser le rhum et compléter avec de l'eau gazeuse. Décorer et servir avec une paille.", :strVideo nil, :strInstructions "Muddle mint leaves with sugar and lime juice. Add a splash of soda water and fill the glass with cracked ice. Pour the rum and top with soda water. Garnish and serve with straw.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "IBA,ContemporaryClassic,Alcoholic,USA,Asia,Vegan,Citrus,Brunch,Hangover,Mild", :strMeasure1 "2-3 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Soda water", :strImageAttribution "anilaha https://pixabay.com/users/anilaha-16242978/", :strDrink "Mojito", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/metwgh1606770327.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "2 tsp ", :strInstructionsES "Mezcle las hojas de menta con el azúcar y el zumo de lima. Añada un chorrito de soda y llene el vaso con hielo picado. Verter el ron y completar con soda. Decorar y servir con pajita.", :strIngredient15 nil, :strIBA "Contemporary Classics", :strIngredient11 nil, :strIngredient1 "Light rum", :idDrink "11000", :strInstructionsZH-HANT "將薄荷葉與糖和酸橙汁攪拌均勻。加入少許蘇打水，並在玻璃杯中裝滿碎冰。倒入蘭姆酒並在上面加入蘇打水。用稻草裝飾並食用。", :strInstructionsZH-HANS "将薄荷叶与糖和酸橙汁搅匀。加入少许苏打水，并在玻璃杯中装满碎冰。倒入朗姆酒并在上面加入苏打水。用稻草装饰并食用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Pestare le foglie di menta con lo zucchero e il succo di lime.\r\nAggiungere una spruzzata di acqua di seltz e riempi il bicchiere con ghiaccio tritato.\r\nVersare il rum e riempire con acqua di seltz.\r\nGuarnire con una fetta di lime, servire con una cannuccia.", :strMeasure2 "Juice of 1 ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2016-11-04 09:17:09", :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Lime", :strMeasure4 "2-4 ", :strMeasure5 nil, :strIngredient6 nil, :strImageSource "https://pixabay.com/photos/cocktail-mojito-cocktail-recipe-5096281/", :strIngredient8 nil, :strGlass "Highball glass", :strInstructionsDE "Minzblätter mit Zucker und Limettensaft verrühren. Füge einen Spritzer Sodawasser hinzu und fülle das Glas mit gebrochenem Eis. Den Rum eingießen und mit Sodawasser übergießen. Garnieren und mit einem Strohhalm servieren.", :strDrinkAlternate nil, :strIngredient3 "Sugar", :strCreativeCommonsConfirmed "Yes", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Assurez-vous que les deux ingrédients sont bien refroidis, puis mélangez dans le verre. Servir froid.", :strVideo nil, :strInstructions "Ensure both ingredients are well chilled, then mix into the glass. Serve cold.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "IBA,ContemporaryClassic", :strMeasure1 "Chilled ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Mimosa", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/juhcuu1504370685.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 nil, :strInstructionsES "Asegúrese de que ambos ingredientes estén bien fríos y luego mezcle en el vaso. Servir frío.", :strIngredient15 nil, :strIBA "Contemporary Classics", :strIngredient11 nil, :strIngredient1 "Champagne", :idDrink "17205", :strInstructionsZH-HANT "確保兩種成分充分冷卻，然後混合到玻璃杯中。冷食。", :strInstructionsZH-HANS "确保两种成分充分冷却，然后混合到玻璃杯中。冷食。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Assicurati che entrambi gli ingredienti siano ben raffreddati, quindi mescolali nel bicchiere.\r\nServire freddo.", :strMeasure2 "2 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-02 17:44:45", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Orange juice", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Champagne flute", :strInstructionsDE "Achten Sie darauf, dass beide Zutaten gut gekühlt sind, und mischen Sie sie dann in das Glas. Kalt servieren.", :strDrinkAlternate nil, :strIngredient3 nil, :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Sweet and sour", :strMeasure11 nil, :strInstructionsFR "Agiter tous les ingrédients avec de la glace. Filtrer dans un verre. Garnir et servir avec une paille.", :strVideo nil, :strInstructions "Shake all ingredients with ice. Strain into glass. Garnish and serve with straw.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "IBA,ContemporaryClassic", :strMeasure1 "1 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Cherry", :strImageAttribution "Johnny Silvercloud https://www.flickr.com/people/116193477@N08", :strDrink "Mai Tai", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/twyrrp1439907470.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1/2 oz ", :strInstructionsES "Agitar todos los ingredientes con hielo. Colar en un vaso. Decorar y servir con pajita.", :strIngredient15 nil, :strIBA "Contemporary Classics", :strIngredient11 nil, :strIngredient1 "Light rum", :idDrink "11690", :strInstructionsZH-HANT "將所有原料加冰搖勻。濾入玻璃杯中。用稻草裝飾並食用。", :strInstructionsZH-HANS "将所有原料加冰摇匀​​。滤入玻璃杯中。用稻草装饰并食用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Shakerare tutti gli ingredienti con ghiaccio.Filtrare nel bicchiere. ", :strMeasure2 "1/2 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-08-18 15:17:50", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Orgeat syrup", :strMeasure4 "1 1/2 oz ", :strMeasure5 "1 ", :strIngredient6 nil, :strImageSource "https://commons.wikimedia.org/wiki/File:Mai_Tai_(16304400706).jpg", :strIngredient8 nil, :strGlass "Collins glass", :strInstructionsDE "Alle Zutaten mit Eis schütteln. In ein Glas abseihen. Garnieren und mit Trinkhalm servieren.", :strDrinkAlternate nil, :strIngredient3 "Triple sec", :strCreativeCommonsConfirmed "Yes", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Droit : Verser tous les ingrédients dans un verre à mélange avec des glaçons. Bien mélanger. Filtrer dans un verre à cocktail martini réfrigéré. Presser l'huile du zeste de citron sur la boisson ou décorer d'une olive.", :strVideo "https://www.youtube.com/watch?v=ApMR3IWYZHI", :strInstructions "Straight: Pour all ingredients into mixing glass with ice cubes. Stir well. Strain in chilled martini cocktail glass. Squeeze oil from lemon peel onto the drink, or garnish with olive.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 2/3 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Martini", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/71t8581504353095.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 ", :strInstructionsES "Derecho: Vierta todos los ingredientes en un vaso mezclador con cubitos de hielo. Remover bien. Colar en una copa de martini fría. Exprima el aceite de la cáscara de limón sobre la bebida, o decore con aceitunas.", :strIngredient15 nil, :strIBA "Unforgettables", :strIngredient11 nil, :strIngredient1 "Gin", :idDrink "11728", :strInstructionsZH-HANT "直接：將所有原料倒入裝有冰塊的混合杯中。攪拌均勻。濾入冰鎮馬丁尼雞尾酒杯。將檸檬皮中的油擠到飲料上，或用橄欖裝飾。", :strInstructionsZH-HANS "直接：将所有原料倒入装有冰块的混合杯中。搅拌均匀。滤入冰镇马提尼鸡尾酒杯。将柠檬皮中的油挤到饮料上，或用橄榄装饰。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Versare tutti gli ingredienti nel mixing glass con cubetti di ghiaccio. Mescolare bene. Spremi la scorza di limone sulla bevanda o guarnisci con l'oliva.Filtrare in una coppetta da cocktail Martini ghiacciata. ", :strMeasure2 "1/3 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-02 12:51:35", :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Dry Vermouth", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "Direkt: Alle Zutaten in ein Mischglas mit Eiswürfeln geben. Gut umrühren. In einem gekühlten Martini-Cocktailglas abseihen. Den Saft aus der Zitronenschale auf das Getränk drücken oder mit Olive garnieren.", :strDrinkAlternate nil, :strIngredient3 "Olive", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Hot Sauce", :strMeasure11 nil, :strInstructionsFR "Mélanger la bière avec du jus de tomate, du jus de citron vert fraîchement pressé et de la sauce Worcestershire, de la sauce teriyaki, de la sauce soja ou de la sauce piquante.\r\nServi dans un verre réfrigéré à bord salé.\r\n", :strVideo nil, :strInstructions "Mix the beer with tomato juice, freshly squeezed lime juice, and Worcestershire sauce, teriyaki sauce, soy sauce, or hot sauce.\r\nServed In a chilled, salt-rimmed glass\r\n", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "Hangover,StrongFlavor,Breakfast", :strMeasure1 "4 oz", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Worcestershire Sauce", :strImageAttribution nil, :strDrink "Michelada", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/u736bd1605907086.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 tblsp", :strInstructionsES "Mezcle la cerveza con zumo de tomate, zumo de lima recién exprimido y salsa Worcestershire, salsa teriyaki, salsa de soja o salsa picante.\r\nSe sirve en un vaso frío con borde de sal.\r\n", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Beer", :idDrink "178343", :strInstructionsZH-HANT "將啤酒與番茄汁、鮮榨酸橙汁、伍斯特醬、照燒醬、醬油或辣醬混合。\r\n裝在冰鎮的、鑲有鹽的玻璃杯中", :strInstructionsZH-HANS "将啤酒与番茄汁、鲜榨酸橙汁、伍斯特酱、照烧酱、酱油或辣酱混合。\r\n装在冰镇的、镶有盐的玻璃杯中", :strMeasure9 nil, :strMeasure7 "", :strInstructionsIT "Mescola la birra con succo di pomodoro, succo di lime appena spremuto e salsa Worcestershire, salsa teriyaki, salsa di soia o salsa piccante.\r\nServito in un bicchiere ghiacciato bordato di sale", :strMeasure2 "4 oz", :strMeasure12 nil, :strMeasure10 nil, :dateModified nil, :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 "Dash", :strMeasure14 nil, :strIngredient2 "Tomato Juice", :strMeasure4 "Dash", :strMeasure5 "Dash", :strIngredient6 "Soy Sauce", :strImageSource nil, :strIngredient8 nil, :strGlass "Pint glass", :strInstructionsDE nil, :strDrinkAlternate nil, :strIngredient3 "Lime Juice", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Ice", :strMeasure11 nil, :strInstructionsFR "Remuer avec de la glace, filtrer dans un verre réfrigéré, garnir et servir.", :strVideo "https://www.youtube.com/watch?v=TFWPtkNoF4Y", :strInstructions "Stirred over ice, strained into a chilled glass, garnished, and served up.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "IBA,Classic,Alcoholic", :strMeasure1 "3/4 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Maraschino cherry", :strImageAttribution "Sarah Stierch (CC BY 4.0)", :strDrink "Manhattan", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/yk70e31606771240.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "dash ", :strInstructionsES "Se remueve con hielo, se cuela en un vaso frío, se adorna y se sirve.", :strIngredient15 nil, :strIBA "Unforgettables", :strIngredient11 nil, :strIngredient1 "Sweet Vermouth", :idDrink "11008", :strInstructionsZH-HANT "加冰攪拌，濾入冰鎮玻璃杯中，裝飾後即可享用。", :strInstructionsZH-HANS "加冰搅拌，滤入冰镇玻璃杯中，装饰后即可享用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Mescolate su ghiaccio, filtrate in un bicchiere freddo, guarnite e servite.", :strMeasure2 "2 1/2 oz Blended ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-02 12:07:09", :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 "1 twist of ", :strMeasure14 nil, :strIngredient2 "Bourbon", :strMeasure4 "2 or 3 ", :strMeasure5 "1 ", :strIngredient6 "Orange peel", :strImageSource "https://commons.wikimedia.org/wiki/File:Oak_Fired_Manhattan_-_Stierch_1.jpg", :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "Über Eis gerührt, in ein gekühltes Glas geseiht, garniert und serviert.", :strDrinkAlternate nil, :strIngredient3 "Angostura bitters", :strCreativeCommonsConfirmed "Yes", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Salt", :strMeasure11 nil, :strInstructionsFR "Frotter le bord du verre avec la tranche de citron vert pour faire adhérer le sel. Veillez à n'humidifier que le bord extérieur et à y saupoudrer le sel. Le sel doit se présenter aux lèvres du buveur et ne jamais se mélanger au cocktail. Secouez les autres ingrédients avec de la glace, puis versez-les délicatement dans le verre.", :strVideo nil, :strInstructions "Rub the rim of the glass with the lime slice to make the salt stick to it. Take care to moisten only the outer rim and sprinkle the salt on it. The salt should present to the lips of the imbiber and never mix into the cocktail. Shake the other ingredients with ice, then carefully pour into the glass.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "IBA,ContemporaryClassic", :strMeasure1 "1 1/2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution "Cocktailmarler", :strDrink "Margarita", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/5noda61589575158.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 oz ", :strInstructionsES "Frota el borde del vaso con la rodaja de lima para que la sal se adhiera a él. Procure humedecer sólo el borde exterior y espolvorear la sal sobre él. La sal debe presentarse en los labios del imbibidor y nunca mezclarse en el cóctel. Agite los demás ingredientes con hielo y viértalos con cuidado en el vaso.", :strIngredient15 nil, :strIBA "Contemporary Classics", :strIngredient11 nil, :strIngredient1 "Tequila", :idDrink "11007", :strInstructionsZH-HANT "用石灰片擦拭玻璃杯的邊緣，使鹽黏在玻璃杯上。注意僅潤濕外緣並在其上撒鹽。鹽應該出現在飲用者的嘴唇上，並且不要混入雞尾酒中。將其他成分與冰一起搖勻，然後小心地倒入玻璃杯中。", :strInstructionsZH-HANS "用石灰片擦拭玻璃杯的边缘，使盐粘在玻璃杯上。注意仅润湿外缘并在其上撒盐。盐应该出现在饮用者的嘴唇上，并且不要混入鸡尾酒中。将其他成分与冰一起摇匀，然后小心地倒入玻璃杯中。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Strofina il bordo del bicchiere con la fetta di lime per far aderire il sale.\r\nAvere cura di inumidire solo il bordo esterno e cospargere di sale.\r\nIl sale dovrebbe presentarsi alle labbra del bevitore e non mescolarsi mai al cocktail.\r\nShakerare gli altri ingredienti con ghiaccio, quindi versarli delicatamente nel bicchiere.", :strMeasure2 "1/2 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-08-18 14:42:59", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Triple sec", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource "https://commons.wikimedia.org/wiki/File:Klassiche_Margarita.jpg", :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "Reiben Sie den Rand des Glases mit der Limettenscheibe, damit das Salz daran haftet. Achten Sie darauf, dass nur der äußere Rand angefeuchtet wird und streuen Sie das Salz darauf. Das Salz sollte sich auf den Lippen des Genießers befinden und niemals in den Cocktail einmischen. Die anderen Zutaten mit Eis schütteln und vorsichtig in das Glas geben.", :strDrinkAlternate nil, :strIngredient3 "Lime juice", :strCreativeCommonsConfirmed "Yes", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "", :strMeasure11 nil, :strInstructionsFR "1 - Verser le Ricard (ou le pastis)\n2 - Versez le sirop d'orgeat\n3 - Versez enfin l'eau et ajoutez des glaçons à votre convenance.\n\nAjoutez les glaçons à la fin, sinon le sirop et le pastis ne se mélangent pas bien.", :strVideo nil, :strInstructions "1 - Pour the Ricard (or pastis)\n2 - Pour the orgeat syrup\n3 - Finally pour the water and add ice cubes at your convenience.\n\nAdd the ice cubes at the end, otherwise the syrup and pastis do not mix well.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "3 cl", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "", :strImageAttribution nil, :strDrink "Mauresque", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/duwfa11686236556.jpg", :strMeasure15 nil, :strIngredient7 "", :strMeasure3 "Full Glass", :strInstructionsES "1 - Vierta el Ricard (o pastis)\n2 - Vierta el sirope de orgeat\n3 - Por último, vierta el agua y añada cubitos de hielo a su gusto.\n\nAñada los cubitos de hielo al final, de lo contrario el sirope y el pastis no se mezclan bien.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Ricard", :idDrink "178370", :strInstructionsZH-HANT "1 - 倒入里卡德（或茴香酒）\n2 - 倒入燕麥糖漿\n3 - 最後倒入水並根據需要添加冰塊。\n\n最後加入冰塊，否則糖漿和茴香酒混合不好。", :strInstructionsZH-HANS "1 - 倒入里卡德（或茴香酒）\n2 - 倒入燕麦糖浆\n3 - 最后倒入水并根据需要添加冰块。\n\n最后加入冰块，否则糖浆和茴香酒混合不好。", :strMeasure9 nil, :strMeasure7 "", :strInstructionsIT "1 - Versare il Ricard (o il pastis)\n2 - Versare lo sciroppo d'orzata\n3 - Versare infine l'acqua e aggiungere cubetti di ghiaccio a piacimento.\n\nAggiungere alla fine i cubetti di ghiaccio, altrimenti sciroppo e pastis non si amalgamano bene.", :strMeasure2 "1 cl", :strMeasure12 nil, :strMeasure10 nil, :dateModified nil, :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 "", :strMeasure14 nil, :strIngredient2 "Orgeat Syrup", :strMeasure4 "", :strMeasure5 "", :strIngredient6 "", :strImageSource "https://thecocktailist.fr/wp-content/uploads/2022/06/kitscocktails-mauresquedeluxe-1065.jpg", :strIngredient8 nil, :strGlass "Collins glass", :strInstructionsDE "1 - Ricard (oder Pastis) einschenken\n2 - Den Orgeatsirup einfüllen\n3 – Zum Schluss gießen Sie das Wasser ein und fügen nach Belieben Eiswürfel hinzu.\n\nZum Schluss die Eiswürfel dazugeben, sonst vermischen sich Sirup und Pastis nicht gut.", :strDrinkAlternate nil, :strIngredient3 "Water", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Water", :strMeasure11 nil, :strInstructionsFR "Dans un verre highball, mélangez délicatement la menthe, le sucre et l'eau. Remplir le verre de glace pilée, ajouter le bourbon et bien mélanger jusqu'à ce que le verre soit bien givré. Garnir d'un brin de menthe.", :strVideo nil, :strInstructions "In a highball glass gently muddle the mint, sugar and water. Fill the glass with cracked ice, add Bourbon and stir well until the glass is well frosted. Garnish with a mint sprig.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "IBA,ContemporaryClassic", :strMeasure1 "4 fresh ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Mint Julep", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/squyyq1439907312.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 tsp ", :strInstructionsES "En un vaso highball, mezclar suavemente la menta, el azúcar y el agua. Llenar el vaso con hielo picado, añadir Bourbon y remover bien hasta que el vaso esté bien escarchado. Decorar con una ramita de menta.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Mint", :idDrink "17206", :strInstructionsZH-HANT "在高球杯中輕輕攪拌薄荷、糖和水。將碎冰倒入玻璃杯中，加入波本威士忌並充分攪拌，直到玻璃杯充分磨砂。用薄荷枝裝飾。", :strInstructionsZH-HANS "在高球杯中轻轻搅拌薄荷、糖和水。将碎冰倒入玻璃杯中，加入波本威士忌并充分搅拌，直至玻璃杯充分磨砂。用薄荷枝装饰。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "In un bicchiere highball pestare delicatamente la menta, lo zucchero e l'acqua.\r\nRiempite il bicchiere con ghiaccio tritato, aggiungete il Bourbon e mescolate bene fino a quando il bicchiere sarà ben glassato.\r\nGuarnire con un rametto di menta.", :strMeasure2 "2 1/2 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-08-18 15:15:12", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Bourbon", :strMeasure4 "2 tsp ", :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Collins glass", :strInstructionsDE "In einem Highball-Glas die Minze, den Zucker und das Wasser vorsichtig verrühren. Füllen Sie das Glas mit gebrochenem Eis, fügen Sie Bourbon hinzu und rühren Sie gut um, bis das Glas gut gefrostet ist. Mit einem Minzzweig garnieren.", :strDrinkAlternate nil, :strIngredient3 "Powdered sugar", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Verser le tout dans une grande cruche ou un bol à punch. Bien mélanger !", :strVideo nil, :strInstructions "Add all contents to a large jug or punch bowl. Stir well!", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "750 ml ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Mudslinger", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/hepk6h1504885554.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "750 ml ", :strInstructionsES "Añada todo el contenido a una jarra grande o ponchera. Remuévalo bien.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Southern Comfort", :idDrink "16041", :strInstructionsZH-HANT "將所有內容物添加到一個大壺或潘趣酒碗中。攪拌均勻！", :strInstructionsZH-HANS "将所有内容物添加到一个大壶或潘趣酒碗中。搅拌均匀！", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Aggiungi tutto il contenuto a una brocca grande o una ciotola da punch.Mescolare bene!", :strMeasure2 "1 L ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-08 16:45:55", :strMeasure8 nil, :strCategory "Punch / Party Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Orange juice", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Punch bowl", :strInstructionsDE "Füge den gesamten Inhalt in eine große Kanne oder Bowle. Gut umrühren!", :strDrinkAlternate nil, :strIngredient3 "Pepsi Cola", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Angostura Bitters", :strMeasure11 nil, :strInstructionsFR "Ajoutez tous les ingrédients dans un verre à mélange et remplissez-le de glace.\r\n\r\nRemuer jusqu'à refroidissement et filtrer dans un verre à coupe.", :strVideo nil, :strInstructions "Add all ingredients to a mixing glass and fill with ice.\r\n\r\nStir until chilled, and strain into a chilled coupe glass.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 1/2 oz", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Martinez 2", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/fs6kiq1513708455.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 tsp", :strInstructionsES "Añada todos los ingredientes a un vaso mezclador y llénelo de hielo.\r\n\r\nRemover hasta que se enfríe y colar en una copa coupé fría.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Gin", :idDrink "17256", :strInstructionsZH-HANT "將所有食材加入攪拌杯中並加滿冰塊。\r\n\r\n攪拌至冷卻，然後過濾到冷卻的轎跑車玻璃杯中。", :strInstructionsZH-HANS "将所有成分添加到搅拌杯中并加满冰块。\r\n\r\n搅拌直至冷却，然后滤入冷却的轿跑车玻璃杯中。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Aggiungere tutti gli ingredienti in un mixing glass e riempire di ghiaccio, mescolare fino a quando si saranno raffreddati e filtrare in un bicchiere da coupé freddo.", :strMeasure2 "1 1/2 oz", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-12-19 18:34:15", :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Sweet Vermouth", :strMeasure4 "2 dashes", :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "Alle Zutaten in ein Mischglas geben und mit Eis füllen. Bis zum Abkühlen umrühren und in ein gekühltes Coupéglas abseihen.", :strDrinkAlternate nil, :strIngredient3 "Maraschino Liqueur", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "vous mettez d'abord l'absinthe, puis la tequila, puis le sirop de Granadine.", :strVideo nil, :strInstructions "first you put rhe absinthe, then put tequila, then put the Granadine syrup.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2/5 ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Moranguito", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/urpsyq1475667335.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1/5 ", :strInstructionsES "Primero se pone ajenjo, luego se pone tequila, luego se pone el almíbar de granadina.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Absinthe", :idDrink "16196", :strInstructionsZH-HANT "先放苦艾酒，再放龍舌蘭酒，最後放格拉納丁糖漿。", :strInstructionsZH-HANS "首先放苦艾酒，然后放龙舌兰酒，最后放格拉纳丁糖浆。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Prima metti l'assenzio, poi la tequila, poi lo sciroppo di granatina.", :strMeasure2 "2/5 ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2016-10-05 12:35:35", :strMeasure8 nil, :strCategory "Shot", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Tequila", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Shot glass", :strInstructionsDE "Erst den Absinth, dann den Tequila, dann den Grenadinesirup.", :strDrinkAlternate nil, :strIngredient3 "Grenadine", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Premièrement, mélanger la pina colada avec 2,5 oz de rhum et des glaçons : Mélanger la pina colada avec 2,5 oz de rhum et de la glace (mettre de côté). Deuxièmement : Mélanger le daiquiri avec 2,5 oz de rhum et de la glace. Troisièmement : pendant que le verre est gelé, ajouter le mélange de pina colada puis le mélange de daiquiri dans le verre (en veillant à ce qu'ils ne se mélangent pas).", :strVideo nil, :strInstructions "First: Mix pina colada with 2.5 oz. of rum with ice(set aside). Second: Mix daiquiri with 2.5 oz. of rum with ice. Third: While frozen, add pina colda mix then daiquiri mix in glass (Making sure they do not get mixed together).", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "IBA", :strMeasure1 "5 oz Bacardi ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Miami Vice", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/qvuyqw1441208955.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "frozen ", :strInstructionsES "Primero: Mezclar la piña colada con 2,5 onzas de ron con hielo (reservar). Segundo: Mezclar el daiquiri con 2,5 onzas de ron y hielo. Tercero: Mientras está congelado, añada la mezcla de piña colada y luego la de daiquiri en el vaso (asegurándose de que no se mezclen).", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "151 proof rum", :idDrink "13936", :strInstructionsZH-HANT "第一：將椰林飄香與 2.5 盎司混合。蘭姆酒加冰（放在一邊）。第二：將代基里酒與 2.5 盎司混合。蘭姆酒加冰。第三：冷凍時，加入冰凍混合物，然後在玻璃杯中混合代基里酒（確保它們不會混合在一起）。", :strInstructionsZH-HANS "第一：将椰林飘香与 2.5 盎司混合。朗姆酒加冰（放在一边）。第二：将代基里酒与 2.5 盎司混合。朗姆酒加冰。第三：冷冻时，加入冰冻混合物，然后在玻璃杯中混合代基里酒（确保它们不会混合在一起）。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Primo: mescola la pina colada con 75ml di rum con ghiaccio (mettere da parte).\r\nSecondo: mescola daiquiri con 75ml di rum con ghiaccio.\r\nTerzo: mentre è freddo, aggiungi il mix di pina colada e poi i daiquiri nel bicchiere (assicurandoti che non si mescolino insieme).", :strMeasure2 "frozen ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-09-02 16:49:15", :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Pina colada mix", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "Zuerst: Pina Colada mit 7,5 cl. Rum und Eis mischen (beiseite legen). Zweitens: Daiquiri mit 7,5 cl. Rum und Eis mischen. Drittens: Im gefrorenen Zustand Pina Colda-Mix hinzufügen, dann Daiquiri in Glas mischen (Achten Sie darauf, dass sie nicht miteinander vermischt werden).", :strDrinkAlternate nil, :strIngredient3 "Daiquiri mix", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Mélanger la vodka et la bière de gingembre dans un verre highball rempli de glace. Ajouter le jus de citron vert. Remuer doucement. Garnir.", :strVideo nil, :strInstructions "Combine vodka and ginger beer in a highball glass filled with ice. Add lime juice. Stir gently. Garnish.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "IBA,ContemporaryClassic", :strMeasure1 "2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution "Will Shenton\r\n", :strDrink "Moscow Mule", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/3pylqc1504370988.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "8 oz ", :strInstructionsES "Mezcle el vodka y la cerveza de jengibre en un vaso highball lleno de hielo. Añada el zumo de lima. Remover suavemente. Decorar.", :strIngredient15 nil, :strIBA "Contemporary Classics", :strIngredient11 nil, :strIngredient1 "Vodka", :idDrink "11009", :strInstructionsZH-HANT "將伏特加和薑汁啤酒放入裝滿冰塊的高球杯中混合。添加酸橙汁。輕輕攪拌。裝飾。", :strInstructionsZH-HANS "将伏特加和姜汁啤酒放入装满冰块的高球杯中混合。添加酸橙汁。轻轻搅拌。装饰。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Unisci la vodka e la ginger beer in un bicchiere highball pieno di ghiaccio.\r\nAggiungi il succo di lime.\r\nMescola delicatamente.", :strMeasure2 "2 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-02 17:49:48", :strMeasure8 nil, :strCategory "Punch / Party Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Lime juice", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource "https://commons.wikimedia.org/wiki/File:Moscow_Mule_at_Rye,_San_Francisco.jpg", :strIngredient8 nil, :strGlass "Copper Mug", :strInstructionsDE "Mischen Sie Wodka und Ingwerbier in einem mit Eis gefüllten Highball-Glas. Limettensaft hinzufügen. Vorsichtig umrühren. Garnieren.", :strDrinkAlternate nil, :strIngredient3 "Ginger ale", :strCreativeCommonsConfirmed "Yes", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Cinnamon", :strMeasure11 nil, :strInstructionsFR "Faire mijoter 3 tasses d'eau avec le sucre, les clous de girofle, les bâtons de cannelle et le zeste de citron dans une casserole en acier inoxydable pendant 10 minutes. Ajouter le vin, chauffer à la température du café (NE PAS FAIRE BOUILLIR), puis ajouter le brandy.", :strVideo nil, :strInstructions "Simmer 3 cups water with, sugar, cloves, cinnamon sticks, and lemon peel in a stainless steel pot for 10 minutes. Add wine heat to a \"coffee temperature\" (DO NOT BOIL) then add the brandy.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "Christmas", :strMeasure1 "3 cups ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Lemon peel", :strImageAttribution nil, :strDrink "Mulled Wine", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/iuwi6h1504735724.jpg", :strMeasure15 nil, :strIngredient7 "Brandy", :strMeasure3 "12 ", :strInstructionsES "Cocer a fuego lento 3 tazas de agua con, azúcar, clavo, canela en rama y piel de limón en una olla de acero inoxidable durante 10 minutos. Añadir el vino y calentar a \"temperatura de café\" (NO HERVIR) y, a continuación, añadir el brandy.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Water", :idDrink "12988", :strInstructionsZH-HANT "將 3 杯水、糖、丁香、肉桂棒和檸檬皮放入不銹鋼鍋中煮 10 分鐘。將葡萄酒加熱至“咖啡溫度”（不要煮沸），然後添加白蘭地。", :strInstructionsZH-HANS "将 3 杯水、糖、丁香、肉桂棒和柠檬皮放入不锈钢锅中煮 10 分钟。将葡萄酒加热至“咖啡温度”（不要煮沸），然后添加白兰地。", :strMeasure9 nil, :strMeasure7 "1/4 cup ", :strInstructionsIT "Fai bollire 3 tazze di acqua con, zucchero, chiodi di garofano, bastoncini di cannella e scorza di limone in una pentola di acciaio inossidabile per 10 minuti.\r\nPortare il vino a \"temperatura del caffè\" (NON BOLLITE) quindi aggiungere il brandy.", :strMeasure2 "1 cup ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-06 23:08:44", :strMeasure8 nil, :strCategory "Punch / Party Drink", :strMeasure6 "750 ml ", :strMeasure14 nil, :strIngredient2 "Sugar", :strMeasure4 "2 ", :strMeasure5 "1 ", :strIngredient6 "Red wine", :strImageSource nil, :strIngredient8 nil, :strGlass "Collins Glass", :strInstructionsDE "3 Tassen Wasser mit Zucker, Nelken, Zimtstangen und Zitronenschale in einem Edelstahltopf 10 Minuten köcheln lassen. Wein auf \"Kaffeetemperatur\" erhitzen (nicht kochen) und füge dann den Brandy hinzu.", :strDrinkAlternate nil, :strIngredient3 "Cloves", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Cardamom", :strMeasure11 nil, :strInstructionsFR "Portez 2 tasses d'eau à ébullition. Ajoutez tous les ingrédients et faites bouillir à nouveau pendant environ 15 secondes. Laissez reposer une minute. Faire chauffer le lait dans une casserole. Filtrez le thé dans des tasses. Ajouter le lait et le sucre. C'est ça.", :strVideo nil, :strInstructions "Bring 2 cups of water to boil. Add all the ingredients and boil again for about 15 seconds. Let stand for a minute. Warm milk in a pot. Filter tea into cups. Add milk and sugar. That's IT.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 cups ", :strIngredient9 "Milk", :strIngredient13 nil, :strIngredient5 "Cloves", :strImageAttribution nil, :strDrink "Masala Chai", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/uyrpww1441246384.jpg", :strMeasure15 nil, :strIngredient7 "Black pepper", :strMeasure3 "1 chunk dried ", :strInstructionsES "Pon a hervir 2 tazas de agua. Agrega todos los ingredientes y vuelve a hervir durante unos 15 segundos. Dejar reposar por un minuto. Calienta la leche en una olla. Filtra el té en tazas. Agrega la leche y el azúcar. Eso es todo.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Water", :idDrink "12774", :strInstructionsZH-HANT "將2杯水煮沸。加入所有成分並再次煮沸約15秒。讓我們靜置一分鐘。將牛奶倒入鍋中加熱。將茶過濾到杯子中。加入牛奶和糖。就是這樣。", :strInstructionsZH-HANS "将2杯水煮沸。添加所有成分并再次煮沸约15秒。让我们静置一分钟。将牛奶倒入锅中加热。将茶过滤到杯子中。添加牛奶和糖。就是这样。", :strMeasure9 "to taste", :strMeasure7 "1-2 whole ", :strInstructionsIT "Porta ad ebollizione 2 tazze d'acqua.\r\nAggiungere tutti gli ingredienti e far bollire di nuovo per circa 15 secondi.\r\nLascia riposare per un minuto.\r\nLatte caldo in una pentola.\r\nFiltra il tè in tazze.\r\nAggiungere il latte e lo zucchero.\r\nQuesto è tutto.", :strMeasure2 "3-4 tsp ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-09-03 03:13:04", :strMeasure8 " to taste\n", :strCategory "Coffee / Tea", :strMeasure6 "1 piece ", :strMeasure14 nil, :strIngredient2 "Tea", :strMeasure4 "3-4 crushed ", :strMeasure5 "3 ", :strIngredient6 "Cinnamon", :strImageSource nil, :strIngredient8 "Sugar", :strGlass "Coffee Mug", :strInstructionsDE "2 Tassen Wasser zum Kochen bringen. Alle Zutaten zugeben und nochmals ca. 15 Sekunden kochen lassen. Eine Minute stehen lassen. Milch in einem Topf erwärmen. Tee in Tassen filtern. Milch und Zucker hinzufügen. Servieren.", :strDrinkAlternate nil, :strIngredient3 "Ginger", :strCreativeCommonsConfirmed "No", :strAlcoholic "Non alcoholic", :strIngredient14 nil} {:strIngredient4 "Cucumber", :strMeasure11 nil, :strInstructionsFR "Remplir le verre de glace\r\nVerser le Gin et le jus de citron vert\r\nRemplir le verre avec de la bière au gingembre\r\nGarnir de concombre et de tranches de citron vert.", :strVideo nil, :strInstructions "Fill glass with ice\r\nPour Gin and Lime Juice\r\nFill glass with Ginger Beer\r\nGarnish with Cucumer and Lime slice", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "German", :strMeasure1 "5 cl", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "lemon", :strImageAttribution nil, :strDrink "Munich Mule", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/rj55pl1582476101.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "10 cl", :strInstructionsES "Llenar el vaso con hielo\r\nVierta la ginebra y el zumo de lima\r\nLlenar el vaso con Ginger Beer\r\nDecorar con pepino y rodaja de lima", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Gin", :idDrink "178315", :strInstructionsZH-HANT "將玻璃杯裝滿冰塊\r\n倒入杜松子酒和青檸汁\r\n在玻璃杯中倒入薑汁啤酒\r\n用黃瓜和酸橙片裝飾", :strInstructionsZH-HANS "将玻璃杯装满冰块\r\n倒入杜松子酒和青柠汁\r\n在玻璃杯中倒入姜汁啤酒\r\n用黄瓜和酸橙片装饰", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Riempi il bicchiere di ghiaccio\r\nVersare il gin e il succo di lime\r\nRiempi il bicchiere con Ginger Beer\r\nGuarnire con cetriolo e fetta di lime", :strMeasure2 "2 cl", :strMeasure12 nil, :strMeasure10 nil, :dateModified nil, :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Lime Juice", :strMeasure4 "Chopped", :strMeasure5 "Chopped", :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Highball glass", :strInstructionsDE nil, :strDrinkAlternate nil, :strIngredient3 "Ginger Beer", :strCreativeCommonsConfirmed "Yes", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Whipped cream", :strMeasure11 nil, :strInstructionsFR "versez 6 onces. de café dans une tasse ou une tasse de café irlandais. ajouter le mélange de coca et le chambord, bien mélanger et compléter de chantilly.", :strVideo nil, :strInstructions "pour 6 oz. of coffee in a mug or Irish coffee cup. add coca mix and chambord, mix well and top off with whipped cream.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "6 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Mocha-Berry", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/vtwyyx1441246448.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "2 tblsp ", :strInstructionsES "vierta 6 oz. de café en una taza o taza de café irlandés. agregue la mezcla de coca y el chambord, mezcle bien y complete con crema batida.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Coffee", :idDrink "14209", :strInstructionsZH-HANT "倒入 6 盎司。杯子或愛爾蘭咖啡杯中的咖啡。加入古柯粉和香波堡，攪拌均勻，最後加入生奶油。", :strInstructionsZH-HANS "倒入 6 盎司。杯子或爱尔兰咖啡杯中的咖啡。加入古柯粉和香波堡，搅拌均匀，最后加入生奶油。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Versa 170gr di caffè in una tazza o in una tazza di caffè irlandese.\r\nUnire il mix di cacao e lo Chambord, mescolare bene e completare con la panna montata.", :strMeasure2 "2 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-09-03 03:14:08", :strMeasure8 nil, :strCategory "Coffee / Tea", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Chambord raspberry liqueur", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Irish coffee cup", :strInstructionsDE "Geben Sie 18 cl. Kaffee in eine Tasse oder eine irische Kaffeetasse. Fügen Sie Kokamischung und Chambord hinzu, mischen Sie gut und geben Sie Schlagsahne dazu.", :strDrinkAlternate nil, :strIngredient3 "Cocoa powder", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "White Rum", :strMeasure11 nil, :strInstructionsFR "Presser le jus de 1½ citron vert et le mixer avec la mangue pour obtenir une purée lisse.\nCouper le reste des citrons verts en quatre, puis couper à nouveau chaque quartier en deux. Mettez 2 morceaux de citron vert dans un verre highball pour chaque personne et ajoutez 1 cuillère à café de sucre en poudre et 5-6 feuilles de menthe dans chaque verre. Pressez le tout à l'aide d'un mixeur ou de l'extrémité d'un rouleau à pâtisserie pour libérer tous les arômes du citron vert et de la menthe.\nRépartissez la purée de mangue dans les verres et ajoutez 30 ml de rhum blanc et une poignée de glace pilée dans chacun d'eux, en remuant bien pour mélanger le tout. Complétez avec de l'eau gazeuse pour servir et décorez avec de la menthe supplémentaire, si vous le souhaitez.", :strVideo nil, :strInstructions "Squeeze the juice from 1½ limes and blend with the mango to give a smooth purée.\nCut the rest of the limes into quarters, and then cut each wedge in half again. Put 2 pieces of lime in a highball glass for each person and add 1 teaspoon of caster sugar and 5-6 mint leaves to each glass. Squish everything together with a muddler or the end of a rolling pin to release all the flavours from the lime and mint.\nDivide the mango purée between the glasses and add 30ml white rum and a handful of crushed ice to each one, stirring well to mix everything together. Top up with soda water to serve and garnish with extra mint, if you like.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "Fruity", :strMeasure1 "3", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Ice", :strImageAttribution nil, :strDrink "Mango Mojito", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/wfqmgm1630406820.jpg", :strMeasure15 nil, :strIngredient7 "Mango", :strMeasure3 "Sprig", :strInstructionsES "Exprimir el zumo de 1½ limas y mezclarlo con el mango para obtener un puré suave.\r\nCorte el resto de las limas en cuartos y, a continuación, vuelva a cortar cada gajo por la mitad. Ponga 2 trozos de lima en un vaso alto para cada persona y añada 1 cucharadita de azúcar glas y 5-6 hojas de menta a cada vaso. Aplástelo todo con un batidor o con la punta de un rodillo para liberar todos los sabores de la lima y la menta.\r\nDivida el puré de mango entre los vasos y añada 30 ml de ron blanco y un puñado de hielo picado a cada uno, removiendo bien para mezclarlo todo. Completar con agua con gas para servir y decorar con más menta, si se desea.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Lime", :idDrink "178358", :strInstructionsZH-HANT "從 1½ 個酸橙中榨汁，與芒果混合，製成光滑的果泥。\n將其餘的酸橙切成四等份，然後將每個楔形物再次切成兩半。每人在高球杯中放入 2 塊酸橙，並在每杯中加入 1 茶匙細砂糖和 5-6 片薄荷葉。用攪拌器或擀麵杖的末端將所有東西壓碎，釋放出酸橙和薄荷的所有味道。\n將芒果泥分裝在玻璃杯中，並在每個玻璃杯中加入 30 毫升白蘭姆酒和一把碎冰，充分攪拌，將所有東西混合在一起。加滿蘇打水即可食用，如果您喜歡的話，可以用額外的薄荷裝飾。", :strInstructionsZH-HANS "从 1½ 个酸橙中榨汁，与芒果混合，制成光滑的果泥。\n将其余的酸橙切成四等份，然后将每个楔形物再次切成两半。每人在高球杯中放入 2 块酸橙，并在每杯中加入 1 茶匙细砂糖和 5-6 片薄荷叶。用搅拌器或擀面杖的末端将所有东西压碎，释放出酸橙和薄荷的所有味道。\n将芒果泥分装在玻璃杯中，并在每个玻璃杯中加入 30 毫升白朗姆酒和一把碎冰，充分搅拌，将所有东西混合在一起。加满苏打水即可食用，如果您喜欢的话，可以用额外的薄荷装饰。", :strMeasure9 nil, :strMeasure7 "Garnish with", :strInstructionsIT "Spremete il succo di 1 lime e mezzo e frullatelo con il mango per ottenere una purea omogenea.\nTagliare il resto dei lime in quarti, quindi tagliare nuovamente ogni spicchio a metà. Metti 2 pezzi di lime in un bicchiere highball per ogni persona e aggiungi 1 cucchiaino di zucchero semolato e 5-6 foglie di menta in ogni bicchiere. Schiacciate il tutto con un pestello o con l'estremità di un mattarello per far sprigionare tutti i sapori del lime e della menta.\nDividete la purea di mango nei bicchieri e aggiungete in ognuno 30 ml di rum bianco e una manciata di ghiaccio tritato, mescolando bene per amalgamare il tutto. Rabboccare con acqua gassata per servire e guarnire con menta extra, se lo si desidera.", :strMeasure2 "1 Fresh", :strMeasure12 nil, :strMeasure10 nil, :dateModified nil, :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 "Top", :strMeasure14 nil, :strIngredient2 "Mango", :strMeasure4 "200 ml", :strMeasure5 "cubes", :strIngredient6 "Soda Water", :strImageSource "https://www.instagram.com/p/COVlG8TMZYU", :strIngredient8 nil, :strGlass "Jar", :strInstructionsDE "Den Saft von 1½ Limetten auspressen und mit der Mango zu einem glatten Püree vermischen.", :strDrinkAlternate nil, :strIngredient3 "Mint", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Club soda", :strMeasure11 nil, :strInstructionsFR "Mettre de la menthe et du jus de citron dans un verre, écraser la menthe avec une cuillère, de la glace, du rhum et compléter avec du club soda. Compléter avec de l'Angostura.", :strVideo nil, :strInstructions "Put mint with lemon juice in a glas, mash the mint with a spoon, ice, rum & fill up with club soda. Top it with Angostura.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1/2 handful ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Angostura bitters", :strImageAttribution nil, :strDrink "Mojito Extra", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/vwxrsw1478251483.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1/8 L Jamaican ", :strInstructionsES "Ponga menta con zumo de limón en un vaso, machaque la menta con una cuchara, hielo, ron y rellene con club soda. Añada Angostura.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Mint", :idDrink "15841", :strInstructionsZH-HANT "將薄荷和檸檬汁放入玻璃杯中，用湯匙將薄荷搗碎，加入冰塊和蘭姆酒，然後加入蘇打水。在上面放上安古斯圖拉。", :strInstructionsZH-HANS "将薄荷和柠檬汁放入玻璃杯中，用勺子将薄荷捣碎，加入冰块和朗姆酒，然后加入苏打水。在上面放上安古斯图拉。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Metti la menta con il succo di limone in un bicchiere, schiaccia la menta con un cucchiaio, ghiaccio, rum e riempila con la soda.\r\nCompletalo con Angostura.", :strMeasure2 "3 cl ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2016-11-04 09:24:43", :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Lemon juice", :strMeasure4 "1/8 L ", :strMeasure5 "8 drops ", :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Collins glass", :strInstructionsDE "Minze mit Zitronensaft in ein Glas geben, Minze mit einem Löffel zerdrücken. Eis und Rum hinzufügen und mit Soda auffüllen. Krönen Sie es mit Angostura.", :strDrinkAlternate nil, :strIngredient3 "Dark rum", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Grenadine", :strMeasure11 nil, :strInstructionsFR "Bien agiter avec des glaçons dans un shaker, puis filtrer dans un verre à cocktail bien frais.", :strVideo "https://www.youtube.com/watch