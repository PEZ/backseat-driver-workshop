Measure3 "1 oz Bacardi ", :strInstructionsES "Añadir Amaretto, Bacardi y vodka. Mezclar el Dr. Pepper y la cerveza", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Amaretto", :idDrink "13202", :strInstructionsZH-HANT "加入苦杏酒、百加得和伏特加。加入胡椒博士和啤酒", :strInstructionsZH-HANS "添加苦杏酒、百加得和伏特加。加入胡椒博士和啤酒", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Aggiungi Amaretto, Bacardi e vodka.Mescolare il Dr. Pepper e la birra", :strMeasure2 "1 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-08-24 10:03:04", :strMeasure8 nil, :strCategory "Shot", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Vodka", :strMeasure4 "1 oz ", :strMeasure5 "1 oz ", :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Collins Glass", :strInstructionsDE "Amaretto, Bacardi und Wodka vermengen. Dr. Pepper und Bier unterrühren.", :strDrinkAlternate nil, :strIngredient3 "151 proof rum", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Baileys irish cream", :strMeasure11 nil, :strInstructionsFR "Verser la Sambuca et le Kahlua dans le verre à cocktail et donner une paille au buveur. Versez le Baileys et le Blue Curacao dans deux verres à shot sepsrate de part et d'autre du verre à cocktail. Allumez le mélange dans le verre à cocktail et commencez à boire avec la paille (cette boisson doit être bue en une seule fois). Lorsque vous atteignez le fond du verre, éteignez le feu en versant le Baileys et le Blue Curacao dans le verre à cocktail et continuez à boire jusqu'à ce qu'il n'y en ait plus !", :strVideo nil, :strInstructions "Pour the Sambuca and Kahlua into the Cocktail Glass and give the drinker a straw. Pour the Baileys and Blue Curacao into two sepsrate shot glasses either side of the cocktail glass. Set light the concotion in the cocktail glass and start to drink through the straw (this drink should be drunk in one) , as the bottom of the glass is reached put out the fire by pouring the Baileys and Blue Curacao into the cocktail glass and keep drinking till it's all gone!!", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Flaming Lamborghini", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/yywpss1461866587.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 oz ", :strInstructionsES "Verter la Sambuca y el Kahlua en la copa de cóctel y dar al bebedor una pajita. Vierta el Baileys y el Blue Curacao en dos vasos de chupito de sepsrate a cada lado de la copa de cóctel. Encienda la cocción en la copa de cóctel y empiece a beber con la pajita (esta bebida debe beberse de un trago), cuando llegue al fondo de la copa apague el fuego vertiendo el Baileys y el Blue Curacao en la copa de cóctel y siga bebiendo hasta que se acabe.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Kahlua", :idDrink "16485", :strInstructionsZH-HANT "將 Sambuca 和 Kahlua 倒入雞尾酒杯中，並給飲用者一根吸管。將百利甜酒和藍柑橘倒入雞尾酒杯兩側的兩個單獨的小玻璃杯中。點燃雞尾酒杯中的混合物，開始用吸管飲用（這種飲料應該一次喝完），當到達玻璃杯底部時，將百利甜酒和藍柑橘倒入雞尾酒杯中，繼續飲用，直到全部消失！", :strInstructionsZH-HANS "将 Sambuca 和 Kahlua 倒入鸡尾酒杯中，并给饮用者一根吸管。将百利甜酒和蓝柑橘倒入鸡尾酒杯两侧的两个单独的小玻璃杯中。点燃鸡尾酒杯中的混合物，开始用吸管饮用（这种饮料应该一次喝完），当到达玻璃杯底部时，将百利甜酒和蓝柑橘倒入鸡尾酒杯中，继续饮用，直到全部消失！", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Versare la Sambuca e la Kahlua nel bicchiere da cocktail e dare una cannuccia al bevitore.\r\nVersare il Baileys e il Blue Curacao in due bicchierini separati su entrambi i lati del bicchiere da cocktail.\r\nAccendi la miscela nel bicchiere da cocktail e inizia a bere attraverso la cannuccia (questa bevanda dovrebbe essere bevuta in una volta sola), mentre il fondo del bicchiere viene raggiunto spegni il fuoco versando il Baileys e il Blue Curacao nel bicchiere da cocktail ", :strMeasure2 "1 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2016-04-28 19:03:07", :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Sambuca", :strMeasure4 "1 oz ", :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "Gießen Sie den Sambuca und Kahlua in das Cocktailglas und geben Sie dem Trinker einen Strohhalm. Gießen Sie die Baileys und den blauen Curacao in zwei getrennte Schnapsgläser auf beiden Seiten des Cocktailglases. Zünden Sie die Mischung im Cocktailglas an und beginnen Sie, durch den Strohhalm zu trinken (dieses Getränk sollte in einem getrunken werden), da der Boden des Glases erreicht wird, löschen Sie das Feuer, indem Sie die Baileys und Blue Curacao in das Cocktailglas gießen und weiter trinken, bis alles weg ist!", :strDrinkAlternate nil, :strIngredient3 "Blue Curacao", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Frappez-les tous les deux.", :strVideo nil, :strInstructions "Bang 'em both in.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1/4 glass ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Flander's Flake-Out", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/sqvqrx1461866705.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 nil, :strInstructionsES "Golpéalos a ambos.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Sambuca", :idDrink "13675", :strInstructionsZH-HANT "把他們倆都打進去。", :strInstructionsZH-HANS "把他们俩都打进去。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Versa in un bicchiere tutti gli ingredienti. Agitare bene", :strMeasure2 "3/4 glass ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2016-04-28 19:05:05", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Sarsaparilla", :str