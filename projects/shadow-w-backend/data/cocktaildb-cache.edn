il, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Lassi - Mango", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/1bw6sd1487603816.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1/2 cup ", :strInstructionsES "Póngalo todo en una batidora y viértalo sobre hielo picado. También puedes utilizar otras frutas como fresas y plátanos.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Mango", :idDrink "12698", :strInstructionsZH-HANT "將它們全部放入攪拌機中並倒在碎冰上。您也可以使用其他水果，例如草莓和香蕉。", :strInstructionsZH-HANS "将它们全部放入搅拌机中并倒在碎冰上。您还可以使用其他水果，例如草莓和香蕉。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Mettete il tutto in un frullatore e versateci sopra del ghiaccio tritato.Puoi anche usare altri frutti come fragole e banane.", :strMeasure2 "2 cups ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-02-20 15:16:56", :strMeasure8 nil, :strCategory "Other / Unknown", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Yoghurt", :strMeasure4 "1 cup iced ", :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Highball glass", :strInstructionsDE "Alles in einen Mixer geben und über das zerstoßene Eis gießen. Du kannst auch andere Früchte wie Erdbeeren und Bananen verwenden.", :strDrinkAlternate nil, :strIngredient3 "Sugar", :strCreativeCommonsConfirmed "No", :strAlcoholic "Non alcoholic", :strIngredient14 nil} {:strIngredient4 "Salt", :strMeasure11 nil, :strInstructionsFR "Mettre tous les ingrédients dans un mixeur et mixer jusqu'à obtention d'une belle mousse. Servir frais.", :strVideo nil, :strInstructions "Put all ingredients into a blender and blend until nice and frothy. Serve chilled.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 cup ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Lemon juice", :strImageAttribution nil, :strDrink "Lassi - Sweet", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/9jeifz1487603885.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "4 tblsp ", :strInstructionsES "Poner todos los ingredientes en una batidora y batir hasta que esté bien espumoso. Sírvalo frío.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Yoghurt", :idDrink "12696", :strInstructionsZH-HANT "將所有食材放入攪拌機中，攪拌至細膩且起泡。冷藏後食用。", :strInstructionsZH-HANS "将所有成分放入搅拌机中，搅拌直至细腻且起泡。冷藏后食用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Metti tutti gli ingredienti in un frullatore e frulla fino a ottenere un composto omogeneo e spumoso. Servire freddo.", :strMeasure2 "2 cups cold ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-02-20 15:18:05", :strMeasure8 nil, :strCategory "Other / Unknown", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Water", :strMeasure4 "pinch ", :strMeasure5 "2 tblsp ", :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Highball glass", :strInstructionsDE "Alle Zutaten in einen Mixer geben und schaumig rühren. Kühl servieren.", :strDrinkAlternate nil, :strIngredient3 "Sugar", :strCreativeCommonsConfirmed "No", :strAlcoholic "Non alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Ouvrez le Corona. Remplissez l'espace vide du goulot de la bouteille avec le rhum. La bouteille doit être remplie jusqu'au sommet. Bouchez le flacon avec votre pouce ou la paume de votre main. Retournez la bouteille pour que le rhum et la bière se mélangent. Retournez la bouteille, débranchez-la et buvez.", :strVideo nil, :strInstructions "Open the Corona. Fill the empty space in the neck in the bottle with the rum. The bottle should be filled to the top. Plug the bottle with your thumb or the palm of your hand. Turn the bottle upside-down so the rum and beer mix. Turn the bottle rightside-up, unplug, and drink.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 bottle ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Limona Corona", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/wwqrsw1441248662.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 nil, :strInstructionsES "Abre la Corona. Llena el espacio vacío en el cuello de la botella con ron. La botella debe llenarse hasta arriba. Tape la botella con el pulgar o la palma de la mano. Dale la vuelta a la botella para que el ron y la cerveza se mezclen. Gire la botella hacia arriba, desenchúfela y beba.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Corona", :idDrink "15086", :strInstructionsZH-HANT "打開電暈。用蘭姆酒填滿瓶頸處的空間。瓶子應裝滿至頂部。用拇指或手掌塞住瓶子。將瓶子倒置，讓蘭姆酒和啤酒混合。將瓶子正面朝上，拔掉插頭，然後飲用。", :strInstructionsZH-HANS "打开电晕。用朗姆酒填充瓶颈处的空间。瓶子应装满至顶部。用拇指或手掌塞住瓶子。将瓶子倒置，让朗姆酒和啤酒混合。将瓶子正面朝上，拔掉插头，然后饮用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Apri la Corona.\r\nRiempi lo spazio vuoto nel collo della bottiglia con il rum.\r\nLa bottiglia dovrebbe essere riempita fino in fondo.\r\nCopri la bottiglia con il pollice o il palmo della mano.\r\nCapovolgi la bottiglia in modo che rum e birra si mescolino.\r\nCapovolgi la bottiglia, drink pronto", :strMeasure2 "1 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-09-03 03:51:02", :strMeasure8 nil, :strCategory "Beer", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Bacardi Limon", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Beer Glass", :strInstructionsDE "Öffne die Corona. Füllen Sie den leeren Platz im Hals in der Flasche mit dem Rum. Die Flasche sollte bis zum Anschlag gefüllt werden. Die Flasche mit dem Daumen oder der Handfläche verschließen. Drehen Sie die Flasche auf den Kopf, damit sich Rum und Bier vermischen. Drehen Sie die Flasche nach oben, ziehen Sie den Daumen heraus und trinken Sie.", :strDrinkAlternate nil, :strIngredient3 nil, :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Verser le rhum et le Tia Maria dans un verre à l'ancienne presque rempli de glaçons. Bien mélanger.", :strVideo nil, :strInstructions "Pour the rum and Tia Maria into an old-fashioned glass almost filled with ice cubes. Stir well.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 1/2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Lord And Lady", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/quwrys1468923219.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 nil, :strInstructionsES "Vierta el ron y la Tía María en un vaso old-fashioned casi lleno de cubitos de hielo. Remuévalo bien.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Dark rum", :idDrink "11670", :strInstructionsZH-HANT "將蘭姆酒和蒂亞瑪麗亞倒入幾乎裝滿冰塊的老式玻璃杯中。攪拌均勻。", :strInstructionsZH-HANS "将朗姆酒和蒂亚玛丽亚倒入几乎装满冰块的老式玻璃杯中。搅拌均匀。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Versare il rum e Tia Maria in un bicchiere vecchio stile quasi pieno di cubetti di ghiaccio. Mescolare bene.", :strMeasure2 "1/2 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2016-07-19 11:13:39", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Tia maria", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Old-fashioned glass", :strInstructionsDE "Den Rum und Tia Maria in ein old-fashioned Glas gießen, das fast mit Eiswürfeln gefüllt ist. Gut umrühren.", :strDrinkAlternate nil, :strIngredient3 nil, :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Lemon", :strMeasure11 nil, :strInstructionsFR "Secouer tous les ingrédients (sauf l'eau gazeuse) avec de la glace et filtrer dans un verre à cocktail sur deux glaçons. Remplir d'eau gazeuse, remuer et servir.", :strVideo nil, :strInstructions "Shake all ingredients (except carbonated water) with ice and strain into a cocktail glass over two ice cubes. Fill with carbonated water, stir, and serve.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Egg white", :strImageAttribution nil, :strDrink "Lady Love Fizz", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/20d63k1504885263.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 tsp ", :strInstructionsES "Agitar todos los ingredientes (excepto el agua carbonatada) con hielo y colar en una copa de cóctel sobre dos cubitos de hielo. Rellenar con agua carbonatada, remover y servir.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Gin", :idDrink "11634", :strInstructionsZH-HANT "將所有原料（碳酸水除外）加冰搖勻，濾入盛有兩塊冰塊的雞尾酒杯中。加入碳酸水，攪拌，即可食用。", :strInstructionsZH-HANS "将所有原料（碳酸水除外）加冰摇匀，滤入盛有两块冰块的鸡尾酒杯中。加入碳酸水，搅拌，即可食用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Shakerare tutti gli ingredienti (tranne l'acqua gassata) con ghiaccio e filtrare in un bicchiere da cocktail su due cubetti di ghiaccio. Riempite con acqua gassata, mescolate e servite.", :strMeasure2 "2 tsp ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-08 16:41:03", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Light cream", :strMeasure4 "Juice of 1/2", :strMeasure5 "1 ", :strIngredient6 "Carbonated water", :strImageSource nil, :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "Alle Zutaten (außer kohlensäurehaltiges Wasser) mit Eis schütteln und in ein Cocktailglas über zwei Eiswürfel abseihen. Mit kohlensäurehaltigem Wasser auffüllen, umrühren und servieren.", :strDrinkAlternate nil, :strIngredient3 "Powdered sugar", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Tequila", :strMeasure11 nil, :strInstructionsFR "Mélanger tous les ingrédients (sauf le cola) et verser sur de la glace dans un verre highball. Ajoutez la goutte de cola pour donner de la couleur. Décorer avec une tranche de citron et servir.", :strVideo nil, :strInstructions "Combine all ingredients (except cola) and pour over ice in a highball glass. Add the splash of cola for color. Decorate with a slice of lemon and serve.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "Strong,Asia,StrongFlavor,Brunch,Vegetarian,Sour", :strMeasure1 "1/2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Lemon", :strImageAttribution "Irina Prokopenko https://pxhere.com/en/photographer/999895", :strDrink "Long Island Tea", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/nkwr4c1606770558.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1/2 oz ", :strInstructionsES "Mezcle todos los ingredientes (excepto el refresco de cola) y viértalos sobre hielo en un vaso highball. Añada el chorrito de cola para darle color. Decore con una rodaja de limón y sirva.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Vodka", :idDrink "11002", :strInstructionsZH-HANT "將所有成分（可樂除外）混合，倒入高球杯中的冰塊上。加入一點可樂上色。用一片檸檬裝飾即可食用。", :strInstructionsZH-HANS "将所有成分（可乐除外）混合，倒入高球杯中的冰块上。添加一点可乐来上色。用一片柠檬装饰即可食用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Unisci tutti gli ingredienti (tranne la cola) e versa il ghiaccio in un bicchiere highball. Aggiungi la spruzzata di cola per il colore. Decorare con una fetta di limone e servire.", :strMeasure2 "1/2 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-08-18 14:54:32", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 "1 splash ", :strMeasure14 nil, :strIngredient2 "Light rum", :strMeasure4 "1/2 oz ", :strMeasure5 "Juice of 1/2 ", :strIngredient6 "Coca-Cola", :strImageSource "https://pxhere.