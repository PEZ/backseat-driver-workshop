il, :strCategory "Shot", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Triple sec", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Shot glass", :strInstructionsDE "Geben Sie alle Zutaten in den Tumbler-Pour als Shot.", :strDrinkAlternate nil, :strIngredient3 "Orange juice", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Ginger ale", :strMeasure11 nil, :strInstructionsFR "Agiter le brandy, le gin et le jus d'orange avec de la glace et filtrer dans un verre highball sur des glaçons. Remplir de ginger ale, remuer et servir.", :strVideo nil, :strInstructions "Shake brandy, gin, and orange juice with ice and strain into a highball glass over ice cubes. Fill with ginger ale, stir, and serve.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1/2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Orange Oasis", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/su1olx1582473812.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "4 oz ", :strInstructionsES "Agitar el brandy, la ginebra y el zumo de naranja con hielo y colar en un vaso highball sobre cubitos de hielo. Rellenar con ginger ale, remover y servir.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Cherry brandy", :idDrink "11870", :strInstructionsZH-HANT "將白蘭地、琴酒和柳橙汁加冰搖勻，濾入裝有冰塊的高球杯中。倒入薑汁汽水，攪拌，即可食用。", :strInstructionsZH-HANS "将白兰地、杜松子酒和橙汁加冰摇匀，滤入装有冰块的高球杯中。倒入姜汁汽水，搅拌，即可食用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Shakerare brandy, gin e succo d'arancia con ghiaccio e filtrare in un bicchiere highball con cubetti di ghiaccio. Riempi con ginger ale, mescola e servi.", :strMeasure2 "1 1/2 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-09-02 05:25:23", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Gin", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Highball glass", :strInstructionsDE "Brandy, Gin und Orangensaft mit Eis schütteln und in ein Highball-Glas über Eiswürfel abseihen. Mit Ginger Ale füllen, umrühren und servieren.", :strDrinkAlternate nil, :strIngredient3 "Orange juice", :strCreativeCommonsConfirmed "Yes", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Water", :strMeasure11 nil, :strInstructionsFR "Placer un morceau de sucre dans un verre à l'ancienne et l'imbiber d'amers, ajouter un trait d'eau plate. Mélanger jusqu'à dissolution.\r\nRemplir le verre de glaçons et ajouter le whisky.\r\n\r\nGarnir d'un zeste d'orange et d'une cerise à cocktail.", :strVideo "https://www.youtube.com/watch?v=YsE_igrPXZs", :strInstructions "Place sugar cube in old fashioned glass and saturate with bitters, add a dash of plain water. Muddle until dissolved.\r\nFill the glass with ice cubes and add whiskey.\r\n\r\nGarnish with orange twist, and a cocktail cherry.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "IBA,Classic,Alcoholic,Expensive,Savory", :strMeasure1 "4.5 cL", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution "Dave M", :strDrink "Old Fashioned", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/vrwquq1478252802.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 cube", :strInstructionsES "Ponga el terrón de azúcar en un vaso old fashioned y úntelo con el amargo, añada un chorrito de agua. Mezcle hasta que se disuelva.\r\nLlene el vaso con cubitos de hielo y añada whisky.\r\n\r\nDecorar con un twist de naranja y una cereza de cóctel.", :strIngredient15 nil, :strIBA "Unforgettables", :strIngredient11 nil, :strIngredient1 "Bourbon", :idDrink "11001", :strInstructionsZH-HANT "將方糖放入老式玻璃杯中，加入苦味劑，加入少許白開水。攪拌至溶解。\r\n將玻璃杯裝滿冰塊，然後加入威士忌。\r\n\r\n用橙花和雞尾酒櫻桃裝飾。", :strInstructionsZH-HANS "将方糖放入老式玻璃杯中，加入苦味剂，加入少许白开水。搅拌直至溶解。\r\n将玻璃杯装满冰块，然后加入威士忌。\r\n\r\n用橙花和鸡尾酒樱桃装饰。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Mettere la zolletta di zucchero nel bicchiere vecchio stile e saturare con il bitter, aggiungere un goccio di acqua naturale.\r\nPestare finché non si scioglie.\r\nRiempi il bicchiere con cubetti di ghiaccio e aggiungi il whisky.\r\nGuarnire con una scorza d'arancia e una ciliegina al maraschino.", :strMeasure2 "2 dashes", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2016-11-04 09:46:42", :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Angostura bitters", :strMeasure4 "dash", :strMeasure5 nil, :strIngredient6 nil, :strImageSource "https://www.thecocktaildb.com/drink/11001-Old-Fashioned-Cocktail", :strIngredient8 nil, :strGlass "Old-fashioned glass", :strInstructionsDE "Zuckerwürfel in ein old fashioned Glas geben und mit Bitterstoff sättigen, einen Schuss Wasser hinzufügen. Vermischen, bis sie sich auflösen.", :strDrinkAlternate nil, :strIngredient3 "Sugar", :strCreativeCommonsConfirmed "Yes", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Vanilla ice-cream", :strMeasure11 nil, :strInstructionsFR "Mélanger la vodka, le Kahlua, le Bailey's, la crème glacée et les Oreo dans un mixeur. Verser dans un grand verre givré. Garnir de crème fouettée et d'une cerise.", :strVideo nil, :strInstructions "Blend Vodka, Kahlua, Bailey's, ice-cream and the Oreo well in a blender. Pour into a large frosted glass. Garnish with whipped cream and a cherry.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Oreo cookie", :strImageAttribution nil, :strDrink "Oreo Mudslide", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/tpwwut1468925017.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 oz ", :strInstructionsES "Mezcle bien en una batidora el vodka, el Kahlua, el Bailey's, el helado y las Oreo. Verter en un vaso grande escarchado. Decorar con nata montada y una cereza.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Vodka", :idDrink "13499", :strInstructionsZH-HANT "在攪拌機中將伏特加、甘露酒、百利甜酒、冰淇淋和奧利奧充分混合。倒入大磨砂玻璃杯中。用生奶油和櫻桃裝飾。", :strInstructionsZH-HANS "在搅拌机中将伏特加、甘露酒、百利甜酒、冰淇淋和奥利奥充分混合。倒入一个大磨砂玻璃杯中。用生奶油和樱桃装饰。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Mescola bene Vodka, Kahlua, Baileys, gelato e un oreo in un frullatore. Versare in un grande bicchiere. Guarnire con panna montata e una ciliegia.", :strMeasure2 "1 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2016-07-19 11:43:37", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Kahlua", :strMeasure4 "2 scoops ", :strMeasure5 "1 ", :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Collins Glass", :strInstructionsDE "Mischen Sie Wodka, Kahlua, Bailey's, Eis und den Oreo gut in einem Mixer. In ein großes mattiertes Glas geben. Mit Schlagsahne und einer Kirsche garnieren.", :strDrinkAlternate nil, :strIngredient3 "Baileys irish cream", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Jagermeister", :strMeasure11 nil, :strInstructionsFR "Mélangez simplement le tout.\nC'est censé être un shot, mais cela fonctionne très bien comme une boisson de taille adulte sur beaucoup de glace.\n\nLe goût d'un biscuit à l'avoine.", :strVideo nil, :strInstructions "Just mix it all together.\nIt's meant to be a shot, but it works just fine as a proper adult-sized drink over lots of ice.\n\nTastes like an oatmeal cookie.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 parts", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Goldschlager", :strImageAttribution nil, :strDrink "Oatmeal Cookie", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/bsvmlg1515792693.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "4 parts", :strInstructionsES "Simplemente mézclalo todo junto.\nEstá destinado a ser un trago, pero funciona bien como una bebida adecuada para adultos con mucho hielo.\n\nSabe a galleta de avena.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Kahlua", :idDrink "17266", :strInstructionsZH-HANT "只需將它們混合在一起即可。\n它本來是一杯酒，但作為成人份量的加冰的飲料也很好。\n\n嘗起來像燕麥餅乾。", :strInstructionsZH-HANS "只需将它们混合在一起即可。\n它本来是一杯酒，但作为成人份量的加冰的饮料也很好。\n\n尝起来像燕麦饼干。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Mescola tutto insieme.\r\nÈ pensato per essere uno shot, ma funziona perfettamente come una bevanda per adulti con un sacco di ghiaccio.", :strMeasure2 "2 parts", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2018-01-12 21:31:33", :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Baileys irish cream", :strMeasure4 "1 part", :strMeasure5 "1/2 part", :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Mason jar", :strInstructionsDE "Einfach alles zusammenmischen. Es soll ein Shot sein, aber es funktioniert genauso gut wie ein richtiges Getränk in Erwachsenengröße über viel Eis. Schmeckt wie ein Haferflockenplätzchen.", :strDrinkAlternate nil, :strIngredient3 "Butterscotch schnapps", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Sour mix", :strMeasure11 nil, :strInstructionsFR "Mélangez les liqueurs dans un mixeur. Ajoutez une demi-boule de glace et mélangez. Décorer d'un drapeau orange et cerise. Tellement bon que ça va fondre dans la bouche !!!", :strVideo nil, :strInstructions "Combine liquors in a blender. Add a half scoop of ice and blend. Garnish with an orange and cherry flag. So good it will melt in your mouth!!!", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1.5 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Orange Push-up", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/mgf0y91503565781.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "4 oz ", :strInstructionsES "Combine los licores en una licuadora. Añade media bola de hielo y licúa. Adorne con una bandera de naranja y cereza. ¡¡¡Tan rico que se deshará en tu boca!!!", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Spiced rum", :idDrink "14586", :strInstructionsZH-HANT "在攪拌機中混合酒類。加入半勺冰並混合。用橙色和櫻桃旗裝飾。太好了，它會在你嘴裡融化！", :strInstructionsZH-HANS "在搅拌机中混合酒类。添加半勺冰并混合。用橙色和樱桃旗装饰。太好了，它会在你嘴里融化！", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Unisci i liquori in un frullatore.\r\nAggiungere mezzo misurino di ghiaccio e frullare.\r\nGuarnire con una bandiera di arancia e ciliegia.", :strMeasure2 "0.5 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-08-24 10:09:41", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Grenadine", :strMeasure4 "1 splash ", :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Hurricane glass", :strInstructionsDE "Mische Liköre in einem Mixer. Eine halbe Kugel Eis hinzufügen und untermischen. Mit einer Orange- und Kirschfahne garnieren. So gut, dass es in deinem Mund schmilzt.", :strDrinkAlternate nil, :strIngredient3 "Orange juice", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Rosemary Syrup", :strMeasure11 nil, :strInstructionsFR "Verser le spiritueux au fond du verre et compléter avec les boissons mixées. Décorez avec des tranches d'orange à l'intérieur du verre et du romarin sur le dessus.", :strVideo nil, :strInstructions "Add the spirits to the bottom of the glass and top equally with the mixer drinks. Garnish with orange slices inside the glass as well as some rosemary on top.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "Citrus", :strMeasure1 "1 shot", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Soda Water", :strImageAttribution nil, :strDrink "Orange Rosemary Collins", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/mokcas1604179977.jpg", :strMeasure15 nil, :strIngredient7 "Orange Peel", :strMeasure3 "Top", :strInstructionsES "Añada las bebidas espirituosas en el fondo del vaso y complete a partes iguales con las bebidas mezcladas. Adorne con rodajas de naranja en el interior del vaso y un poco de romero en la parte superior.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Gin", :idDrink "178341", :strInstructionsZH-HANT "將烈酒添加到玻璃杯的底部，並與攪拌飲料均勻地添加到頂部。在玻璃杯內裝飾橙片，並在上面放一些迷迭香。", :strInstructionsZH-HANS "将烈酒添加到玻璃杯的底部，并与搅拌饮料均匀地添加到顶部。在玻璃杯内装饰橙片，并在上面放一些迷迭香。", :strMeasure9 nil, :strMeasure7 "Garnish with", :strInstructionsIT "Aggiungere gli alcolici sul fondo del bicchiere e sopra ugualmente con le bevande del mixer. Guarnire con fettine d'arancia nel bicchiere e sopra un po 'di rosmarino.", :strMeasure2 "Top", :strMeasure12 nil, :strMeasure10 nil, :dateModified nil, :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 "Garnish with", :strMeasure14 nil, :strIngredient2 "Orange Juice", :strMeasure4 "25 ml", :strMeasure5 "Top", :strIngredient6 "Rosemary", :strImageSource nil, :strIngredient8 nil, :strGlass "Highball glass", :strInstructionsDE nil, :strDrinkAlternate nil, :strIngredient3 "Lemon Juice", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Espresso", :strMeasure11 nil, :strInstructionsFR "Mélanger tous les ingrédients dans une casserole moyenne à fond épais. Remuer à feu doux jusqu'à ce que le chocolat fonde. Augmentez le feu et portez à ébullition en remuant souvent. Retirer du feu et fouetter jusqu'à ce que le mélange soit mousseux. Remettez sur le feu et portez à nouveau à ébullition. Retirer du feu, fouetter jusqu'à ce que le mélange soit mousseux. Répétez le chauffage et fouettez à nouveau. Jeter le zeste d'orange. (Peut être préparé 2 heures à l'avance. Laisser reposer à température ambiante. Avant de servir, porter à ébullition, retirer du feu et fouetter jusqu'à ce qu'il soit mousseux.) Versez le chocolat chaud dans des tasses à café. Donne 2 portions.", :strVideo nil, :strInstructions "Combine all ingredients in heavy medium saucepan. Stir over low heat until chocolate melts. Increase heat and bring just to a boil, stirring often. Remove from heat and whisk untily frothy. Return to heat and bring to boil again. Remove from heat, whisk until frothy. Repeat heating and whisking once again. Discard orange peel. (Can be prepared 2 hours ahead. Let stand at room temperature. Before serving, bring just to boil, remove from heat and whisk until frothy.) Pour hot chocolate into coffee mugs. Makes 2 servings.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 cups ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Nutmeg", :strImageAttribution nil, :strDrink "Orange Scented Hot Chocolate", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/hdzwrh1487603131.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "3 2-inch strips ", :strInstructionsES "Combine todos los ingredientes en una cacerola mediana y pesada. Revuelve a fuego lento hasta que el chocolate se derrita. Aumente el fuego y deje que hierva, revolviendo con frecuencia. Retirar del fuego y batir hasta que esté espumoso. Regresar al fuego y dejar hervir nuevamente. Retirar del fuego, batir hasta que esté espumoso. Repita calentar y batir una vez más. Deseche la cáscara de naranja. (Se puede preparar con 2 horas de anticipación. Dejar reposar a temperatura ambiente. Antes de servir, dejar hervir, retirar del fuego y batir hasta que esté espumoso). Vierta el chocolate caliente en tazas de café. Rinde 2 porciones.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Milk", :idDrink "12748", :strInstructionsZH-HANT "將所有成分混合在中型平底鍋中。小火攪拌至巧克力融化。增加熱量並煮沸，經常攪拌。從火上移開並攪拌直至起泡。重新加熱並再次煮沸。從火上移開，攪拌至起泡。再次重複加熱和攪拌。丟棄橙皮。 （可提前 2 小時準備。在室溫下靜置。食用前，將其煮沸，離火並攪拌直至起泡。）將熱巧克力倒入咖啡杯中。做 2 份。", :strInstructionsZH-HANS "将所有成分混合在中型平底锅中。小火搅拌直至巧克力融化。增加热量并煮沸，经常搅拌。从火上移开并搅拌直至起泡。重新加热并再次煮沸。从火上移开，搅拌直至起泡。再次重复加热和搅拌。丢弃橙皮。 （可以提前 2 小时准备。在室温下静置。食用前，将其煮沸，离火并搅拌直至起泡。）将热巧克力倒入咖啡杯中。做 2 份。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Unisci tutti gli ingredienti tranne l'arancia in una casseruola media.\r\nMescolare a fuoco basso fino a quando il cioccolato si scioglie.\r\nAumenta la fiamma e porta a ebollizione, mescolando spesso.\r\nSpegni il fuoco e frulla fino a renderle leggermente spumose.\r\nAccendi il fuoco e riporta a bollore.\r\nSpegni il fuoco, sbattere fino a quando non diventa spumoso.\r\nScartare la buccia d'arancia.\r\n(Può essere preparato 2 ore prima. Lasciar riposare a temperatura ambiente. Prima di servire, portate appena ad ebollizione, spegnete il fuoco e frullate fino a quando non sarà spumoso) Versare la cioccolata calda nelle tazze da caffè. Per 2 porzioni.", :strMeasure2 "4 oz chopped bittersweet or semi-sweet ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-02-20 15:05:31", :strMeasure8 nil, :strCategory "Cocoa", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Chocolate", :strMeasure4 "1/2 tsp instant ", :strMeasure5 "1/8 tsp ground ", :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Coffee mug", :strInstructionsDE "Alle Zutaten in einem Topf vermengen und bei schwacher Hitze umrühren, bis die Schokolade schmilzt. Die Hitze erhöhen und unter ständigem Rühren zum Kochen bringen. Vom Herd nehmen und ununterbrochen schaumig schlagen. Wieder aufwärmen und wieder zum Kochen bringen. Vom Herd nehmen, verquirlen und schaumig rühren. Wiederholen Sie das Erwärmen und Verquirlen noch einmal. Orangenschale entsorgen (Kann 2 Stunden im Voraus zubereitet werden. Bei Raumtemperatur stehen lassen. Vor dem Servieren einfach zum Kochen bringen, vom Herd nehmen und schaumig schlagen.) Gießen Sie die heiße Schokolade in Kaffeetassen. Macht 2 Portionen.", :strDrinkAlternate nil, :strIngredient3 "Orange peel", :strCreativeCommonsConfirmed "No", :strAlcoholic "Non alcoholic", :strIngredient14 nil} {:strIngredient4 "Ice", :strMeasure11 nil, :strInstructionsFR "Ajouter les ingrédients et mélanger dans le mixeur.", :strVideo nil, :strInstructions "Add ingredients and mix in blender.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "12 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Owen's Grandmother's Revenge", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/0wt4uo1503565321.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "12 oz frozen ", :strInstructionsES "Añada los ingredientes y mézclelos en la batidora.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Whiskey", :idDrink "13200", :strInstructionsZH-HANT "加入食材並在攪拌機中混合。", :strInstructionsZH-HANS "添加成分并在搅拌机中混合。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Aggiungere gli ingredienti e mescola nel frullatore.", :strMeasure2 "12 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-08-24 10:02:02", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Beer", :strMeasure4 "1 cup crushed ", :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Highball glass", :strInstructionsDE "Zutaten im Mixer vermengen.", :strDrinkAlternate nil, :strIngredient3 "Lemonade", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil}]}, :fetched-at 1790009882370}, "https://www.thecocktaildb.com/api/json/v1/1/list.php?c=list" {:data {:drinks [{:strCategory "Beer"} {:strCategory "Cocktail"} {:strCategory "Cocoa"} {:strCate