/iixv4l1485620014.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 nil, :strInstructionsES "Consigue un vaso de chupito y vierte tres tragos de aguardiente. Haz lo mismo con Surge Cola. Luego bájelo como lo haría Scheetz.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Peachtree schnapps", :idDrink "14888", :strInstructionsZH-HANT "拿一個小玻璃杯，倒入三杯杜松子酒。對 Surge Cola 進行同樣的操作。然後像 Scheetz 那樣把它放下來。", :strInstructionsZH-HANS "拿一个小玻璃杯，倒入三杯杜松子酒。对 Surge Cola 进行同样的操作。然后像 Scheetz 那样把它放下来。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Prendi un bicchierino e versa tre shot di grappa.", :strMeasure2 "4 shots ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-01-28 16:13:34", :strMeasure8 nil, :strCategory "Soft Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Surge", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Highball glass", :strInstructionsDE "Holen Sie sich ein Schnapsglas und geben Sie drei Schüsse des Schnapses hinein. Das Gleiche gilt für den Schwall Cola.", :strDrinkAlternate nil, :strIngredient3 nil, :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Coca-Cola", :strMeasure11 nil, :strInstructionsFR "Aucune instruction de mélange spécifique, il suffit de verser chaque ingrédient dans un verre. Le citron va avec.", :strVideo nil, :strInstructions "No specific mixing instructions, just poor every ingredient in one glass. The lemon goes with it.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 nil, :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "7-Up", :strImageAttribution nil, :strDrink "Zoksel", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/ft8ed01485620930.jpg", :strMeasure15 nil, :strIngredient7 "Lemon", :strMeasure3 nil, :strInstructionsES "No hay instrucciones de mezcla específicas, simplemente mezcla cada ingrediente en un vaso. El limón va con él.\n", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Beer", :idDrink "15691", :strInstructionsZH-HANT "沒有具體的混合說明，只是一杯中的每種成分都很差。檸檬與之搭配。", :strInstructionsZH-HANS "没有具体的混合说明，只是一杯中的每种成分都很差。柠檬与之搭配。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Nessuna istruzione di miscelazione specifica, versa ogni ingrediente in un bicchiere.\r\n", :strMeasure2 nil, :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-01-28 16:28:50", :strMeasure8 nil, :strCategory "Soft Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Root beer", :strMeasure4 " slice\n", :strMeasure5 nil, :strIngredient6 "Creme de Cassis", :strImageSource nil, :strIngredient8 nil, :strGlass "Beer pilsner", :strInstructionsDE "Keine spezifischen Mischungsanweisungen, nur alle Zutaten in ein Glas geben. Dazu passt Zitrone.", :strDrinkAlternate nil, :strIngredient3 "Lemonade", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Pernod", :strMeasure11 nil, :strInstructionsFR "Mélangez à grande vitesse pendant 5 secondes maximum.\n\nVersez dans un verre, ajoutez des glaçons pour remplir, puis ajoutez la garniture.\n\n*Mélange Donn's : Portez à ébullition 3 bâtons de cannelle écrasés, 1 tasse de sucre et 1 tasse d'eau, en remuant jusqu'à ce que le sucre soit dissous.\n\nLaisser mijoter pendant 2 minutes, puis retirer du feu et laisser reposer au moins 2 heures avant de filtrer dans une bouteille en verre propre.\n\nAjoutez ensuite 1 partie de sirop et 2 parties de jus de pamplemousse frais ensemble.", :strVideo nil, :strInstructions "Blend at high speed for no more than 5 seconds.\n\nPour into a glass, add ice cubes to fill, then add the garnish.\n\n*Donn’s mix: Bring 3 crushed cinnamon sticks, 1 cup of sugar and 1 cup of water to a boil, stirring until the sugar is dissolved.\n\nSimmer for 2 minutes, then remove from the heat and let sit for at least 2 hours before straining into a clean glass bottle.\n\nThen add 1 part of the syrup and 2 parts of fresh grapefruit juice together.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 1/2 oz", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Grenadine", :strImageAttribution nil, :strDrink "Zombie", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/2en3jk1509557725.jpg", :strMeasure15 nil, :strIngredient7 "Angostura Bitters", :strMeasure3 "1 oz", :strInstructionsES "Licue a alta velocidad durante no más de 5 segundos.\n\nVierta en un vaso, agregue cubitos de hielo para llenar y luego agregue la guarnición.\n\n*Mezcla de Donn: hierva 3 ramas de canela trituradas, 1 taza de azúcar y 1 taza de agua, revolviendo hasta que el azúcar se disuelva.\n\nCocine a fuego lento durante 2 minutos, luego retírelo del fuego y déjelo reposar durante al menos 2 horas antes de colarlo en una botella de vidrio limpia.\n\nLuego agregue 1 parte de almíbar y 2 partes de jugo de pomelo fresco.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Rum", :idDrink "17241", :strInstructionsZH-HANT "高速攪拌不超過5秒。\n\n倒入玻璃杯中，加入冰塊，然後添加裝飾。\n\n*Donn's mix：將 3 根壓碎的肉桂棒、1 杯糖和 1 杯水煮沸，攪拌至糖溶解。\n\n煮 2 分鐘，然後離火並靜置至少 2 小時，然後過濾到乾淨的玻璃瓶中。\n\n然後將1份糖漿和2份新鮮柚子汁一起加入。", :strInstructionsZH-HANS "高速搅拌不超过5秒。\n\n倒入玻璃杯中，加入冰块，然后添加装饰。\n\n*Donn's mix：将 3 根压碎的肉桂棒、1 杯糖和 1 杯水煮沸，搅拌直至糖溶解。\n\n煮 2 分钟，然后离火并静置至少 2 小时，然后滤入干净的玻璃瓶中。\n\n然后将1份糖浆和2份新鲜柚子汁一起加入。", :strMeasure9 nil, :strMeasure7 "1 drop", :strInstructionsIT "Frullare ad alta velocità per non più di 5 secondi.\nVersare in un bicchiere, aggiungere i cubetti di ghiaccio per farcire, quindi aggiungere la guarnizione.\n* Preparato per Donn: porta a ebollizione 3 bastoncini di cannella tritati, 1 tazza di zucchero e 1 tazza di acqua, mescolando fino a quando lo zucchero si è sciolto.\nCuocere a fuoco lento per 2 minuti, quindi togliere dal fuoco e lasciare riposare per almeno 2 ore prima di filtrare in una bottiglia di vetro pulita.\nQuindi aggiungere 1 parte di sciroppo e 2 parti di succo di pompelmo fresco insieme.", :strMeasure2 "1 1/2 oz", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-11-01 17:35:26", :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 "1 tsp", :strMeasure14 nil, :strIngredient2 "Gold rum", :strMeasure4 "1 tsp", :strMeasure5 "1 tsp", :strIngredient6 "Lime Juice", :strImageSource nil, :strIngredient8 nil, :strGlass "Hurricane glass", :strInstructionsDE "Mixen Sie mit hoher Geschwindigkeit für nicht mehr als 5 Sekunden. In ein Glas gießen, Eiswürfel zum Füllen hinzufügen, dann die Garnitur hinzufügen. *Donnas Mix: 3 zerdrückte Zimtstangen, 1 Tasse Zucker und 1 Tasse Wasser unter Rühren zum Kochen bringen, bis der Zucker gelöst ist. 2 Minuten köcheln lassen, dann vom Herd nehmen und mindestens 2 Stunden ruhen lassen, bevor man in eine saubere Glasflasche abseiht. Dann 1 Teil des Sirups und 2 Teile frischen Grapefruitsaft dazugeben.", :strDrinkAlternate nil, :strIngredient3 "151 proof rum", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Mélangez la sambuca avec la rootbeer et remuez. Ajouter de la glace", :strVideo nil, :strInstructions "Mix sambuca with rootbeer and stir. Add ice", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 1/2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Zambeer", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/bje5401485619578.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "cubes", :strInstructionsES "Mezcle la sambuca con cerveza de raíz y revuelva. agregar hielo", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Sambuca", :idDrink "15933", :strInstructionsZH-HANT "將桑布卡與根啤酒混合攪拌。加冰", :strInstructionsZH-HANS "将桑布卡与根啤酒混合并搅拌。加冰", :strMeasure9 nil, :strMeasure7 nil, :strInstructions