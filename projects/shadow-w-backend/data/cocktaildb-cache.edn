sure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Shot glass", :strInstructionsDE "Mit Eis schütteln und in ein Schnapsglas abseihen.", :strDrinkAlternate nil, :strIngredient3 "Pineapple juice", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "151 proof rum", :strMeasure11 nil, :strInstructionsFR "Mélanger avec de la glace jusqu'à consistance lisse. Servir dans un verre tulipe, garnir de crème fouettée.", :strVideo nil, :strInstructions "Blend with Ice until smooth. Serve in a tulip glass, top with whip cream.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1/2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Cream", :strImageAttribution nil, :strDrink "Texas Sling", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/ypl13s1504890158.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1/2 oz ", :strInstructionsES "Licue con hielo hasta que quede suave. Sirva en una copa tulipán y cubra con crema batida.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Kahlua", :idDrink "15639", :strInstructionsZH-HANT "與冰混合直至光滑。盛入鬱金香杯中，上面淋上鮮奶油。", :strInstructionsZH-HANS "与冰混合直至光滑。盛入郁金香杯中，上面淋上鲜奶油。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Frullare con ghiaccio fino a che liscio.\r\nServire in un bicchiere a tulipano, guarnire con panna montata.", :strMeasure2 "1/2 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-08 18:02:39", :strMeasure8 nil, :strCategory "Shake", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Irish cream", :strMeasure4 "1/2 oz Bacardi ", :strMeasure5 "1 oz ", :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Wine Glass", :strInstructionsDE "Mit Eis mischen, bis es glatt ist. In einem Tulpenglas servieren, mit Schlagsahne bedecken.", :strDrinkAlternate nil, :strIngredient3 "Amaretto", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Sugar", :strMeasure11 nil, :strInstructionsFR "Placez le café et les épices dans le cône filtre de votre cafetière. Préparez le café comme d'habitude, laissez-le refroidir. Dans un grand verre, dissolvez 1 ou 2 cuillères à café de sucre dans une once de café (c'est plus facile à dissoudre que si vous le mettez directement sur de la glace). Ajoutez 5 à 6 glaçons et versez le café jusqu'à environ 1 pouce du haut du verre. Posez une cuillère sur le café et versez lentement la crème fouettée dans la cuillère. Cela fera flotter la crème sur le café plutôt que de s’y disperser immédiatement.", :strVideo nil, :strInstructions "Place the coffee and spices in the filter cone of your coffee maker. Brew coffee as usual, let it cool. In a tall glass, dissolve 1 or 2 teaspoons of sugar in an ounce of the coffee (it's easier to dissolve than if you put it right over ice). Add 5-6 ice cubes and pour coffee to within about 1 inch of the top of the glass. Rest a spoon on top of the coffee and slowly pour whipping cream into the spoon. This will make the cream float on top of the coffee rather than dispersing into it right away.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "6 tblsp ground", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Whipping cream", :strImageAttribution nil, :strDrink "Thai Coffee", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/wquwxs1441247025.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "4-5 whole green ", :strInstructionsES "Coloca el café y las especias en el cono de filtro de tu cafetera. Prepare el café como de costumbre y déjelo enfriar. En un vaso alto, disuelve 1 o 2 cucharaditas de azúcar en una onza de café (es más fácil de disolver que si lo pones directamente sobre hielo). Agregue 5-6 cubitos de hielo y vierta el café hasta aproximadamente 1 pulgada de la parte superior del vaso. Coloca una cuchara sobre el café y vierte lentamente la crema para batir en la cuchara. Esto hará que la crema flote sobre el café en lugar de dispersarse inmediatamente.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Coffee", :idDrink "12782", :strInstructionsZH-HANT "將咖啡和香料放入咖啡機的濾錐中。像平常一樣煮咖啡，讓它冷卻。在一個高玻璃杯中，將 1 或 2 茶匙糖溶解在 1 盎司咖啡中（這比直接放在冰上更容易溶解）。加入 5-6 個冰塊，然後將咖啡倒入距離玻璃杯頂部約 1 英吋的位置。將湯匙放在咖啡上，然後將鮮奶油慢慢倒入湯匙中。這將使奶油漂浮在咖啡上，而不是立即分散到咖啡中。", :strInstructionsZH-HANS "将咖啡和香料放入咖啡机的滤锥中。像平常一样煮咖啡，让它冷却。在一个高玻璃杯中，将 1 或 2 茶匙糖溶解在 1 盎司咖啡中（这比直接放在冰上更容易溶解）。添加 5-6 个冰块，然后将咖啡倒入距玻璃杯顶部约 1 英寸的位置。将勺子放在咖啡上，然后将鲜奶油慢慢倒入勺子中。这将使奶油漂浮在咖啡上，而不是立即分散到咖啡中。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Metti il caffè e le spezie nel cono del filtro della tua caffettiera.\r\nPrepara il caffè come al solito, lascialo raffreddare.\r\nIn un bicchiere alto, sciogli 1 o 2 cucchiaini di zucchero in 30gr di caffè (è più facile da sciogliere che se lo metti sul ghiaccio).\r\nAggiungere 5-6 cubetti di ghiaccio e versare il caffè a circa 1 pollice dalla parte superiore del bicchiere.\r\nAppoggia un cucchiaio sopra il caffè e versa lentamente la panna montata nel cucchiaio.\r\nIn questo modo la crema galleggerà sul caffè anziché disperdersi subito.", :strMeasure2 "1/4 tsp ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-09-03 03:23:45", :strMeasure8 nil, :strCategory "Coffee / Tea", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Coriander", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 "Ice", :strImageSource nil, :strIngredient8 nil, :strGlass "Highball glass", :strInstructionsDE "Geben Sie den Kaffee und die Gewürze in den Filterkegel Ihrer Kaffeemaschine. Kaffee wie gewohnt zubereiten, abkühlen lassen. In einem hohen Glas 1 oder 2 Teelöffel Zucker in 2 Esslöffel Kaffee auflösen (es ist einfacher zu lösen, als wenn man ihn direkt auf Eis legt). Füge 5-6 Eiswürfel hinzu und gieße Kaffee 2-3cm von der Oberseite des Glases auf. Einen Löffel auf den Kaffee legen und langsam Schlagsahne in den Löffel geben. Dadurch wird die Creme auf dem Kaffee schweben, anstatt sich sofort darin zu verteilen.", :strDrinkAlternate nil, :strIngredient3 "Cardamom", :strCreativeCommonsConfirmed "No", :strAlcoholic "Non alcoholic", :strIngredient14 nil} {:strIngredient4 "Club soda", :strMeasure11 nil, :strInstructionsFR "Dans un shaker à moitié rempli de glaçons, mélanger le gin, le jus de citron et le sucre. Bien agiter. Filtrer dans un verre Collins également rempli de glaçons. Ajouter le club soda. Remuer et décorer avec la cerise et la tranche d'orange.", :strVideo nil, :strInstructions "In a shaker half-filled with ice cubes, combine the gin, lemon juice, and sugar. Shake well. Strain into a collins glass alomst filled with ice cubes. Add the club soda. Stir and garnish with the cherry and the orange slice.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Maraschino cherry", :strImageAttribution "Will Shenton", :strDrink "Tom Collins", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/7cll921606854636.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 tsp superfine ", :strInstructionsES "En una coctelera llena hasta la mitad con cubitos de hielo, mezcle la ginebra, el zumo de limón y el azúcar. Agitar bien. Colar en un vaso collins también lleno de cubitos de hielo. Añadir la soda. Remover y decorar con la cereza y la rodaja de naranja.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Gin", :idDrink "12402", :strInstructionsZH-HANT "在裝有半杯冰塊的搖酒壺中，將琴酒、檸檬汁和糖混合。搖勻。過濾到幾乎裝滿冰塊的柯林斯玻璃。加入蘇打水。攪拌並用櫻桃和橙片裝飾。", :strInstructionsZH-HANS "在装有半杯冰块的摇酒壶中，将杜松子酒、柠檬汁和糖混合。摇匀。滤入几乎装满冰块的柯林斯玻璃杯。添加苏打水。搅拌并用樱桃和橙片装饰。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "In uno shaker riempito a metà con cubetti di ghiaccio, unisci il gin, il succo di limone e lo zucchero.Mescolate e guarnite con la ciliegia e la fetta d'arancia.Filtrare in un bicchiere collins pieno di cubetti di ghiaccio.Aggiungi la soda club.Agitare bene.", :strMeasure2 "1 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-08-18 15:21:22", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 "1 ", :strMeasure14 nil, :strIngredient2 "Lemon juice", :strMeasure4 "3 oz ", :strMeasure5 "1 ", :strIngredient6 "Orange", :strImageSource "https://commons.wikimedia.org/wiki/File:Tom_Collins.jpg", :strIngredient8 nil, :strGlass "Collins glass", :strInstructionsDE "In einem Shaker, der halb mit Eiswürfeln gefüllt ist, Gin, Zitronensaft und Zucker mischen. Gut schütteln. In ein Collins-Glas abseihen, das mit Eiswürfeln gefüllt ist. Füge das Club-Soda hinzu. Umrühren und mit der Kirsche und der Orangenscheibe garnieren.", :strDrinkAlternate nil, :strIngredient3 "Sugar", :strCreativeCommonsConfirmed "Yes", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Placez tous les ingrédients dans le bol du mixeur – couvrez et fouettez à vitesse moyenne jusqu'à ce que le tout soit bien mélangé. Versez un grand, 2 moyens ou 3 petits verres et buvez.", :strVideo nil, :strInstructions "Place all ingredients in the blender jar - cover and whiz on medium speed until well blended. Pour in one tall, 2 medium or 3 small glasses and drink up.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 cups ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Tomato Tang", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/869qr81487603278.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 dash ", :strInstructionsES "Coloque todos los ingredientes en la jarra de la licuadora, cubra y bata a velocidad media hasta que estén bien mezclados. Vierta un vaso alto, 2 medianos o 3 pequeños y bébalo.", :strIngredient15 nil, :strIBA nil, :strIngredient11 ni