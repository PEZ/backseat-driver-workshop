 :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "12 oz fine ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Marshmallows", :strImageAttribution nil, :strDrink "Hot Chocolate to Die for", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/0lrmjp1487603166.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1/2 tsp ", :strInstructionsES "Derretir el chocolate, la mantequilla y la vainilla al baño maría. Cuando todo esté suave, agrega la crema.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Chocolate", :idDrink "12738", :strInstructionsZH-HANT "將巧克力、奶油和香草放入雙鍋中融化。當奶油均勻攪拌時。", :strInstructionsZH-HANS "将巧克力、黄油和香草放入双锅中融化。当奶油均匀搅拌时。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Sciogliere il cioccolato, il burro e la vaniglia a bagnomaria.Quando risulterà liscio aggiungere la panna.", :strMeasure2 "1 tsp ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-02-20 15:06:06", :strMeasure8 nil, :strCategory "Cocoa", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Butter", :strMeasure4 "1 cup ", :strMeasure5 "mini ", :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Coffee mug", :strInstructionsDE "Schokolade, Butter und Vanille in einem Doppelkocher schmelzen. Wenn es glatt ist, die Sahne unterrühren.", :strDrinkAlternate nil, :strIngredient3 "Vanilla extract", :strCreativeCommonsConfirmed "No", :strAlcoholic "Non alcoholic", :strIngredient14 nil}]}, :fetched-at 1790009882369}, "https://www.thecocktaildb.com/api/json/v1/1/search.php?f=e" {:data {:drinks [{:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Mélangez le sirop et le lait dans un verre fontaine. Ajoutez de l'eau gazeuse, servez avec une paille.", :strVideo nil, :strInstructions "Mix syrup and milk in a fountain glass. Add soda water, serve with a straw.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 tblsp ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Egg Cream", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/mvis731484430445.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "6 oz ", :strInstructionsES "Mezclar en un vaso fuente el almíbar y la leche. Agregue agua con gas, sirva con una pajita.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Chocolate syrup", :idDrink "12668", :strInstructionsZH-HANT "在噴泉杯中混合糖漿和牛奶。加入蘇打水，用吸管飲用。", :strInstructionsZH-HANS "在喷泉杯中混合糖浆和牛奶。加入苏打水，用吸管饮用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Mescolare lo sciroppo e il latte in un bicchiere da fontana. Aggiungere la soda water, servire con una cannuccia.", :strMeasure2 "6 oz whole ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-01-14 21:47:26", :strMeasure8 nil, :strCategory "Other / Unknown", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Milk", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Coffee mug", :strInstructionsDE "Sirup und Milch in einem Fontänenglas mischen. Mit Sodawasser aufgießen und mit einem Strohhalm servieren.", :strDrinkAlternate nil, :strIngredient3 "Soda water", :strCreativeCommonsConfirmed "No", :strAlcoholic "Non alcoholic", :strIngredient14 nil} {:strIngredient4 "Light rum", :strMeasure11 "Ground ", :strInstructionsFR "Dans un petit bol, battre les jaunes d'œufs jusqu'à ce qu'ils soient mélangés. Ajouter progressivement 1/4 de tasse de sucre, en battant à grande vitesse jusqu'à ce que le mélange soit épais et de couleur citron. Incorporer le lait, le rhum, le bourbon, la vanille et le sel. Refroidir complètement. Fouetter la crème. Bien laver les batteurs. Dans un grand bol, battre les blancs d'oeufs jusqu'à l'obtention de pics mous. Ajouter progressivement le quart de tasse de sucre restant, en battant pour obtenir des pics fermes. Incorporer le mélange de jaunes d'œuf et la crème fouettée aux blancs d'œuf. Servir immédiatement. Saupoudrer chaque portion de noix de muscade. Servir dans un bol à punch ou un autre grand bol. REMARQUE : Pour un lait de poule sans alcool, préparer le lait de poule comme ci-dessus, mais omettre le bourbon et le rhum et augmenter la quantité de lait à 3 tasses.", :strVideo nil, :strInstructions "In a small mixer bowl beat egg yolks till blended. Gradually add 1/4 cup sugar, beating at high speed till thick and lemon colored. Stir in milk, stir in rum, bourbon, vanilla, and salt. Chill thoroughly. Whip cream. Wash beaters well. In a large mixer bowl beat egg whites till soft peaks form. Gradually add remaining 1/4 cup sugar, beating to stiff peaks. Fold yolk mixture and whipped cream into egg whites. Serve immediately. Sprinkle nutmeg over each serving. Serve in a punch bowl or another big bowl. NOTE: For a nonalcoholic eggnog, prepare Eggnog as above, except omit the bourbon and rum and increase the milk to 3 cups.", :strIngredient10 "Sugar", :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "6 ", :strIngredient9 "Egg white", :strIngredient13 nil, :strIngredient5 "Bourbon", :strImageAttribution nil, :strDrink "Egg Nog #4", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/wpspsy1468875747.jpg", :strMeasure15 nil, :strIngredient7 "Salt", :strMeasure3 "2 cups ", :strInstructionsES "En una batidora pequeña, bata las yemas de huevo hasta obtener una mezcla homogénea. Añada gradualmente 1/4 de taza de azúcar, batiendo a velocidad alta hasta que espese y adquiera el color del limón. Añada la leche, el ron, el bourbon, la vainilla y la sal. Enfríe bien. Montar la nata. Lavar bien los batidores. En un bol grande batir las claras a punto de nieve. Añadir gradualmente el 1/4 de taza de azúcar restante, batiendo a punto de nieve. Incorporar la mezcla de yemas y nata montada a las claras. Servir inmediatamente. Espolvoree nuez moscada sobre cada porción. Servir en una ponchera u otro bol grande. NOTA: Para un ponche de huevo sin alcohol, prepare el ponche de huevo como se indica arriba, pero omita el bourbon y el ron y aumente la leche a 3 tazas.", :strIngredient15 nil, :strIBA nil, :strIngredient11 "Nutmeg", :strIngredient1 "Egg yolk", :idDrink "12910", :strInstructionsZH-HANT "在一個小攪拌碗中攪拌蛋黃直至混合。逐漸加入 1/4 杯糖，以高速攪打至濃稠並呈檸檬色。加入牛奶、蘭姆酒、波本威士忌、香草和鹽攪拌。徹底冷卻。攪打奶油。好好清洗攪拌器。在一個大攪拌碗中攪拌蛋白至形成軟峰。逐漸加入剩餘的 1/4 杯糖，攪打至硬性發泡。將蛋黃混合物和鮮奶油拌入蛋白中。立即上菜。在每份食物上撒上肉荳蔻。盛入潘趣酒碗或另一個大碗中。注意：對於不含酒精的蛋酒，請按照上述方法準備蛋酒，只是省略波本威士忌和朗姆酒並將牛奶增加到 3 杯。", :strInstructionsZH-HANS "在一个小搅拌碗中搅拌蛋黄直至混合。逐渐加入 1/4 杯糖，高速搅打至浓稠并呈柠檬色。加入牛奶、朗姆酒、波本威士忌、香草和盐搅拌。彻底冷却。搅打奶油。好好清洗搅拌器。在一个大搅拌碗中搅拌蛋白直至形成软峰。逐渐加入剩余的 1/4 杯糖，搅打至硬性发泡。将蛋黄混合物和鲜奶油拌入蛋白中。立即上菜。在每份食物上撒上肉豆蔻。盛入潘趣酒碗或另一个大碗中。注意：对于不含酒精的蛋酒，按照上述方法准备蛋酒，只是省略波旁威士忌和朗姆酒并将牛奶增加到 3 杯。", :strMeasure9 "6 ", :strMeasure7 "1/4 tsp ", :strInstructionsIT "Montare l'albume dell'uovo e lo zucchero insieme, unire ai due tipi di latte, vaniglia e rum. Mescolare bene. Cospargere di noce moscata. Per 6 porzioni.", :strMeasure2 "1/4 cup ", :strMeasure12 nil, :strMeasure10 "1/4 cup ", :dateModified "2016-07-18 22:02:27", :strMeasure8 "1 cup ", :strCategory "Punch / Party Drink", :strMeasure6 "1 tsp ", :strMeasure14 nil, :strIngredient2 "Sugar", :strMeasure4 "1/2 cup ", :strMeasure5 "1/2 cup ", :strIngredient6 "Vanilla extract", :strImageSource nil, :strIngredient8 "Whipping cream", :strGlass "Punch bowl", :strInstructionsDE "In einer kleinen Rührschüssel das Eigelb verrühren. Nach und nach 1/4 Tasse Zucker hinzufügen und mit hoher Geschwindigkeit schlagen, bis er dick und zitronengelb ist. Milch unterrühren, Rum, Bourbon, Vanille und Salz unterrühren. Gründlich abkühlen lassen. Sahne schlagen. Schlägel gut waschen. In einer großen Mixerschüssel Eiweiß zu weichen Spitzen schlagen. Nach und nach den restlichen Zucker aus der 1/4 Tasse hinzufügen und zu steifen Spitzen schlagen. Eigelbmischung und Schlagsahne zu Eiweiß vermengen. Sofort servieren. Muskatnuss über jede Portion streuen. In einer Bowle oder einer anderen großen Schüssel servieren. HINWEIS: Für einen alkoholfreien Eierlikör bereiten Sie den Eierlikör wie oben beschrieben zu, Bourbon und Rum weglassen und die Milch auf 3 Tassen erhöhen.", :strDrinkAlternate nil, :strIngredient3 "Milk", :strCreativeCommonsConfirmed "No", :strAlcoholic "Optional alcohol", :strIngredient14 nil} {:strIngredient4 "Carbonated water", :strMeasure11 nil, :strInstructionsFR "Verser le brandy, le gin et le vermouth doux dans un verre highball sur des glaçons. Remplir d'eau gazeuse. Ajouter le zeste de citron, remuer et servir. (L'eau gazeuse peut être remplacée par du soda au gingembre, si l'on préfère).", :strVideo nil, :strInstructions "Pour brandy, gin, and sweet vermouth into a highball glass over ice cubes. Fill with carbonated water. Add the twist of lemon peel, stir, and serve. (Ginger ale may be substituted for carbonated water, if preferred.)", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "3/4 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Lemon peel", :strImageAttribution nil, :strDrink "English Highball", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/dhvr7d1504519752.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "3/4 oz ", :strInstructionsES "Vierta el brandy, la ginebra y el vermut dulce en un vaso highball sobre cubitos de hielo. Rellenar con agua carbonatada. Añadir el twist de piel de limón, remover y servir. (Si se prefiere, se puede sustituir el agua con gas por ginger ale).", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Brandy", :idDrink "11338", :strInstructionsZH-HANT "將白蘭地、琴酒和甜苦艾酒倒入裝有冰塊的高球杯中。加滿碳酸水。加入檸檬皮，攪拌，即可食用。 （如果願意，可以用薑汁汽水代替碳酸水。）", :strInstructionsZH-HANS "将白兰地、杜松子酒和甜苦艾酒倒入装有冰块的高球杯中。加满碳酸水。加入柠檬皮，搅拌，即可食用。 （如果愿意，可以用姜汁汽水代替碳酸水。）", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Versare brandy, gin e vermouth dolce in un bicchiere highball su cubetti di ghiaccio.Riempi con acqua gassata.Aggiungere la scorza di limone, mescolare e servire.(Ginger ale può essere sostituito con acqua gassata, se si preferisce.)", :strMeasure2 "3/4 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-04 11:09:12", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Gin", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Highball glass", :strInstructionsDE "Gießen Sie Brandy, Gin und süßen Wermut in ein Highball-Glas über Eiswürfel. Mit kohlensäurehaltigem Wasser auffüllen. Die Zitronenschale hinzufügen, umrühren und servieren. (Ginger Ale kann durch kohlensäurehaltiges Wasser ersetzt werden, wenn gewünscht.)", :strDrinkAlternate nil, :strIngredient3 "Sweet Vermouth", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Verser les ingrédients dans un shaker rempli de glace, secouer vigoureusement et filtrer dans un verre à martini bien frais.", :strVideo nil, :strInstructions "Pour ingredients into shaker filled with ice, shake vigorously, and strain into chilled martini glass", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "IBA,NewEra", :strMeasure1 "5 cl", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Espresso Martini", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/n0sx531504372951.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 dash", :strInstructionsES "Vierte los ingredientes en una coctelera llena de hielo, agita enérgicamente y cuela en una copa de martini fría", :strIngredient15 nil, :strIBA "New Era Drinks", :strIngredient11 nil, :strIngredient1 "Vodka", :idDrink "17212", :strInstructionsZH-HANT "將原料倒入裝有冰塊的搖酒壺中，劇烈搖晃，然後濾入冰鎮的馬丁尼杯中", :strInstructionsZH-HANS "将原料倒入装有冰块的摇酒壶中，剧烈摇晃，然后滤入冰镇的马提尼杯中", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Versare gli ingredienti in uno shaker pieno di ghiaccio, shakerare energicamente e filtrare in un bicchiere da martini freddo", :strMeasure2 "1 cl", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-02 18:22:31", :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Kahlua", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "Zutaten in einen mit Eis gefüllten Shaker geben, kräftig schütteln und in ein gekühltes Martini-Glas abseihen.", :strDrinkAlternate nil, :strIngredient3 "Sugar syrup", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Coffee", :strMeasure11 nil, :strInstructionsFR "Mélanger le tout dans un verre à cocktail. Décorer avec de la poudre de chocolat et des grains de café.", :strVideo nil, :strInstructions "Mix together in a cocktail glass. Garnish with some choclate powder and coffee beans", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "DinnerParty,StrongFlavor", :strMeasure1 "1 shot", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Espresso Rumtini", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/acvf171561574403.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 shot", :strInstructionsES "Mezclar todo en una copa de cóctel. Decorar con un poco de chocolate en polvo y granos de café.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Rum", :idDrink "178309", :strInstructionsZH-HANT "在雞尾酒杯中混合在一起。用一些巧克力粉和咖啡豆裝飾", :strInstructionsZH-HANS "在鸡尾酒杯中混合在一起。用一些巧克力粉和咖啡豆装饰", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Mescolare insieme in un bicchiere da cocktail. Guarnire con un po 'di cioccolato in polvere e chicchi di caffè", :strMeasure2 "1/2 shot", :strMeasure12 nil, :strMeasure10 nil, :dateModified nil, :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Vanilla syrup", :strMeasure4 "1 shot", :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "In einem Cocktailglas vermischen. Mit etwas Schokoladenpulver und Kaffeebohnen garnieren", :strDrinkAlternate nil, :strIngredient3 "Espresso", :strCreativeCommonsConfirmed "Yes", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Milk", :strMeasure11 "\n", :strInstructionsFR "Fouetter le substitut d'œuf et le sucre, puis ajouter les deux sortes de lait, la vanille et le rhum. Bien mélanger. Mettre au frais pendant la nuit. Saupoudrer de noix de muscade. Donne 6 portions.", :strVideo nil, :strInstructions "Whip egg substitute and sugar together, combine with the two kinds of milk, vanilla, and rum. Mix well. Chill over night. Sprinkle with nutmeg. Makes 6 servings.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1/2 cup ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Vanilla extract", :strImageAttribution nil, :strDrink "Egg Nog - Healthy", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/qxuppv1468875308.jpg", :strMeasure15 nil, :strIngredient7 "Nutmeg", :strMeasure3 "13 oz skimmed ", :strInstructionsES "Batir el sustituto del huevo y el azúcar juntos, combinar con los dos tipos de leche, la vainilla y el ron. Mezcle bien. Dejar enfriar toda la noche. Espolvorear con nuez moscada. Rinde 6 porciones.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Egg", :idDrink "12916", :strInstructionsZH-HANT "將雞蛋替代品和糖攪打在一起，與兩種牛奶、香草和蘭姆酒混合。攪拌均勻。過夜冷卻。撒上肉荳蔻。做 6 份。", :strInstructionsZH-HANS "将鸡蛋替代品和糖搅打在一起，与两种牛奶、香草和朗姆酒混合。搅拌均匀。过夜冷却。撒上肉豆蔻。做 6 份。", :strMeasure9 "\n", :strMeasure7 "\n", :strInstructionsIT "In una grande casseruola, sbatti insieme le uova, lo zucchero e il sale, se lo desideri.\r\nMescolare 2 tazze di latte.\r\nCuocere a fuoco basso, mescolando continuamente fino a quando il composto è abbastanza denso da ricoprire un cucchiaio di metallo e raggiunge i 71 gradi\r\nSpegnere il fuoco.\r\nIncorporare le restanti 2 tazze di latte e la vaniglia.\r\nCoprire e conservare in frigorifero fino a completo raffreddamento, diverse ore o durante la notte.\r\nPoco prima di servire, versare nella ciotola o nella brocca.\r\nDecorare o aggiungere mescolanze, se lo si desidera.\r\nScegli uno o più riccioli di cioccolato, bastoncini di cannella, estratti di aromi, brandy o liquore aromatizzato, succo di frutta o nettare, noce moscata macinata, ciliegie al maraschino, fette d'arancia, bastoncini di menta piperita o bastoncini di zucchero, brandy semplice, rum o whisky, sorbetto o ghiaccio -crema, panna montata, montata.\r\nServite subito.", :strMeasure2 "3 tblsp ", :strMeasure12 "\n", :strMeasure10 "\n", :dateModified "2016-07-18 21:55:08", :strMeasure8 "\n", :strCategory "Punch / Party Drink", :strMeasure6 "1 tsp ", :strMeasure14 nil, :strIngredient2 "Sugar", :strMeasure4 "3/4 cup skimmed ", :strMeasure5 "1 tsp ", :strIngredient6 "Rum", :strImageSource nil, :strIngredient8 nil, :strGlass "Collins Glass", :strInstructionsDE "Ei-Ersatz und Zucker verrühren, mit den beiden Sorten Milch, Vanille und Rum vermengen. Gut mischen. Über Nacht kühl stellen. Mit Muskatnuss bestreuen. Ergibt 6 Portionen.", :strDrinkAlternate nil, :strIngredient3 "Condensed milk", :strCreativeCommonsConfirmed "No", :strAlcoholic "Optional alcohol", :strIngredient14 nil} {:strIngredient4 "Grenadine", :strMeasure11 nil, :strInstructionsFR "Frotter le bord du verre à cocktail avec du jus de citron et tremper le bord du verre dans du sucre en poudre. Secouer tous les ingrédients (sauf la cerise) avec de la glace et filtrer dans un verre bordé de sucre. Garnir de la cerise et servir.", :strVideo nil, :strInstructions "Rub rim of cocktail glass with lemon juice and dip rim of glass in powdered sugar. Shake all ingredients (except cherry) with ice and strain into sugar-rimmed glass. Top with the cherry and serve.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "3/4 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Lemon juice", :strImageAttribution nil, :strDrink "English Rose Cocktail", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/yxwrpp1441208697.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "3/4 oz ", :strInstructionsES "Frotar el borde de la copa de cóctel con zumo de limón y mojar el borde de la copa en azúcar en polvo. Agitar todos los ingredientes (excepto la cereza) con hielo y colar en un vaso con borde de azúcar. Cubrir con la cereza y servir.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Apricot brandy", :idDrink "11339", :strInstructionsZH-HANT "用檸檬汁擦拭雞尾酒杯的邊緣，然後將玻璃杯的邊緣浸入糖粉中。將所有材料（櫻桃除外）加冰搖勻，濾入糖邊玻璃杯中。上面放上櫻桃即可食用。", :strInstructionsZH-HANS "用柠檬汁擦拭鸡尾酒杯的边缘，然后将玻璃杯的边缘浸入糖粉中。将所有原料（樱桃除外）加冰摇匀，滤入糖边玻璃杯中。上面放上樱桃即可食用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Strofinare il bordo del bicchiere da cocktail con succo di limone e immergere il bordo del bicchiere nello zucchero a velo.Completare con la ciliegia e servire.Shakerare tutti gli ingredienti (tranne la ciliegia) con ghiaccio e filtrare in un bicchiere bordato di zucchero.", :strMeasure2 "1 1/2 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-09-02 16:44:57", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 "1 ", :strMeasure14 nil, :strIngredient2 "Gin", :strMeasure4 "1 tsp ", :strMeasure5 "1/4 tsp ", :strIngredient6 "Cherry", :strImageSource nil, :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "Reiben Sie den Rand des Cocktailglases mit Zitronensaft ein und tauchen den Rand des Glases in Puderzucker. Alle Zutaten (außer Kirsche) mit Eis schütteln und in das zuckerummantelte Glas abseihen. Mit der Kirsche garnieren und servieren.", :strDrinkAlternate nil, :strIngredient3 "Dry Vermouth", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Prenez un verre et mélangez-y le citron vert. Remplissez le verre de glace pilée et ajoutez la Cachaca. Remuez bien et complétez avec de la glace pilée. Décorez avec du citron vert et dégustez !", :strVideo nil, :strInstructions "Take the glass and muddle the lime in it. Fill the glass with crushed ice and add the Cachaca. Stir well and top with some more crushed ice. Garnish with lime and enjoy!", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "Brazilian", :strMeasure1 "60 ml", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Elderflower Caipirinha", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/dif7a31614006331.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "3 cl", :strInstructionsES "Coge el vaso y machaca la lima en él. Llene el vaso con hielo picado y añada la cachaca. Remueve bien y añade más hielo picado. Decóralo con lima y ¡a disfrutar!", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Cachaca", :idDrink "178346", :strInstructionsZH-HANT "拿起玻璃杯，將石灰混入其中。在玻璃杯中裝滿碎冰，然後加入卡查卡酒。充分攪拌，然後在上面再加一些碎冰。用酸橙裝飾即可享用！", :strInstructionsZH-HANS "拿起玻璃杯，将石灰混入其中。在玻璃杯中装满碎冰，然后加入卡查卡酒。充分搅拌，然后在上面再加一些碎冰。用酸橙装饰即可享用！", :strMeasure9 nil, :strMeasure7 "", :strInstructionsIT "In un bicchiere pestare il lime. Riempi il bicchiere con ghiaccio tritato e aggiungi la cachaca. Mescola bene e aggiungi altro ghiaccio tritato. Guarnire con il lime.", :strMeasure2 "1", :strMeasure12 nil, :strMeasure10 nil, :dateModified nil, :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 "", :strMeasure14 nil, :strIngredient2 "Lime", :strMeasure4 "", :strMeasure5 "", :strIngredient6 nil, :strImageSource "https://www.instagram.com/p/CKpDNzFFKvl/", :strIngredient8 nil, :strGlass "Collins glass", :strInstructionsDE nil, :strDrinkAlternate nil, :strIngredient3 "Elderflower cordial", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Milk", :strMeasure11 nil, :strInstructionsFR "Dans une grande casserole, battre les œufs, le sucre et le sel, si désiré. Incorporer 2 tasses de lait. Cuire à feu doux, en remuant constamment, jusqu'à ce que le mélange soit suffisamment épais pour recouvrir une cuillère en métal et atteigne 160 degrés F. Retirer du feu. Incorporer les 2 tasses de lait restantes et la vanille. Couvrir et réfrigérer jusqu'à refroidissement complet, plusieurs heures ou toute la nuit. Au moment de servir, verser dans un bol ou un pichet. Garnir ou ajouter des ingrédients, si désiré. Choisissez 1 ou plusieurs de ces ingrédients : Boucles de chocolat, bâtons de cannelle, extraits d'arômes, brandy ou liqueur aromatisés, jus ou nectar de fruits, noix de muscade moulue, cerises au marasquin, tranches d'orange, bâtons de menthe poivrée ou cannes à sucre, brandy nature, run ou whisky, sorbet ou crème glacée, crème à fouetter, chantilly. Servir immédiatement.", :strVideo nil, :strInstructions "In large saucepan, beat together eggs, sugar and salt, if desired. Stir in 2 cups of the milk. Cook over low heat, stirring constantly, until mixture is thick enough to coat a metal spoon and reaches 160 degrees F. Remove from heat. Stir in remaining 2 cups milk and vanilla. Cover and regfigerate until thoroughly chilled, several hours or overnight. Just before serving, pour into bowl or pitcher. Garnish or add stir-ins, if desired. Choose 1 or several of: Chocolate curls, cinnamon sticks, extracts of flavorings, flavored brandy or liqueur, fruit juice or nectar, ground nutmeg, maraschino cherries, orange slices, peppermint sticks or candy canes, plain brandy, run or whiskey, sherbet or ice-cream, whipping cream, whipped. Serve immediately.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "6 ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Vanilla extract", :strImageAttribution nil, :strDrink "Egg-Nog - Classic Cooked", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/quxsvt1468875505.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1/4 tsp ", :strInstructionsES "En un cazo grande, batir los huevos, el azúcar y la sal, si se desea. Añadir 2 tazas de leche. Cocer a fuego lento, sin dejar de remover, hasta que la mezcla esté lo bastante espesa como para cubrir una cuchara de metal y alcance los 160 grados F. Retirar del fuego. Añada las 2 tazas de leche restantes y la vainilla. Cúbrala y refrigérela hasta que esté bien fría, varias horas o toda la noche. Justo antes de servir, viértalo en un bol o en una jarra. Adorne o añada complementos, si lo desea. Elija 1 o varios de: Rizos de chocolate, palitos de canela, extractos de aromatizantes, brandy o licor aromatizado, zumo o néctar de frutas, nuez moscada molida, cerezas al marrasquino, rodajas de naranja, palitos de menta o bastones de caramelo, brandy natural, run o whisky, sorbete o helado, nata montada, chantilly. Servir inmediatamente.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Egg", :idDrink "12914", :strInstructionsZH-HANT "如果需要，請在大平底鍋中將雞蛋、糖和鹽攪拌在一起。加入2杯牛奶攪拌。用小火煮，不斷攪拌，直到混合物濃稠到足以覆蓋金屬湯匙並達到 160 華氏度。離火。加入剩餘的 2 杯牛奶和香草精。蓋上蓋子並重新冷藏幾個小時或過夜，直到完全冷卻。食用前，倒入碗或水罐中。如果需要，可以裝飾或添加攪拌物。選擇一種或多種：巧克力捲、肉桂棒、調味品提取物、調味白蘭地或利口酒、果汁或花蜜、肉荳蔻粉、黑櫻桃、橙片、薄荷棒或棒棒糖、原味白蘭地、淡奶油或威士忌、果子露或冰淇淋、漚奶油、攪打奶油。立即上菜。", :strInstructionsZH-HANS "如果需要，在大平底锅中将鸡蛋、糖和盐搅拌在一起。加入2杯牛奶搅拌。用小火煮，不断搅拌，直到混合物浓稠到足以覆盖金属勺子并达到 160 华氏度。离火。加入剩余的 2 杯牛奶和香草精。盖上盖子并重新冷藏几个小时或过夜，直至完全冷却。食用前，倒入碗或水罐中。如果需要，可以装饰或添加搅拌物。选择一种或多种：巧克力卷、肉桂棒、调味品提取物、调味白兰地或利口酒、果汁或花蜜、肉豆蔻粉、黑樱桃、橙片、薄荷棒或棒棒糖、原味白兰地、淡奶油或威士忌、果子露或冰淇淋、掼奶油、搅打奶油。立即上菜。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "In una grande casseruola, sbatti insieme le uova, lo zucchero e il sale, se lo desideri.\r\nMescolare 2 tazze di latte.\r\nCuocere a fuoco basso, mescolando continuamente fino a quando il composto è abbastanza denso da ricoprire un cucchiaio di metallo e raggiunge i 71 gradi.\r\nTogliere dal fuoco.\r\nIncorporare le restanti 2 tazze di latte e la vaniglia.\r\nCoprire e conservare in frigorifero fino a completo raffreddamento, diverse ore o durante la notte.\r\nPoco prima di servire, versare nella ciotola o nella brocca.\r\nDecorare o aggiungere mescolanze, se lo si desidera.\r\nScegli uno o più riccioli di cioccolato, bastoncini di cannella, estratti di aromi, brandy o liquore aromatizzato, succo di frutta o nettare, noce moscata macinata, ciliegie al maraschino, fette d'arancia, bastoncini di menta piperita o bastoncini di zucchero, brandy semplice, rum o whisky, sorbetto o ghiaccio -crema, panna montata, montata.\r\nServite subito.", :strMeasure2 "1/4 cup ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2016-07-18 21:58:25", :strMeasure8 nil, :strCategory "Punch / Party Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Sugar", :strMeasure4 "1 qt ", :strMeasure5 "1 tsp ", :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Pitcher", :strInstructionsDE "In einem großen Topf Eier, Zucker und Salz verquirlen. 2 Tassen der Milch unterrühren. Bei schwacher Hitze unter ständigem Rühren kochen, bis die Mischung dick genug ist, um einen Metalllöffel zu überziehen und 70 Grad Celsius erreicht. Vom Herd nehmen. Die restlichen 2 Tassen Milch und Vanille unterrühren. Zugedeckt und gekühlt bis zur vollständigen Abkühlung, mehrere Stunden oder über Nacht. Kurz vor dem Servieren in eine Schüssel oder einen Krug geben. Garnieren oder ergänzen Sie Mischung, wenn gewünscht. Wählen Sie 1 oder mehrere: Mit Schoko-Curls, Zimtstangen, Aromaextrakte, aromatisierter Brandy oder Likör, Fruchtsaft oder Nektar, gemahlene Muskatnuss, Maraschinokirschen, Orangenscheiben, Pfefferminzstangen oder Zuckerstangen, schlichter Brandy, Rum oder Whiskey, Sorbet oder Eis, Schlagsahne, aufschlagen. Sofort servieren.", :strDrinkAlternate nil, :strIngredient3 "Salt", :strCreativeCommonsConfirmed "No", :strAlcoholic "Optional alcohol", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Pour que votre graisse de porc soit aussi délicieuse que la leur, voici leur marinade adobo et ce qu'il faut en faire (vous aurez également besoin d'un carré de côtes) :\r\n\r\n4 piments ancho, 8 piments guajillo et 4 piments chipotle, plus 4 gousses d'ail rôties, une demi-tasse de vinaigre de cidre, un quart de cuillère à café d'origan mexicain, 1 cuillère à café de poivre noir moulu, un clou de girofle entier, un quart de cuillère à café de cannelle moulue et une demi-cuillère à café de cumin moulu.\r\n\r\nGriller les piments séchés et les faire tremper dans l'eau pendant au moins une heure jusqu'à ce qu'ils soient réhydratés. Les égoutter et jeter le liquide de trempage. Mélanger les piments trempés avec le reste des ingrédients et réduire en purée jusqu'à l'obtention d'un mélange homogène.\r\n\r\nFumer à froid un carré de petites côtes de porc en prenant une grande casserole d'hôtel avec des copeaux de bois d'un côté et du charbon de bois de l'autre. Placez une autre casserole, plus petite, contenant des côtes de porc, au-dessus de la casserole à charbon de bois/copeaux de bois. Allumez le charbon de bois en veillant à ne pas enflammer les copeaux de bois. Couvrir les deux poêles avec du papier d'aluminium et laisser fumer pendant 10 à 15 minutes, jusqu'à ce que le niveau de fumée désiré soit atteint, puis recouvrir de marinade adobo et envelopper dans du papier d'aluminium avant de placer les côtes dans un four à 300 degrés pendant 7 heures. Lorsque les côtes ont refroidi, égoutter la graisse et l'utiliser pour l'infusion.\r\n\r\nSi vous avez du mal à trouver le même volume de graisse, complétez avec du saindoux de porc acheté chez un boucher. Pour obtenir la même profondeur de goût sans les côtes, faites chauffer la graisse dans une casserole avec quelques cuillères de marinade.\r\n\r\nUne fois votre barquette de graisse de porc assaisonnée sous forme liquide et refroidie, versez des quantités égales de mezcal Ilegal Joven et de graisse dans un récipient pouvant être scellé. Scellez le récipient et secouez-le vigoureusement, puis mettez-le au congélateur pour la nuit. Lorsque le tout est séparé et figé, versez-le à travers une chinoise à mailles fines. Si vous n'avez pas de chinoise, essayez une passoire à mailles fines, ou si vous n'en avez pas, essayez de retirer la plus grande partie de la graisse à la cuillère. Il restera quelques perles de graisse orange dans le mezcal filtré : passez-les à travers plusieurs couches d'étamine (ou de filtres à café) pour vous en débarrasser.\r\n\r\nLe mezcal est maintenant prêt à être bu, pur ou en cocktail.\r\n\r\nTeinture de Habanero\r\n\r\nCouper les habaneros en tranches et ajouter 2 onces de mezcal Ilegal Joven.\r\nLaisser reposer toute la nuit ou jusqu'à ce que le niveau de chaleur souhaité soit atteint.\r\nCocktail\r\n\r\nMélanger le mezcal et la liqueur de chocolat dans un verre à mélange avec de la glace et remuer pendant 45 secondes.\r\nFiltrer dans une coupe réfrigérée.\r\nFaire couler délicatement la liqueur de café à l'intérieur de la coupe à l'aide d'une cuillère.\r\nDécorer avec 5 gouttes de teinture d'habanero.", :strVideo nil, :strInstructions "To ensure that your pork fat is just as delicious as theirs, here’s their adobo marinade and what to do with it (you’ll also need a rack of ribs):\r\n\r\n4 ancho chiles, 8 guajillo chiles and 4 chipotle chiles, plus 4 cloves roasted garlic, half a cup of cider vinegar, a quarter teaspoon of Mexican oregano, 1 teaspoon of ground black pepper, a whole clove, a quarter teaspoon of ground cinnamon and a half teaspoon of ground cumin.\r\n\r\nToast the dried chiles and soak in water for at least an hour until they are rehydrated. Drain and discard the soaking liquid. Combine the soaked chiles with the remaining ingredients and purée until smooth.\r\n\r\nCold smoke a rack of baby back pork ribs by taking a large hotel pan with woodchips on one side and charcoal on the other. Place another, smaller, pan with pork ribs, above the charcoal/woodchip pan. Ignite the charcoal, being careful to not ignite the woodchips. Cover both pans with foil and allow to smoke for 10-15 minutes, until desired level of smoke is achieved, then coat with adobo marinade and wrap in tin foil prior to placing ribs in a 300 degree oven for 7 hours. When the ribs have cooled, strain off the fat and use for the infusion.\r\n\r\nIf you’re having a hard time coming up to the same kind of volume of fat, make up the balance with pork lard from a butcher. To get the same depth of flavor without the ribs, heat up the fat in a pot with a few spoons of the marinade.\r\n\r\nOnce you’ve got your tub of seasoned pork fat in cooled liquid form, pour equal amounts of Ilegal Joven mezcal and fat into a sealable container. Seal the container and give it a really good shake, then put it in the freezer overnight. When the whole thing is separated and congealed, pour it through a fine mesh chinoise. If you don’t have a chinoise, try a fine mesh strainer, or if you don’t have one of those, try spooning off most of the fat. There will be some beads of orange fat left in the strained mezcal: run that through a few layers of cheesecloth (or coffee filters in a pinch) to get rid of the last of it.\r\n\r\nThe mezcal is now ready for drinking, straight-up or in a cocktail. \r\n\r\nHabanero tincture\r\n\r\nSlice habaneros and add 2 ounces Ilegal Joven mezcal.\r\nAllow to sit overnight or until desired level of heat is achieved.\r\nCocktail\r\n\r\nCombine mezcal and chocolate liqueur in a mixing glass with ice and stir for 45 seconds.\r\nStrain into chilled coupe.\r\nCarefully \"sink\" the coffee liqueur down the inside of the coupe over a spoon.\r\nGarnish with 5 drops habanero tincture.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 oz", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Empellón Cocina's Fat-Washed Mezcal", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/osgvxt1513595509.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1/2 oz", :strInstructionsES "Para que tu grasa de cerdo sea tan deliciosa como la suya, aquí tienes su adobo y qué hacer con él (también necesitarás un costillar):\r\n\r\n4 chiles anchos, 8 chiles guajillos y 4 chiles chipotles, más 4 dientes de ajo asado, media taza de vinagre de sidra, un cuarto de cucharadita de orégano mexicano, 1 cucharadita de pimienta negra molida, un clavo entero, un cuarto de cucharadita de canela molida y media cucharadita de comino molido.\r\n\r\nTostar los chiles secos y remojarlos en agua durante al menos una hora hasta que se rehidraten. Escurrir y desechar el líquido de remojo. Mezclar los chiles remojados con el resto de ingredientes y hacer un puré hasta que quede suave.\r\n\r\nAhumar en frío un costillar de cerdo en una sartén grande con astillas de madera en un lado y carbón en el otro. Coloca otra sartén más pequeña con costillas de cerdo encima de la sartén con carbón y virutas de madera. Encienda el carbón con cuidado de no prender las astillas. Cubra ambas cacerolas con papel de aluminio y deje que se ahumen durante 10-15 minutos, hasta conseguir el nivel de humo deseado, luego cúbralas con adobo y envuélvalas en papel de aluminio antes de meter las costillas en el horno a 300 grados durante 7 horas. Cuando las costillas se hayan enfriado, cuele la grasa y utilícela para la infusión.\r\n\r\nSi le resulta difícil conseguir el mismo volumen de grasa, compense el resto con manteca de cerdo de un carnicero. Para obtener la misma profundidad de sabor sin las costillas, calienta la grasa en una olla con unas cucharadas de la marinada.\r\n\r\nUna vez que tengas tu tarrina de grasa de cerdo sazonada en forma líquida enfriada, vierte cantidades iguales de mezcal Ilegal Joven y de grasa en un recipiente con cierre hermético. Séllelo, agítelo bien y métalo en el congelador toda la noche. Cuando todo esté separado y congelado, viértelo a través de un chino de malla fina. Si no tienes un chino, prueba con un colador de malla fina, o si no tienes uno de esos, prueba a quitar la mayor parte de la grasa con una cuchara. Quedarán algunas gotas de grasa anaranjada en el mezcal colado: pásalo por unas cuantas capas de estopilla (o filtros de café en su defecto) para deshacerte de lo que quede de ella.\r\n\r\nEl mezcal ya está listo para beber, solo o en cóctel.\r\n\r\nTintura de habanero\r\n\r\nCorta los habaneros en rodajas y añade 2 onzas de mezcal Ilegal Joven.\r\nDéjalo reposar toda la noche o hasta que alcance el nivel de picante deseado.\r\nCóctel\r\n\r\nMezcle el mezcal y el licor de chocolate en un vaso mezclador con hielo y remueva durante 45 segundos.\r\nColar en una copa fría.\r\nCon cuidado, \"hundir\" el licor de café en el interior de la copa con una cuchara.\r\nDecorar con 5 gotas de tintura de habanero.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Mezcal", :idDrink "17246", :strInstructionsZH-HANT "為了確保你的豬油和他們的一樣美味，這是他們的阿多波醃料以及如何處理它（你還需要一排排骨）：\r\n\r\n4 个安乔辣椒、8 个瓜希略辣椒和 4 个墨西哥辣椒，加上 4 瓣烤大蒜、半杯苹果醋、四分之一茶匙墨西哥牛至、一茶匙黑胡椒粉、一整瓣丁香、四分之一茶匙肉桂粉和半茶匙孜然粉。\r\n\r\n烤乾辣椒並在水中浸泡至少一個小時，直到它們重新水化。瀝乾並丟棄浸泡液。將浸泡過的辣椒與剩餘的原料混合，打成泥，直到光滑。\r\n\r\n拿一個飯店用的大平底鍋，一邊放木片，另一邊放木炭，冷燻一排小排骨。將另一個較小的裝有排骨的平底鍋放在木炭/木片平底鍋上方。點燃木炭，小心不要點燃木片。用箔纸盖住两个平底锅，熏 10-15 分钟，直到达到所需的烟雾水平，然后涂上阿斗波腌料并用锡纸包裹，然后将排骨放入 300 度的烤箱中烤 7 小时。當排骨冷卻後，濾去脂肪並用於輸液。\r\n\r\n如果你很難達到同樣數量的脂肪，可以用屠夫的豬油來補充。為了在沒有排骨的情況下獲得相同深度的味道，可以用幾匙醃料在鍋中加熱脂肪。\r\n\r\n一旦你得到一桶冷卻液體形式的調味豬肉脂肪，將等量的非法青年梅斯卡爾酒和脂肪倒入可密封的容器中。密封容器並充分搖勻，然後將其放入冰箱過夜。當整個東西分開並凝結時，將其倒入細網中國。如果您没有中国式过滤器，请尝试使用细网过滤器，或者如果您没有其中之一，请尝试用勺子舀掉大部分脂肪。过滤后的梅斯卡尔酒中会残留一些橙色脂肪珠：将其穿过几层粗棉布（必要时或咖啡过滤器）以除去最后的脂肪。\r\n\r\n梅斯卡爾酒現在可以直接飲用或調製雞尾酒了。 \r\n\r\n哈瓦那酊劑\r\n\r\n將哈瓦那辣椒切片並添加 2 盎司非法青年梅斯卡爾酒。\r\n放置過夜或直至達到所需的熱量水平。\r\n雞尾酒\r\n\r\n將梅斯卡爾酒和巧克力利口酒放入混合杯中，加入冰塊，攪拌 45 秒。\r\n濾入冰鎮的轎跑車。\r\n用湯匙小心地將咖啡利口酒「沉入」轎跑車的內部。\r\n用 5 滴哈瓦那酊劑裝飾。", :strInstructionsZH-HANS "为了确保你的猪油和他们的一样美味，这是他们的阿多波腌料以及如何处理它（你还需要一排排骨）：\r\n\r\n4 个安乔辣椒、8 个瓜希略辣椒和 4 个墨西哥辣椒，加上 4 瓣烤大蒜、半杯苹果醋、四分之一茶匙墨西哥牛至、一茶匙黑胡椒粉、一整瓣丁香、四分之一茶匙肉桂粉和半茶匙孜然粉。\r\n\r\n烤干辣椒并在水中浸泡至少一个小时，直到它们重新水化。沥干并丢弃浸泡液。将浸泡过的辣椒与剩余的原料混合，打成泥，直至光滑。\r\n\r\n拿一个酒店用的大平底锅，一侧放木片，另一侧放木炭，冷熏一排小排骨。将另一个较小的装有排骨的平底锅放在木炭/木片平底锅上方。点燃木炭，小心不要点燃木片。用箔纸盖住两个平底锅，熏 10-15 分钟，直到达到所需的烟雾水平，然后涂上阿斗波腌料并用锡纸包裹，然后将排骨放入 300 度的烤箱中烤 7 小时。当排骨冷却后，滤去脂肪并用于输液。\r\n\r\n如果你很难达到同样数量的脂肪，可以用屠夫的猪油来补充。为了在没有排骨的情况下获得同样深度的味道，可以用几勺腌料在锅中加热脂肪。\r\n\r\n一旦你得到一桶冷却液体形式的调味猪肉脂肪，将等量的非法青年梅斯卡尔酒和脂肪倒入可密封的容器中。密封容器并充分摇匀，然后将其放入冰箱过夜。当整个东西分离并凝结时，将其倒入细网中国。如果您没有中国式过滤器，请尝试使用细网过滤器，或者如果您没有其中之一，请尝试用勺子舀掉大部分脂肪。过滤后的梅斯卡尔酒中会残留一些橙色脂肪珠：将其穿过几层粗棉布（必要时或咖啡过滤器）以除去最后的脂肪。\r\n\r\n梅斯卡尔酒现在可以直接饮用或调制成鸡尾酒了。 \r\n\r\n哈瓦那酊剂\r\n\r\n将哈瓦那辣椒切片并添加 2 盎司非法青年梅斯卡尔酒。\r\n放置过夜或直至达到所需的热量水平。\r\n鸡尾酒\r\n\r\n将梅斯卡尔酒和巧克力利口酒放入混合杯中，加入冰块，搅拌 45 秒。\r\n滤入冰镇的轿跑车。\r\n用勺子小心地将咖啡利口酒“沉入”轿跑车的内部。\r\n用 5 滴哈瓦那酊剂装饰。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "\"Per assicurarti che il tuo grasso di maiale sia delizioso come il loro, ecco la loro marinata di adobo e cosa farne (ti servirà anche un carré di costolette):\r\n\r\n4 peperoncini ancho, 8 peperoncini guajillo e 4 peperoncini chipotle, più 4 spicchi d'aglio arrostiti, mezza tazza di aceto di sidro, un quarto di cucchiaino di origano messicano, 1 cucchiaino di pepe nero macinato, uno spicchio intero, un quarto di cucchiaino di cannella in polvere e mezzo cucchiaino di cumino macinato.\r\n\r\nTostare i peperoncini secchi e metterli a bagno in acqua per almeno un'ora finché non si saranno reidratati. Scolare e gettare il liquido di ammollo. Unire i peperoncini ammollati con gli ingredienti rimanenti e ridurre in purea fino a che liscio.\r\n\r\nAffumica a freddo una griglia di costolette di maiale prendendo una grande padella  con trucioli di legno da un lato e carbone dall'altro. Posizionare un'altra padella, più piccola, con le costine di maiale, sopra la teglia per carbone / trucioli. Accendi il carbone facendo attenzione a non incendiare i trucioli. Coprire entrambe le padelle con un foglio e lasciare affumicare per 10-15 minuti, fino a raggiungere il livello di fumo desiderato, quindi rivestire con la marinata di adobo e avvolgere nella carta stagnola prima di mettere le costole in un forno a 300 gradi per 7 ore. Quando le costine si saranno raffreddate, filtrate il grasso e usatelo per l'infuso.\r\n\r\nSe hai difficoltà a raggiungere lo stesso tipo di volume di grasso, compensa con lo strutto di maiale di un macellaio. Per ottenere la stessa profondità di sapore senza le costolette, scaldare il grasso in una pentola con qualche cucchiaio di marinata.\r\n\r\nUna volta che hai la tua vasca di grasso di maiale condito in forma liquida raffreddata, versa quantità uguali di mezcal e grasso in un contenitore sigillabile. Sigilla il contenitore e scuoterlo bene, quindi mettilo nel congelatore per una notte. Quando il tutto si sarà separato e solidificato, versatelo in uno chinois a maglia fine. Se non hai un chinois, prova un colino a maglia fine, o se non ne hai uno, prova a eliminare la maggior parte del grasso con un cucchiaio. Ci saranno delle gocce di grasso arancione nel mezcal filtrato: passalo attraverso alcuni strati di garza (o filtri di caffè) per sbarazzartene dell'ultimo.\r\n\r\nIl mezcal è ora pronto per essere bevuto, puro o in un cocktail.\r\n\r\nTintura di Habanero\r\n\r\nAffetta gli habaneros e aggiungi 2 once di Ilegal Joven mezcal.\r\nLasciar riposare per una notte o finché non si raggiunge il livello di calore desiderato.\r\nCocktail\r\n\r\nUnisci il mezcal e il liquore al cioccolato in un mixing glass con ghiaccio e mescola per 45 secondi.\r\nFiltrare in un bicchiere freddo.\r\nAffondare con cura il liquore al caffè all'interno del bicchiere sopra un cucchiaio.\r\nDecorare con 5 gocce di tintura di habanero.", :strMeasure2 "3/4 oz", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-12-18 11:11:49", :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Chocolate liqueur", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Beer Glass", :strInstructionsDE "Der Mezcal wird mit gewürztem Schweinefett aromatisiert (sogenanntes „fat washing“). Dadurch bekommt der Drink einen rauchig-würzigen Geschmack mit BBQ-Note.\r\n\r\nUm sicherzustellen, dass dein Schweinefett genauso köstlich ist wie das Original, hier die Adobo-Marinade und die Zubereitung (du brauchst außerdem ein Rack mit Rippchen):\r\n\r\n4 Ancho-Chilis, 8 Guajillo-Chilis und 4 Chipotle-Chilis, dazu 4 geröstete Knoblauchzehen, eine halbe Tasse Apfelessig, ¼ Teelöffel mexikanischen Oregano, 1 Teelöffel schwarzen Pfeffer, 1 ganze Gewürznelke, ¼ Teelöffel gemahlenen Zimt und ½ Teelöffel gemahlenen Kreuzkümmel.\r\n\r\nDie getrockneten Chilis rösten und mindestens eine Stunde in Wasser einweichen, bis sie weich sind. Abgießen und das Einweichwasser entsorgen. Die eingeweichten Chilis mit den restlichen Zutaten pürieren, bis eine glatte Paste entsteht.\r\n\r\nEin Rack Baby Back Ribs kalt räuchern, indem man in einer großen Metallschale auf einer Seite Holzspäne und auf der anderen Seite Holzkohle platziert. Eine kleinere Schale mit den Rippchen wird über der großen platziert. Die Holzkohle anzünden, aber die Holzspäne nicht entflammen. Beide Schalen mit Alufolie abdecken und 10–15 Minuten räuchern, bis der gewünschte Rauchgeschmack erreicht ist. Dann mit der Adobo-Marinade bestreichen, in Alufolie wickeln und im Ofen bei 150 °C für 7 Stunden garen. Nach dem Abkühlen das Fett abgießen und für die Infusion verwenden.\r\n\r\nWenn du nicht genug Fett aus den Rippchen gewinnst, kannst du Schweineschmalz vom Metzger hinzufügen. Um den gleichen Geschmack ohne Rippchen zu erreichen, erwärme das Fett mit ein paar Löffeln Marinade in einem Topf.\r\n\r\nWenn du das gewürzte Schweinefett in flüssiger, abgekühlter Form hast, gleiche Mengen Ilegal Joven Mezcal und Fett in einen verschließbaren Behälter geben. Gut schütteln und über Nacht ins Gefrierfach stellen. Sobald sich alles abgesetzt und verfestigt hat, durch ein feines Sieb (Chinoise) abgießen. Alternativ ein feines Sieb oder vorsichtig das Fett abschöpfen. Übrig gebliebene Fettperlen im Mezcal durch mehrere Lagen Käsetuch oder Kaffeefilter entfernen.\r\n\r\nDer Mezcal ist nun trinkbereit – pur oder im Cocktail.\r\n\r\nHabanero-Tinktur\r\n\r\nHabaneros in Scheiben schneiden und mit 2 Unzen Ilegal Joven Mezcal ansetzen. Über Nacht ziehen lassen oder bis die gewünschte Schärfe erreicht ist.\r\n\r\nCocktail\r\n\r\nMezcal und Schokoladenlikör mit Eis in einem Rührglas 45 Sekunden rühren.\r\nIn eine gekühlte Coupette abseihen.\r\nDen Kaffeelikör vorsichtig über einen Löffel am Glasrand „einsinken“ lassen.\r\nMit 5 Tropfen Habanero-Tinktur garnieren.", :strDrinkAlternate nil, :strIngredient3 "Coffee liqueur", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil}]}, :fetched-at 1790009882369}, "https://www.thecocktaildb.com/api/json/v1/1/search.php?f=j" {:data {:drinks [{:strIngredient4 "Sugar", :strMeasure11 nil, :strInstructionsFR "Enduire le bord d'un verre à shot de sucre en utilisant du sirop de sucre pour coller. Ajoutez la liqueur de framboise Chambord dans le verre à shot et recouvrez délicatement la Baileys Irish Cream. Servir.", :strVideo nil, :strInstructions "Coat the rim of a shot glass with sugar using sugar syrup to stick. Add the Chambord raspberry liqueur to the shot glass, and carefully layer the Baileys Irish Cream on top. Serve.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2/3 oz", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Jam Donut", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/uuytrp1474039804.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 tsp", :strInstructionsES "Cubra el borde de un vaso de chupito con azúcar usando jarabe de azúcar para que se pegue. Agregue el licor de frambuesa Chambord al vaso de chupito y con cuidado coloque una capa de crema irlandesa Baileys encima. Atender.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Baileys irish cream", :idDrink "17178", :strInstructionsZH-HANT "在小玻璃杯的邊緣塗上糖，然後用糖漿黏住。將香波覆盆子利口酒倒入玻璃杯中，小心翼翼地在上面鋪上百利甜愛爾蘭奶油。服務。", :strInstructionsZH-HANS "在小玻璃杯的边缘涂上糖，然后用糖浆粘住。将香波覆盆子利口酒倒入玻璃杯中，小心地在上面铺上百利甜爱尔兰奶油。服务。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Rivestire il bordo di un bicchierino di zucchero con lo sciroppo di zucchero per attaccare.\r\nAggiungere il liquore al lampone di Chambord nel bicchierino e sovrapporre con cura la crema irlandese Baileys.", :strMeasure2 "1/3 oz", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2016-09-16 16:30:04", :strMeasure8 nil, :strCategory "Shot", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Chambord raspberry liqueur", :strMeasure4 "2 pinches", :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Shot glass", :strInstructionsDE "Den Rand eines Schnapsglases mit Zucker und Zuckersirup bestreichen. Geben Sie den Chambord Himbeerlikör in das Schnapsglas und geben Sie die Baileys Irish Cream vorsichtig darüber. Servieren.", :strDrinkAlternate nil, :strIngredient3 "Sugar syrup", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Lime juice", :strMeasure11 nil, :strInstructionsFR "Mouiller le verre, tremper le bord dans le sucre. Ajouter ensuite de la glace. Puis ajouter tout le reste. C'est aussi simple que cela !", :strVideo nil, :strInstructions "Wet glass, dip rim in sugar. Then add Ice. Then add everything else. It's that simple!", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 jiggers ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Sugar", :strImageAttribution nil, :strDrink "Jitterbug", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/wwqvrq1441245318.jpg", :strMeasure15 nil, :strIngredient7 "Soda water", :strMeasure3 "3 dashes ", :strInstructionsES "Moje el vaso, sumerja el borde en azúcar. A continuación, añada hielo. Luego añada todo lo demás. Así de sencillo.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Gin", :idDrink "16178", :strInstructionsZH-HANT "弄濕玻璃杯，將邊緣浸入糖中。然後加入冰塊。然後添加其他所有內容。就這麼簡單！", :strInstructionsZH-HANS "弄湿玻璃杯，将边缘浸入糖中。然后加入冰块。然后添加其他所有内容。就这么简单！", :strMeasure9 nil, :strMeasure7 "Fill to top with ", :strInstructionsIT "Bagna il biicchiere, immergere il bordo nello zucchero.\r\nQuindi aggiungi ghiaccio.\r\nQuindi aggiungi tutto il resto.\r\nÈ così semplice!", :strMeasure2 "1 jigger ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-09-03 02:55:18", :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 "3 dashes ", :strMeasure14 nil, :strIngredient2 "Vodka", :strMeasure4 "1 shot ", :strMeasure5 "Around rim put 1 pinch ", :strIngredient6 "Sugar syrup", :strImageSource nil, :strIngredient8 nil, :strGlass "Cocktail Glass", :strInstructionsDE "Feuchtes Glas, Tauchrand in Zucker. Dann fügen Sie Eis hinzu. Dann füge alles andere hinzu. So einfach ist das!", :strDrinkAlternate nil, :strIngredient3 "Grenadine", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Servir sur de la glace - Attention, mortel !", :strVideo nil, :strInstructions "Serve over ice- Warning,Deadly!", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Jackhammer", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/9von5j1504388896.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 nil, :strInstructionsES "Servir sobre hielo. ¡Advertencia, mortal!", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Jack Daniels", :idDrink "13847", :strInstructionsZH-HANT "加冰食用－警告，致命！", :strInstructionsZH-HANS "加冰食用——警告，致命！", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Servire con ghiaccio - Attenzione, mortale!", :strMeasure2 "1 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-02 22:48:16", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Amaretto", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Collins Glass", :strInstructionsDE "Servieren Sie über Eis. Warnung, tödlich!", :strDrinkAlternate nil, :strIngredient3 nil, :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "mélanger à parts égales dans un verre pony – ça a le goût d'un bonbon à la gelée !", :strVideo nil, :strInstructions "mix equal parts in pony glass-tastes just like a jelly bean!", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Jelly Bean", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/bglc6y1504388797.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 nil, :strInstructionsES "mezcle partes iguales en un vaso de pony; ¡sabe como una gominola!", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Blackberry brandy", :idDrink "13775", :strInstructionsZH-HANT "在小馬杯中混合等份，味道就像軟糖一樣！", :strInstructionsZH-HANS "在小马杯中混合等份，味道就像软糖一样！", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Mescola parti uguali in un bicchiere, gusta proprio come una gelatina!", :strMeasure2 "1 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-02 22:46:37", :strMeasure8 nil, :strCategory "Shot", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Anis", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Cordial glass", :strInstructionsDE "zu gleichen Teilen in Ponyglas mischen - schmeckt wie eine Jelly Bean!", :strDrinkAlternate nil, :strIngredient3 nil, :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Faites bouillir 3 tasses d'eau puis ajoutez la gelée. Mélangez la gelée et l'eau jusqu'à ce que la gelée soit complètement dissoute. Ajoutez les deux tasses de vodka et mélangez. Verser le mélange dans des verres à shot en plastique et réfrigérer jusqu'à ce qu'il soit ferme. Ensuite, rongez...", :strVideo nil, :strInstructions "Boil 3 cups of water then add jello. Mix jello and water until jello is completely disolved. Add the two cups of vodka and mix together. Pour mixture into plastic shot glasses and chill until firm. Then, eat away...", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 cups ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Jello shots", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/l0smzo1504884904.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "3 cups ", :strInstructionsES "Hervir 3 tazas de agua y luego agregar gelatina. Mezcla la gelatina y el agua hasta que la gelatina se disuelva por completo. Agrega las dos tazas de vodka y mezcla. Vierta la mezcla en vasos de plástico y enfríe hasta que esté firme. Luego, come...", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Vodka", :idDrink "14956", :strInstructionsZH-HANT "煮沸 3 杯水，然後加入果凍。將果凍和水混合直至果凍完全溶解。加入兩杯伏特加並混合在一起。將混合物倒入塑膠玻璃杯中並冷卻直至變硬。然後，吃掉...", :strInstructionsZH-HANS "煮沸 3 杯水，然后加入果冻。将果冻和水混合直至果冻完全溶解。添加两杯伏特加并混合在一起。将混合物倒入塑料玻璃杯中并冷却直至变硬。然后，吃掉...", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Fai bollire 3 tazze d'acqua e aggiungi la gelatina.\r\nMescolare la gelatina e l'acqua fino a quando la gelatina è completamente sciolta.\r\nAggiungere le due tazze di vodka e mescolale.\r\nVersare il composto in bicchierini di plastica e raffreddare fino a quando non si rassoda.", :strMeasure2 "3 packages ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-08 16:35:04", :strMeasure8 nil, :strCategory "Shot", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Jello", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Shot glass", :strInstructionsDE "Kochen Sie 3 Tassen Wasser und fügen Sie dann Jello hinzu. Jello und Wasser mischen, bis Jello vollständig aufgelöst ist. Fügen Sie die beiden Tassen Wodka hinzu und mischen Sie sie zusammen. Die Mischung in Kunststoff-Schnapsgläser füllen und kühl stellen. Dann iss es weg.....", :strDrinkAlternate nil, :strIngredient3 "Water", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Milk", :strMeasure11 nil, :strInstructionsFR "Remplissez un verre de glaçons. Ajoutez un shot de Tia Maria et un shot de rhum léger jamaïcain. Remplissez le verre de lait. Mélanger jusqu'à consistance lisse et servir immédiatement.", :strVideo nil, :strInstructions "Fill a tumbler with ice cubes. Add a shot of Tia Maria and a shot of Jamaican light rum. Fill the tumbler with milk. Blend until smooth and serve immediately.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 shot ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Jamaica Kiss", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/urpvvv1441249549.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "cubes", :strInstructionsES "Llena un vaso con cubitos de hielo. Agregue un trago de Tía María y un trago de ron ligero jamaicano. Llena el vaso con leche. Licue hasta que quede suave y sirva inmediatamente.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Coffee liqueur", :idDrink "14095", :strInstructionsZH-HANT "將玻璃杯裝滿冰塊。加入一杯蒂亞瑪麗亞和一杯牙買加淡朗姆酒。將玻璃杯裝滿牛奶。攪拌至光滑並立即食用。", :strInstructionsZH-HANS "将玻璃杯装满冰块。添加一杯蒂亚玛丽亚和一杯牙买加淡朗姆酒。将玻璃杯装满牛奶。搅拌至光滑并立即食用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Riempi un bicchiere con cubetti di ghiaccio.\r\nAggiungi un bicchierino di Tia Maria e un bicchierino di rum chiaro giamaicano.\r\nRiempi il bicchiere di latte.\r\nFrulla fino a ottenere un composto omogeneo e servi immediatamente.", :strMeasure2 "1 shot Jamaican ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-09-03 04:05:49", :strMeasure8 nil, :strCategory "Shake", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Light rum", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Hurricane glass", :strInstructionsDE "Füllen Sie einen Becher mit Eiswürfeln. Füge einen Schuss Tia Maria und einen Schuss jamaikanischen leichten Rum hinzu. Füllen Sie den Becher mit Milch. Mischen, bis sie glatt sind und sofort servieren.", :strDrinkAlternate nil, :strIngredient3 "Ice", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Club soda", :strMeasure11 nil, :strInstructionsFR "Verser tous les ingrédients directement dans un verre à cocktail rempli de glace. Remuer doucement. Décorer. Ajouter un trait d'Angostura bitters.", :strVideo nil, :strInstructions "Pour all ingredients directly into highball glass filled with ice. Stir gently. Garnish. Add a dash of Angostura bitters.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "IBA", :strMeasure1 "2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Maraschino cherry", :strImageAttribution "Michael Styne https://www.flickr.com/people/76148228@N00", :strDrink "John Collins", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/0t4bv71606854479.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 tsp superfine ", :strInstructionsES "Vierta todos los ingredientes directamente en un vaso highball lleno de hielo. Remover suavemente. Decorar. Añada un chorrito de amargo de Angostura.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Bourbon", :idDrink "11580", :strInstructionsZH-HANT "將所有原料直接倒入裝滿冰塊的高球杯中。輕輕攪拌。裝飾。加入少許安古斯圖拉苦精。", :strInstructionsZH-HANS "将所有原料直接倒入装满冰块的高球杯中。轻轻搅拌。装饰。添加少许安古斯图拉苦精。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Versare tutti gli ingredienti direttamente nel bicchiere highball pieno di ghiaccio.Aggiungi un pizzico di Angostura bitter.Mescola delicatamente.", :strMeasure2 "1 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-02 12:04:31", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 "1 ", :strMeasure14 nil, :strIngredient2 "Lemon juice", :strMeasure4 "3 oz ", :strMeasure5 "1 ", :strIngredient6 "Orange", :strImageSource "https://commons.wikimedia.org/wiki/File:IBA_Cocktail_John_Collins_(29221732881).jpg", :strIngredient8 nil, :strGlass "Collins glass", :strInstructionsDE "Alle Zutaten direkt in ein mit Eis gefülltes Highball-Glas gießen. Vorsichtig umrühren. Garnieren. Füge einen Schuss Angostura-Bitter hinzu.", :strDrinkAlternate nil, :strIngredient3 "Sugar", :strCreativeCommonsConfirmed "Yes", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Port", :strMeasure11 nil, :strInstructionsFR "Secouer tous les ingrédients (sauf l'eau gazeuse) avec de la glace et filtrer dans un verre highball sur deux glaçons. Remplir d'eau gazeuse, remuer et servir.", :strVideo nil, :strInstructions "Shake all ingredients (except carbonated water) with ice and strain into a highball glass over two ice cubes. Fill with carbonated water, stir, and serve.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 1/2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Egg white", :strImageAttribution nil, :strDrink "Japanese Fizz", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/37vzv11504884831.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 tsp ", :strInstructionsES "Agitar todos los ingredientes (excepto el agua carbonatada) con hielo y colar en un vaso highball sobre dos cubitos de hielo. Rellenar con agua carbonatada, remover y servir.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Blended whiskey", :idDrink "11558", :strInstructionsZH-HANT "將所有原料（碳酸水除外）加冰搖勻，濾入盛有兩塊冰塊的高球杯中。加入碳酸水，攪拌，即可食用。", :strInstructionsZH-HANS "将所有原料（碳酸水除外）加冰摇匀，滤入盛有两块冰块的高球杯中。加入碳酸水，搅拌，即可食用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Shakerare tutti gli ingredienti (eccetto l'acqua gassata) con ghiaccio e filtrare in un bicchiere highball su due cubetti di ghiaccio. Riempi con acqua gassata, mescola e servi.", :strMeasure2 "Juice of 1/2 ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-08 16:33:51", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Lemon", :strMeasure4 "1 tblsp", :strMeasure5 "1 ", :strIngredient6 "Carbonated water", :strImageSource nil, :strIngredient8 nil, :strGlass "Highball glass", :strInstructionsDE "Alle Zutaten (außer kohlensäurehaltigem Wasser) mit Eis schütteln und über zwei Eiswürfel in ein Highball-Glas abseihen. Mit kohlensäurehaltigem Wasser auffüllen, umrühren und servieren.", :strDrinkAlternate nil, :strIngredient3 "Powdered sugar", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Whipped cream", :strMeasure11 nil, :strInstructionsFR "Mélangez le rhum, le café et l’eau. Garnir de crème fouettée. Saupoudrer d'une pincée de café bien moulu et boire avec une paille.", :strVideo nil, :strInstructions "Stir the rum, coffee and water together. Top with the whipped cream. Sprinkle with a pinch of well ground coffee and drink with a straw.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1/6 glass ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Jamaican Coffee", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/xqptps1441247257.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1/2 glass cold ", :strInstructionsES "Mezcle el ron, el café y el agua. Cubra con la crema batida. Espolvorea con una pizca de café bien molido y bebe con una pajita.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Rum", :idDrink "15825", :strInstructionsZH-HANT "將蘭姆酒、咖啡和水攪拌在一起。上面放上生奶油。撒上少許磨碎的咖啡，然後用吸管飲用。", :strInstructionsZH-HANS "将朗姆酒、咖啡和水搅拌在一起。上面放上生奶油。撒上少许磨碎的咖啡，然后用吸管饮用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Mescola rum, caffè e acqua insieme.\r\nCompletare con la panna montata.\r\nCospargere con un pizzico di caffè ben macinato e bere con una cannuccia.", :strMeasure2 "1/6 glass strong black ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-09-03 03:27:37", :strMeasure8 nil, :strCategory "Coffee / Tea", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Coffee", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Champagne flute", :strInstructionsDE "Rum, Kaffee und Wasser miteinander verrühren. Mit der geschlagenen Sahne bedecken. Mit einer Prise gut gemahlenem Kaffee bestreuen und mit einem Strohhalm trinken.", :strDrinkAlternate nil, :strIngredient3 "Water", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Mettre tous les ingrédients dans le bol du mixeur - couvrir et fouetter à vitesse moyenne jusqu'à obtention d'un mélange homogène. Verser dans un grand verre, 2 verres moyens ou 3 petits verres et boire.", :strVideo nil, :strInstructions "Place all ingredients in the blender jar - cover and whiz on medium speed until well blended. Pour in one tall, 2 medium or 3 small glasses and drink up.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 cups ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Just a Moonmint", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/znald61487604035.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 nil, :strInstructionsES "Ponga todos los ingredientes en la jarra de la batidora, tápela y bátala a velocidad media hasta que estén bien mezclados. Verter en un vaso alto, 2 medianos o 3 pequeños y beber.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Milk", :idDrink "12688", :strInstructionsZH-HANT "將所有原料放入攪拌杯中 - 蓋上蓋子並以中速攪拌至充分混合。倒入 1 個高杯、2 個中盃或 3 個小杯，然後喝完。", :strInstructionsZH-HANS "将所有原料放入搅拌杯中 - 盖上盖子并以中速搅拌直至充分混合。倒入 1 个高杯、2 个中杯或 3 个小杯，然后喝完。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Mettere tutti gli ingredienti nella caraffa del frullatore - coprire e montare a velocità media fino a quando non sono ben amalgamati.Versare in un bicchiere alto, 2 medi o 3 piccoli e bere.", :strMeasure2 nil, :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-02-20 15:20:36", :strMeasure8 nil, :strCategory "Shake", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Chocolate syrup", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Highball Glass", :strInstructionsDE "Alle Zutaten in den Mixer geben - abdecken und bei mittlerer Geschwindigkeit schaumig schlagen, bis sie gut vermischt sind. In ein großes, 2 mittlere oder 3 kleine Gläser füllen und geniessen.", :strDrinkAlternate nil, :strIngredient3 "Mint syrup", :strCreativeCommonsConfirmed "No", :strAlcoholic "Non alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Dans un verre à mélange à moitié rempli de glaçons, mélanger tous les ingrédients. Bien mélanger. Filtrer dans un verre à cocktail.", :strVideo nil, :strInstructions "In a mixing glass half-filled with ice cubes, combine all of the ingredients. Stir well. Strain into a cocktail glass.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 1/2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Jewel Of The Nile", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/hx4nrb1504884947.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1/2 oz ", :strInstructionsES "En un vaso mezclador lleno hasta la mitad con cubitos de hielo, mezcle todos los ingredientes. Remover bien. Colar en una copa de cóctel.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Gin", :idDrink "11566", :strInstructionsZH-HANT "在裝有半杯冰塊的攪拌杯中，混合所有食材。攪拌均勻。濾入雞尾酒杯。", :strInstructionsZH-HANS "在装有半杯冰块的搅拌杯中，混合所有成分。搅拌均匀。滤入鸡尾酒杯。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "In un mixing glass riempito a metà con cubetti di ghiaccio, unire tutti gli ingredienti. Filtrare in un bicchiere da cocktail. Mescolare bene.", :strMeasure2 "1/2 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-08 16:35:48", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Green Chartreuse", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "In einem Mischglas, das halb mit Eiswürfeln gefüllt ist, alle Zutaten vermengen. Gut umrühren. In ein Cocktailglas abseihen.", :strDrinkAlternate nil, :strIngredient3 "Yellow Chartreuse", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Secouer tous les ingrédients avec de la glace, filtrer dans un verre à cocktail et servir.", :strVideo nil, :strInstructions "Shake all ingredients with ice, strain into a cocktail glass, and serve.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "Beach", :strMeasure1 "1 1/2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Jack Rose Cocktail", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/uuqqrv1439907068.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "Juice of 1/2 ", :strInstructionsES "Agitar todos los ingredientes con hielo, colar en una copa de cóctel y servir.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Apple brandy", :idDrink "11542", :strInstructionsZH-HANT "將所有材料加冰搖勻，濾入雞尾酒杯中即可享用。", :strInstructionsZH-HANS "将所有原料加冰摇匀​​，滤入鸡尾酒杯中即可享用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Shakerare tutti gli ingredienti con ghiaccio, filtrare in una coppetta da cocktail e servire.", :strMeasure2 "1 tsp ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-08-18 15:11:08", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Grenadine", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "Alle Zutaten mit Eis schütteln, in ein Cocktailglas abseihen und servieren.", :strDrinkAlternate nil, :strIngredient3 "Lime", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Coca-Cola", :strMeasure11 nil, :strInstructionsFR "Après avoir versé les ingrédients et ajouté 3 à 5 glaçons, selon votre goût. Remuez la boisson à l'aide d'un agitateur pour enlever la vanille du fond.", :strVideo nil, :strInstructions "After pouring in your ingredients, and adding 3-5 ice cubes, according to taste. Stir the drink with a stirrer to get the Vanilla off the bottom.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "4-5 ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Jack's Vanilla Coke", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/kjnt7z1504793319.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 tsp ", :strInstructionsES "Después de verter los ingredientes y añadir de 3 a 5 cubitos de hielo, según el gusto. Remueve la bebida con un agitador para que la vainilla se despegue del fondo.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Ice", :idDrink "16275", :strInstructionsZH-HANT "倒入材料後，依口味添加3-5塊冰塊。用攪拌器攪拌飲料，去除底部的香草味。", :strInstructionsZH-HANS "倒入材料后，根据口味添加3-5块冰块。用搅拌器搅拌饮料，去除底部的香草味。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Dopo aver versato gli ingredienti e aver aggiunto 3-5 cubetti di ghiaccio, a piacere.\r\nMescola la bevanda con un agitatore per eliminare la vaniglia dal fondo.", :strMeasure2 "2 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-07 15:08:39", :strMeasure8 nil, :strCategory "Other / Unknown", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Tennessee whiskey", :strMeasure4 "10-12 oz ", :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Old-fashioned glass", :strInstructionsDE "Nach dem Einfüllen der Zutaten und dem Hinzufügen von 3-5 Eiswürfeln je nach Geschmack, rühren Sie das Getränk mit einem Rührer um, um die Vanille vom Boden zu lösen.", :strDrinkAlternate nil, :strIngredient3 "Vanilla extract", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil}]}, :fetched-at 1790009882369}, "https://www.thecocktaildb.com/api/json/v1/1/search.php?f=l" {:data {:drinks [{:strIngredient4 "Lime peel", :strMeasure11 nil, :strInstructionsFR "Dans un grand verre, verser le jus de citron vert et le sucre, et bien mélanger. Ajoutez de l'eau de Seltz froide pour remplir le verre. Mettez les écorces de citron vert dans le verre. Buvez. Répétez l'opération jusqu'à ce qu'il n'y ait plus de citron vert ou de soda.", :strVideo nil, :strInstructions "In a large glass, put the lime juice and sugar, and stir well. Add cold seltzer water to fill. Put the lime peels in the glass. Drink. Repeat until limes or soda run out.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "Juice of 1 ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Limeade", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/5jdp5r1487603680.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 " (seltzer water)\n", :strInstructionsES "En un vaso grande, ponga el zumo de lima y el azúcar, y remueva bien. Añada agua de Seltz fría hasta llenar. Ponga las cáscaras de lima en el vaso. Beber. Repite la operación hasta que se acaben las cáscaras de lima o el agua de seltz.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Lime", :idDrink "12704", :strInstructionsZH-HANT "在一個大玻璃杯中，放入酸橙汁和糖，攪拌均勻。加入冷蘇打水以填充。將檸檬皮放入玻璃杯中。喝。重複此操作，直到酸橙或蘇打水用完。", :strInstructionsZH-HANS "在一个大玻璃杯中，放入酸橙汁和糖，搅拌均匀。添加冷苏打水以填充。将柠檬皮放入玻璃杯中。喝。重复此操作，直到酸橙或苏打水用完。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "In un bicchiere grande mettere il succo di lime e lo zucchero e mescolare bene. Aggiungere acqua fredda di seltz per riempire. Ripeti finché i lime o la soda non si esauriscono. Mettere le bucce di lime nel bicchiere.", :strMeasure2 "1 tblsp ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-02-20 15:14:40", :strMeasure8 nil, :strCategory "Other / Unknown", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Sugar", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Highball glass", :strInstructionsDE "In einem großen Glas Limettensaft und Zucker anrühren. Füge kaltes Selterswasser zum Befüllen hinzu. Die Limettenschalen in das Glas geben. Trink. Wiederholen Sie dies, bis Limetten oder Soda aufgebraucht sind.", :strDrinkAlternate nil, :strIngredient3 "Soda water", :strCreativeCommonsConfirmed "No", :strAlcoholic "Non alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Remplissez un verre d’une pinte presque plein de bière. Remplissez ensuite le reste avec du jus d'orange (attention à ne pas le remplir jusqu'en haut). Ensuite, prenez la photo d'Amaretto et déposez-la.", :strVideo nil, :strInstructions "Fill a pint glass almost full with beer. Then fill the rest with orange juice (careful not to fill it to the top). Then take the shot of Amaretto and drop it in.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "3/4 bottle ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Lunch Box", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/qywpvt1454512546.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 oz ", :strInstructionsES "Llene un vaso de pinta casi lleno con cerveza. Luego rellena el resto con zumo de naranja (con cuidado de no llenarlo hasta arriba). Luego toma la foto de Amaretto y colócala.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Beer", :idDrink "14378", :strInstructionsZH-HANT "將一品脫玻璃杯裝滿啤酒。然後將剩餘的橙汁填滿（注意不要填滿）。然後喝一杯苦杏酒並把它放進去。", :strInstructionsZH-HANS "将一品脱玻璃杯装满啤酒。然后将剩余的橙汁填满（注意不要填满）。然后喝一杯苦杏酒并把它放进去。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Riempi un bicchiere da mezzo litro quasi pieno di birra.\r\nQuindi riempire il resto con succo d'arancia (attenzione a non riempirlo fino in cima).\r\nIn un bicchiere da shot versaci l'Amaretto, infine versare lo shot sul mix fatto in precedenza.", :strMeasure2 "1 shot ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2016-02-03 15:15:46", :strMeasure8 nil, :strCategory "Beer", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Amaretto", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Pint glass", :strInstructionsDE "Füllen Sie ein Pintglas fast voll mit Bier. Dann den Rest mit Orangensaft füllen (darauf achten, ihn nicht nach oben zu füllen). Dann nimm den Schuss Amaretto und lass ihn rein.", :strDrinkAlternate nil, :strIngredient3 "Orange juice", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Secouer et filtrer dans un verre à cocktail réfrigéré, bordé de sucre.", :strVideo nil, :strInstructions "Shake and strain into a chilled cocktail glass rimmed with sugar.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "IBA,NewEra", :strMeasure1 "1 1/2 shot ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Lemon Drop", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/mtpxgk1504373297.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "Juice of 1 wedge ", :strInstructionsES "Agitar y colar en una copa de cóctel fría con borde de azúcar.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Vodka", :idDrink "14366", :strInstructionsZH-HANT "搖勻後濾入鑲有糖的冰鎮雞尾酒杯中。", :strInstructionsZH-HANS "摇匀并滤入镶有糖的冰镇鸡尾酒杯中。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Shakerare e filtrare in un bicchiere da cocktail ghiacciato bordato di zucchero.", :strMeasure2 "1 1/2 shot ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-02 18:28:17", :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Cointreau", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "Schütteln und abseihen in ein gekühltes Cocktailglas mit Zuckerrand.", :strDrinkAlternate nil, :strIngredient3 "Lemon", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Sugar", :strMeasure11 nil, :strInstructionsFR "Mélangez Galliano et Absolut Citron dans un verre à shot, déposez un quartier de citron saupoudré de sucre sur le verre et versez un rhum sur le quartier et le verre. allumez le rhum avec un briquet et laissez brûler une seconde. Tirez vite et sucez du citron. Si cela est fait correctement, cela aura le goût d’un shot de limonade sucrée.", :strVideo nil, :strInstructions "Mix Galliano and Absolut Citron in a shot glass, lay lemon wedge sprinkled with sugar over glass and pour a rum over wedge and glass. light rum with a lighter and let burn for a second. Do shot quickly and suck on lemon. If it is done correctly, this will taste like a shot of sweet lemonade.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1/2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "151 proof rum", :strImageAttribution nil, :strDrink "Lemon Shot", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/mx31hv1487602979.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 " wedge\n", :strInstructionsES "Mezcle Galliano y Absolut Citron en un vaso de chupito, coloque una rodaja de limón espolvoreada con azúcar sobre el vaso y vierta ron sobre la rodaja y el vaso. Enciende el ron con un encendedor y deja quemar por un segundo. Dispara rápido y chupa limón. Si se hace correctamente, sabrá a un trago de limonada dulce.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Galliano", :idDrink "12752", :strInstructionsZH-HANT "將加利亞諾 (Galliano) 和絕對香櫞 (Absolut Citron) 放入小酒杯中混合，將撒有糖的檸檬塊放在玻璃杯上，然後將蘭姆酒倒在檸檬塊和玻璃杯上。用打火機點燃朗姆酒並燃燒一秒鐘。一定要快速射擊並吮吸檸檬。如果做得正確，嘗起來就像一杯甜檸檬水。", :strInstructionsZH-HANS "将加利亚诺 (Galliano) 和绝对香橼 (Absolut Citron) 放入小酒杯中混合，将撒有糖的柠檬块放在玻璃杯上，然后将朗姆酒倒在柠檬块和玻璃杯上。用打火机点燃朗姆酒并燃烧一秒钟。一定要快速射击并吮吸柠檬。如果做得正确，尝起来就像一杯甜柠檬水。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Unisci la vodka e il succo di limone in un bicchierino. Cospargere sopra 1/2 cucchiaino di zucchero. Mettere 2 cucchiaini di zucchero in un piattino; immergere gli spicchi di limone nello zucchero. Succhia un limone zuccherato dopo aver bevuto lo shot.", :strMeasure2 "1/2 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-02-20 15:02:59", :strMeasure8 nil, :strCategory "Shot", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Absolut Citron", :strMeasure4 "Bacardi ", :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Shot glass", :strInstructionsDE "Galliano und Absolut Citron in einem Schnapsglas mischen, Zitronenkeil mit Zucker bestreut über Glas legen und Rum über Keil und Glas gießen. Light Rum mit einem Feuerzeug für eine Sekunde brennen lassen. Trinken Sie schnell und saugen Sie an der Zitrone. Wenn es richtig gemacht wird, schmeckt es wie ein Schuss süße Limonade.", :strDrinkAlternate nil, :strIngredient3 "Lemon", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Tonic water", :strMeasure11 nil, :strInstructionsFR "Secouez un grand verre avec des glaçons et de l'Angostura, en recouvrant l'intérieur du verre. Versez-y la vodka, ajoutez une tranche de citron vert et pressez le jus restant, mélangez avec le tonic, remuez et vous obtenez une Long Vodka.", :strVideo nil, :strInstructions "Shake a tall glass with ice cubes and Angostura, coating the inside of the glass. Por the vodka onto this, add 1 slice of lime and squeeze juice out of remainder, mix with tonic, stir and voila you have a Long Vodka", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "5 cl ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Ice", :strImageAttribution nil, :strDrink "Long vodka", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/9179i01503565212.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "4 dashes ", :strInstructionsES "Agite un vaso alto con cubitos de hielo y Angostura, cubriendo el interior del vaso. Vierta el vodka, añada una rodaja de lima y exprima el zumo restante, mezcle con la tónica, remueva y ya tiene un Long Vodka.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Vodka", :idDrink "13196", :strInstructionsZH-HANT "用冰塊和安古斯圖拉搖勻高腳玻璃杯，使玻璃杯內部覆蓋一層冰塊。將伏特加倒在上面，加入 1 片酸橙，擠出剩餘的汁液，與滋補品混合，攪拌，瞧，你就有了一杯長伏特加", :strInstructionsZH-HANS "用冰块和安古斯图拉摇匀高脚玻璃杯，使玻璃杯内部覆盖一层冰块。将伏特加倒在上面，加入 1 片酸橙，挤出剩余的汁液，与滋补品混合，搅拌，瞧，你就有了一杯长伏特加", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Agitare un bicchiere alto con cubetti di ghiaccio e angostura, ricoprendo l'interno del bicchiere.\r\nVersare la vodka su questo, aggiungere 1 fetta di lime e spremere il succo dal resto, mescolare con il tonico, mescolare e voilà hai una Long Vodka", :strMeasure2 "1/2 ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-08-24 10:00:12", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Lime", :strMeasure4 "1 dl Schweppes ", :strMeasure5 "4 ", :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Highball glass", :strInstructionsDE "Schütteln Sie ein hohes Glas mit Eiswürfeln und Angostura und beschichten Sie so die Innenseite des Glases. Den Wodka darüber gießen, 1 Scheibe Limette hinzufügen und den Saft aus dem Rest herausquetschen, mit Tonic mischen, umrühren und voila, Sie haben einen langen Wodka.", :strDrinkAlternate nil, :strIngredient3 "Angostura bitters", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Asafoetida", :strMeasure11 nil, :strInstructionsFR "Mixer (frappe) au blender jusqu'à obtention d'une mousse. Ajouter les feuilles de curry déchirées et servir froid.", :strVideo nil, :strInstructions "Blend (frappe) in blender until frothy. Add torn curry leaves and serve cold.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 cup ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Lassi Khara", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/m1suzm1487603970.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 tsp ", :strInstructionsES "Mezclar (frappe) en la batidora hasta que esté espumoso. Añada las hojas de curry arrancadas y sírvalo frío.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Yoghurt", :idDrink "12692", :strInstructionsZH-HANT "在攪拌機中攪拌（冰沙）直到起泡。加入撕碎的咖哩葉，冷食。", :strInstructionsZH-HANS "在搅拌机中搅拌（冰沙）直至起泡。加入撕碎的咖喱叶，冷食。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Frullare (frappe) nel frullatore fino a ottenere un composto spumoso.Aggiungere le foglie di curry strappate e servire freddo.", :strMeasure2 "2 cups cold ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-02-20 15:19:30", :strMeasure8 nil, :strCategory "Other / Unknown", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Water", :strMeasure4 "1 pinch ", :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Highball Glass", :strInstructionsDE "Im Mixer zu einem schaumigen Ganzen verrühren (Frappe). Zerrissene Curryblätter hinzufügen und kalt servieren.", :strDrinkAlternate nil, :strIngredient3 "Salt", :strCreativeCommonsConfirmed "No", :strAlcoholic "Non alcoholic", :strIngredient14 nil} {:strIngredient4 "Lime", :strMeasure11 nil, :strInstructionsFR "Mixer le yaourt et les glaçons jusqu'à ce que le yaourt devienne plus liquide. Ajoutez du sucre selon votre goût. Le citron/citron vert est facultatif, mais il donne un goût légèrement acidulé. Ajouter une pincée de sel. Le raïta est également idéal pour l'été. Au lieu d'une salade traditionnelle, vous pouvez préparer un raïta.", :strVideo nil, :strInstructions "Blend the yoghurt and ice cubes together, until the yoghurt becomes more liquid. Add sugar to taste. The lemon/lime is optional but it gives it a slightly tart taste. Dash of salt. Raita is also good for the summer. Instead of having a traditional salad you can make raita instead.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 cups ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Salt", :strImageAttribution nil, :strDrink "Lassi Raita", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/s4x0qj1487603933.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 nil, :strInstructionsES "Mezclar el yogur y los cubitos de hielo, hasta que el yogur se vuelva más líquido. Añadir azúcar al gusto. El limón es opcional, pero le da un sabor ligeramente ácido. Una pizca de sal. La raita también es buena para el verano. En lugar de una ensalada tradicional, se puede preparar raita.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Yoghurt", :idDrink "12694", :strInstructionsZH-HANT "將優格和冰塊混合在一起，直到優格變得更加流動。加糖調味。檸檬/酸橙是可選的，但它會給它帶來輕微的酸味。少許鹽。 Raita 也很適合夏天。您可以製作raita，而不是傳統的沙拉。", :strInstructionsZH-HANS "将酸奶和冰块混合在一起，直到酸奶变得更加流动。加糖调味。柠檬/酸橙是可选的，但它会给它带来轻微的酸味。少许盐。 Raita 也很适合夏天。您可以制作raita，而不是传统的沙拉。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Frullate insieme lo yogurt e i cubetti di ghiaccio, finché lo yogurt non diventa più liquido. Aggiungere lo zucchero a piacere. Il limone / lime è facoltativo ma gli conferisce un sapore leggermente aspro. Pizzico di sale.Invece di avere un'insalata tradizionale puoi invece preparare la raita. Raita va bene anche per l'estate. ", :strMeasure2 "4-6 ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-02-20 15:18:53", :strMeasure8 nil, :strCategory "Other / Unknown", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Ice", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Highball Glass", :strInstructionsDE "Joghurt und Eiswürfel zusammen mischen, bis der Joghurt flüssiger wird. Nach Belieben Zucker hinzufügen. Die Zitrone / Limette ist optional, verleiht ihr aber einen leicht herberen Geschmack. Eine Prise Salz. Raita ist auch gut für den Sommer. Anstatt einen traditionellen Salat zu essen, können Sie stattdessen Raita machen.", :strDrinkAlternate nil, :strIngredient3 "Sugar", :strCreativeCommonsConfirmed "No", :strAlcoholic "Non alcoholic", :strIngredient14 nil} {:strIngredient4 "Sugar", :strMeasure11 nil, :strInstructionsFR "Extraire le jus des citrons. Éplucher et râper le gingembre. Placez le gingembre râpé et une bonne pincée de poivre de Cayenne dans un morceau d'étamine et faites un nœud. Laisser tremper dans l'eau. Au bout de 15 minutes environ, ajouter le sucre et le jus de citron. Réfrigérer et servir.", :strVideo nil, :strInstructions "Juice the lemons. Peel and grate the ginger. Place the grated ginger and a liberal dash of the cayenne pepper into a piece of cheesecloth, and tie it into a knot. Let soak in the water. After 15 minutes or so, add the sugar, and the lemon juice. Chill, and serve.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 pieces ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Cayenne pepper", :strImageAttribution nil, :strDrink "Lemouroudji", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/eirmo71487603745.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 lb ", :strInstructionsES "Exprimir los limones. Pelar y rallar el jengibre. Coloca el jengibre rallado y una pizca de pimienta de cayena en un trozo de estopilla y haz un nudo. Déjalo en remojo en el agua. Pasados unos 15 minutos, añada el azúcar y el zumo de limón. Enfríe y sirva.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Ginger", :idDrink "12702", :strInstructionsZH-HANT "將檸檬榨汁。將生薑去皮並磨碎。將磨碎的生薑和適量的辣椒放入一塊粗棉布中，然後打一個結。讓我們浸泡在水中。大約15分鐘後，加入糖和檸檬汁。冷靜一下，然後上菜。", :strInstructionsZH-HANS "将柠檬榨汁。将生姜去皮并磨碎。将磨碎的生姜和适量的辣椒放入一块粗棉布中，然后打一个结。让我们浸泡在水中。大约15分钟后，加入糖和柠檬汁。冷静一下，然后上菜。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Mettere lo zenzero grattugiato spolverato di pepe di Caienna in un pezzo di garza, annodalo e lascia che lo zenzero e il pepe di Caienna infondano l'acqua in modo che l'acqua assuma sapore (circa 15 minuti).\r\nAggiungere lo zucchero e il succo di limone e mescolare bene.\r\nRaffredda e servi freddo. (Puoi lasciare fuori il pepe di Caienna se lo desideri). Metti in frigo, aggiusta lo zucchero se necessario e servi.", :strMeasure2 "1 gal ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-02-20 15:15:45", :strMeasure8 nil, :strCategory "Other / Unknown", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Water", :strMeasure4 "1 cup ", :strMeasure5 "ground ", :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Highball Glass", :strInstructionsDE "Die Zitronen entsaften. Den Ingwer schälen und raspeln. Den geriebenen Ingwer und einen kräftigen Spritzer Cayennepfeffer in ein Stück Seihtuch geben und zu einem Knoten binden. Im Wasser einweichen lassen. Nach etwa 15 Minuten den Zucker und den Zitronensaft hinzufügen. Abkühlen lassen und servieren.", :strDrinkAlternate nil, :strIngredient3 "Lemon", :strCreativeCommonsConfirmed "No", :strAlcoholic "Non alcoholic", :strIngredient14 nil} {:strIngredient4 "Lemon peel", :strMeasure11 nil, :strInstructionsFR "Dans un verre à mélange à moitié rempli de glaçons, mélanger le Scotch, le Drambuie et le vermouth. Bien mélanger. Filtrer dans un verre à cocktail. Décorer avec le zeste de citron.", :strVideo nil, :strInstructions "In a mixing glass half-filled with ice cubes, combine the Scotch, Drambuie, and vermouth. Stir well. Strain into a cocktail glass. Garnish with the lemon twist.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Loch Lomond", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/rpvtpr1468923881.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1/2 oz ", :strInstructionsES "En un vaso mezclador lleno hasta la mitad con cubitos de hielo, mezcle el whisky, el Drambuie y el vermut. Remover bien. Colar en una copa de cóctel. Decorar con el twist de limón.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Scotch", :idDrink "11658", :strInstructionsZH-HANT "在裝有半杯冰塊的調酒杯中，將蘇格蘭威士忌、烈酒和苦艾酒混合。攪拌均勻。濾入雞尾酒杯。用檸檬片裝飾。", :strInstructionsZH-HANS "在装有半杯冰块的调酒杯中，将苏格兰威士忌、烈酒和苦艾酒混合。搅拌均匀。滤入鸡尾酒杯。用柠檬片装饰。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "In un mixing glass riempito a metà con cubetti di ghiaccio, unire lo scotch, il drambuie e il vermouth. Filtrare in un bicchiere da cocktail. Guarnire con la scorza di limone. Mescolare bene.", :strMeasure2 "1/2 oz ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2016-07-19 11:24:41", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Drambuie", :strMeasure4 "1 twist of ", :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "In einem Mischglas, das halb mit Eiswürfeln gefüllt ist, Scotch, Drambuie und Wermut kombinieren. Gut umrühren. In ein Cocktailglas abseihen. Mit der Zitronenscheibe garnieren.", :strDrinkAlternate nil, :strIngredient3 "Dry Vermouth", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Dans un verre à mélange à moitié rempli de glaçons, mélanger tous les ingrédients. Bien mélanger. Filtrer dans un verre à cocktail.", :strVideo nil, :strInstructions "In a mixing glass half-filled with ice cubes, combine all of the ingredients. Stir well. Strain into a cocktail glass.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil,