ients avec de la glace, filtrer dans un verre à cocktail et servir.", :strVideo nil, :strInstructions "Shake all ingredients with ice, strain into a cocktail glass, and serve.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 1/4 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Cherry Rum", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/twsuvr1441554424.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 tblsp ", :strInstructionsES "Agitar todos los ingredientes con hielo, colar en una copa de cóctel y servir.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Light rum", :idDrink "11239", :strInstructionsZH-HANT "將所有材料加冰搖勻，濾入雞尾酒杯中即可享用。", :strInstructionsZH-HANS "将所有原料加冰摇匀​​，滤入鸡尾酒杯中即可享用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Shakerare tutti gli ingredienti con ghiaccio, filtrare in una coppetta da cocktail e servire.", :strMeasure2 "1 1/2 tsp ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-09-06 16:47:04", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Cherry brandy", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "Alle Zutaten mit Eis schütteln, in ein Cocktailglas abseihen und servieren.", :strDrinkAlternate nil, :strIngredient3 "Light cream", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Mettre tous les ingrédients dans un verre Collins rempli de glace. Garnir d'un quartier de citron vert.", :strVideo nil, :strInstructions "Build all ingredients in a Collins glass filled with ice. Garnish with lime wedge.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "IBA,ContemporaryClassic", :strMeasure1 "2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution "Martin Belam (currybet)", :strDrink "Cuba Libre", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/wmkbfj1606853905.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 nil, :strInstructionsES "Poner todos los ingredientes en un vaso Collins lleno de hielo. Decorar con una rodaja de lima.", :strIngredient15 nil, :strIBA "Contemporary Classics", :strIngredient11 nil, :strIngredient1 "Light rum", :idDrink "11288", :strInstructionsZH-HANT "將所有原料放入裝滿冰塊的柯林斯玻璃杯中。用酸橙角裝飾。", :strInstructionsZH-HANS "将所有原料放入装满冰块的柯林斯玻璃杯中。用酸橙角装饰。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Mettere tutti gli ingredienti in un bicchiere Collins pieno di ghiaccio. Guarnire con uno spicchio di lime.", :strMeasure2 "Juice of 1/2 ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2016-09-06 23:41:03", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Lime", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource "https://commons.wikimedia.org/wiki/File:Cuba_Libre.jpg", :strIngredient8 nil, :strGlass "Highball glass", :strInstructionsDE "Geben Sie alle Zutaten in ein mit Eis gefülltes Collins-Glas. Mit Limettenkeil garnieren.", :strDrinkAlternate nil, :strIngredient3 "Coca-Cola", :strCreativeCommonsConfirmed "Yes", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Añejo rum", :strMeasure11 nil, :strInstructionsFR "Couper à nouveau le demi-citron vert en deux. Ajoutez le citron vert, le falernum et les amers dans un verre à glace. Mélanger. Ajouter le rhum. (Le rhum de la Barbade vieilli, tel que Plantation 5 ans, est recommandé). Ajoutez de la glace et remuez. Faire flotter le rhum blackstrap sur le dessus. Servir avec une paille.", :strVideo nil, :strInstructions "Cut the half lime in half again. Add the lime, falernum, and bitters to a rocks glass. Muddle. Add the rum. (Aged Barbados rum such as Plantation 5 Year is recommended). Add ice and stir. Float the blackstrap rum on top. Serve with a straw.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1/2", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "blackstrap rum", :strImageAttribution nil, :strDrink "Corn n Oil", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/pk6dwi1592767243.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "2 dashes", :strInstructionsES "Volver a cortar la media lima por la mitad. Añada la lima, el falernum y el amargo a un vaso con hielo. Mezcle. Añadir el ron. (Se recomienda ron añejo de Barbados, como Plantation 5 años). Añadir hielo y remover. Dejar flotar el ron blackstrap por encima. Servir con pajita.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Lime", :idDrink "17830", :strInstructionsZH-HANT "再次將半顆酸橙切成兩半。將青檸、法樂努和苦精倒入岩石杯中。混亂。加入蘭姆酒。 （推薦陳年巴貝多蘭姆酒，例如Plantation 5 Year）。加冰並攪拌。將黑帶蘭姆酒浮在上面。用吸管食用。", :strInstructionsZH-HANS "再次将半个酸橙切成两半。将青柠、法乐努和苦精倒入岩石杯中。混乱。添加朗姆酒。 （推荐陈年巴巴多斯朗姆酒，例如Plantation 5 Year）。加冰并搅拌。将黑带朗姆酒浮在上面。用吸管食用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Taglia a metà il lime.\r\nAggiungere il lime, il falernum e il bitter in un bicchiere.\r\nAggiungi il rum.\r\n(Si consigliano rum Barbados invecchiato come Plantation 5 Year).\r\nAggiungi il ghiaccio e mescola.\r\nVersa il rum blackstrap sopra.\r\nServire con una cannuccia.", :strMeasure2 "1/3 oz", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2018-06-27 15:15:09", :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Falernum", :strMeasure4 "1 oz", :strMeasure5 "1 oz", :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Old-fashioned glass", :strInstructionsDE "Die halbe Limette wieder in zwei Hälften schneiden. Füge Limette, Falernum und Bitter in ein Rocks Glas. Mischen. Den Rum hinzufügen. (Gereifter Barbados-Rum wie z.B. Plantation 5 Year wird empfohlen). Eis hinzufügen und umrühren. Blackstrap Rum dazugeben. Mit einem Strohhalm servieren.", :strDrinkAlternate nil, :strIngredient3 "Angostura Bitters", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Versez la moitié du coca dans un verre. Ajoutez ensuite du Bacardi et complétez avec le reste du coca. Remuez et buvez !", :strVideo nil, :strInstructions "Pour half of coke in a glass. Then add Bacardi and top it off with the remaining coke. Stir and drink up!", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 part ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Citrus Coke", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/uyrvut1479473214.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 nil, :strInstructionsES "Vierte la mitad de la coca-cola en un vaso. Añade Bacardi y completa con el resto de la Coca-Cola. Remueve y ¡a beber!", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Bacardi Limon", :idDrink "17135", :strInstructionsZH-HANT "將一半可樂倒入玻璃杯中。然後加入百加得，最後加入剩餘的可樂。攪拌均勻即可飲用！", :strInstructionsZH-HANS "将一半可乐倒入玻璃杯中。然后加入百加得，最后加入剩余的可乐。搅拌均匀即可饮用！", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Versare metà della coca cola in un bicchiere.\r\nQuindi aggiungere il Bacardi e completare con la coca cola rimanente.\r\nMescola e bevi!", :strMeasure2 "2 parts ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2016-11-18 12:46:54", :strMeasure8 nil, :strCategory "Soft Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Coca-Cola", :strMeasure4 nil, :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Highball Glass", :strInstructionsDE "Die Hälfte der Cola in ein Glas gießen. Dann Bacardi hinzufügen und mit dem verbleibenden Cola auffüllen. Rühren und trinken!", :strDrinkAlternate nil, :strIngredient3 nil, :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Maraschino liqueur", :strMeasure11 nil, :strInstructionsFR "Secouer tous les ingrédients avec de la glace, filtrer dans un verre à cocktail et servir.", :strVideo nil, :strInstructions "Shake all ingredients with ice, strain into a cocktail glass, and serve.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Casa Blanca", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/usspxq1441553762.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 1/2 tsp ", :strInstructionsES "Agitar todos los ingredientes con hielo, colar en una copa de cóctel y servir.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Light rum", :idDrink "11222", :strInstructionsZH-HANT "將所有材料加冰搖勻，濾入雞尾酒杯中即可享用。", :strInstructionsZH-HANS "将所有原料加冰摇匀​​，滤入鸡尾酒杯中即可享用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Shakerare tutti gli ingredienti con ghiaccio, filtrare in una coppetta da cocktail e servire.", :strMeasure2 "1 1/2 tsp ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2015-09-06 16:36:02", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Triple sec", :strMeasure4 "1 1/2 tsp ", :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "Alle Zutaten mit Eis schütteln, in ein Cocktailglas abseihen und servieren.", :strDrinkAlternate nil, :strIngredient3 "Lime juice", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Egg white", :strMeasure11 nil, :strInstructionsFR "Secouez les ingrédients pour les émulsionner, ajoutez de la glace, secouez et servez di