il, :strIngredient7 nil, :strMeasure3 "3/4 oz", :strInstructionsES "Agitar, colar, levantar, copa de cóctel.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Gin", :idDrink "17249", :strInstructionsZH-HANT "搖勻，過濾，向上，雞尾酒杯", :strInstructionsZH-HANS "摇匀，过滤，向上，鸡尾酒杯", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Agitare, filtrare, su un bicchiere da cocktail", :strMeasure2 "3/4 oz", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-12-19 17:18:23", :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Orange Curacao", :strMeasure4 "1 dash", :strMeasure5 "1 dash", :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "Schütteln, abseihen, auffüllen, Cocktailglas.", :strDrinkAlternate nil, :strIngredient3 "Lime Juice", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Egg white", :strMeasure11 nil, :strInstructionsFR "Secouez tous les ingrédients avec de la glace, filtrez dans un verre à cocktail et servez.", :strVideo nil, :strInstructions "Shake all ingredients with ice, strain into a cocktail glass, and serve.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "1 1/2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Pink Lady", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/5ia6j21504887829.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "1 tsp ", :strInstructionsES "Agite todos los ingredientes con hielo, cuele en una copa de cóctel y sirva.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Gin", :idDrink "11938", :strInstructionsZH-HANT "將所有材料加冰搖勻，濾入雞尾酒杯中即可享用。", :strInstructionsZH-HANS "将所有原料加冰摇匀​​，滤入鸡尾酒杯中即可享用。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Shakerare tutti gli ingredienti con ghiaccio, filtrare in una coppetta da cocktail e servire.", :strMeasure2 "1 tsp ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-09-08 17:23:49", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Grenadine", :strMeasure4 "1 ", :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Cocktail glass", :strInstructionsDE "Alle Zutaten mit Eis schütteln, in ein Cocktailglas abseihen und servieren.", :strDrinkAlternate nil, :strIngredient3 "Light cream", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Lime Juice", :strMeasure11 nil, :strInstructionsFR "Secouer lentement dans un shaker avec de la glace, puis filtrer dans un verre à whisky carré. Compléter avec de la glace fraîche. Ajoutez les mûres pour décorer. Ajoutez des fleurs et une feuille verte pour un look spécial !", :strVideo nil, :strInstructions "Slowly shake in a shaker with ice, strain into a square whiskey glass. Top with fresh ice. Add the blackberries to garnish. Add flowers and a green leaf for a special look!", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags "Fresh, Summer, Colourful, Nature", :strMeasure1 "1 shot", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Blackberries", :strImageAttribution nil, :strDrink "Pink Moon", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/lnjoc81619696191.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "25 ml", :strInstructionsES "Agitar lentamente en una coctelera con hielo, colar en un vaso cuadrado de whisky. Cubrir con hielo fresco. Añadir las moras para adornar. Añada flores y una hoja verde para darle un toque especial.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Gin", :idDrink "178354", :strInstructionsZH-HANT "在加冰的搖酒器中慢慢搖勻，濾入方形威士忌杯中。上面放上新鮮的冰塊。加入黑莓裝飾。添加花朵和綠葉以獲得特別的外觀！", :strInstructionsZH-HANS "在加冰的摇酒器中慢慢摇匀，滤入方形威士忌杯中。上面放上新鲜的冰块。加入黑莓装饰。添加花朵和绿叶以获得特别的外观！", :strMeasure9 nil, :strMeasure7 "", :strInstructionsIT "Shakerare lentamente nello shaker con ghiaccio, filtrare in un bicchiere da whisky quadrato. Completare con ghiaccio fresco. Aggiungere le more per guarnire. Aggiungi fiori e una foglia verde per un look speciale!", :strMeasure2 "1 shot", :strMeasure12 nil, :strMeasure10 nil, :dateModified nil, :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 "", :strMeasure14 nil, :strIngredient2 "Coconut Liqueur", :strMeasure4 "30 ml", :strMeasure5 "Garnish with", :strIngredient6 nil, :strImageSource "Instagram @ cocktailsplace", :strIngredient8 nil, :strGlass "Whiskey Glass", :strInstructionsDE "In einem Shaker mit Eis langsam schütteln und in ein quadratisches Whiskeyglas abseihen. Mit frischem Eis belegen. Zum Garnieren die Brombeeren hinzufügen. Fügen Sie Blumen und ein grünes Blatt für einen besonderen Look hinzu!", :strDrinkAlternate nil, :strIngredient3 "Elderflower cordial", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Ginger Syrup", :strMeasure11 nil, :strInstructionsFR "Mélanger le scotch, le jus de citron, le sirop de miel et le sirop de gingembre avec de la glace. Filtrer sur une grande quantité de glace dans un verre à glace glacée. Faire flotter le scotch fumé sur le dessus (veiller à utiliser un scotch fumé tel qu'un single malt Islay). Décorer avec du gingembre confit.", :strVideo nil, :strInstructions "Shake blended Scotch, lemon juice, honey syrup and ginger syrup with ice. Strain over large ice in chilled rocks glass. Float smoky Scotch on top (be sure to use a smoky Scotch such as an Islay single malt). Garnish with candied ginger.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 oz", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 "Islay single malt Scotch", :strImageAttribution nil, :strDrink "Penicillin", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/hc9b1a1521853096.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "2 tsp", :strInstructionsES "Agitar con hielo la mezcla de whisky, zumo de limón, sirope de miel y sirope de jengibre. Colar sobre hielo grande en un vaso con hielo frío. Dejar flotar el whisky ahumado por encima (asegúrese de utilizar un whisky ahumado como un Islay single malt). Decorar con jengibre confitado.", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Blended Scotch", :idDrink "17829", :strInstructionsZH-HANT "將混合蘇格蘭威士忌、檸檬汁、蜂蜜糖漿和薑糖漿加冰搖勻。將大塊冰濾入冰鎮的岩石玻璃杯中。將煙燻蘇格蘭威士忌放在上面（一定要使用煙燻蘇格蘭威士忌，例如艾雷島單一麥芽威士忌）。用蜜餞薑裝飾。", :strInstructionsZH-HANS "将混合苏格兰威士忌、柠檬汁、蜂蜜糖浆和姜糖浆加冰摇匀。将大块冰滤入冰镇的岩石玻璃杯中。将烟熏苏格兰威士忌放在上面（一定要使用烟熏苏格兰威士忌，例如艾雷岛单一麦芽威士忌）。用蜜饯姜装饰。", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Shakerare Scotch Blended, succo di limone, sciroppo di miele e sciroppo di zenzero con ghiaccio.\r\nFiltrare con del ghiaccio in un bicchiere freddo.\r\nVersa sopra il bicchiere uno scotch fumoso (assicurati di usare uno scotch affumicato come un single malt di Islay).\r\nGuarnire con lo zenzero candito.", :strMeasure2 "3/4 oz", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2018-03-24 00:58:16", :strMeasure8 nil, :strCategory "Cocktail", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Lemon Juice", :strMeasure4 "2 tsp", :strMeasure5 "1/4 oz", :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Old-fashioned glass", :strInstructionsDE "Schütteln Sie gemischten Scotch, Zitronensaft, Honigsirup und Ingwersirup mit Eis. Über großes Eis in gekühltem Rocks Glas abseihen. Geben Sie rauchigen Scotch darauf (verwenden Sie unbedingt einen rauchigen Scotch wie z.B. Islay Single Malt). Mit kandiertem Ingwer garnieren. ", :strDrinkAlternate nil, :strIngredient3 "Honey syrup", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 "Ice", :strMeasure11 nil, :strInstructionsFR "Agiter vigoureusement et filtrer le contenu 