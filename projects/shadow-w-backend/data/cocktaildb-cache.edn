at!!!!!!!!", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :strDrink "Caipirissima", :strDrinkThumb "https://www.thecocktaildb.com/images/media/drink/yd47111503565515.jpg", :strMeasure15 nil, :strIngredient7 nil, :strMeasure3 "2-3 oz ", :strInstructionsES "Igual que la Caipirinha pero en vez de cachaca se le añade RON BLANCO. ¡¡¡¡¡¡¡¡Es genial!!!!!!!!", :strIngredient15 nil, :strIBA nil, :strIngredient11 nil, :strIngredient1 "Lime", :idDrink "13206", :strInstructionsZH-HANT "與凱匹林納雞尾酒相同，但您添加的是白蘭姆酒而不是卡查卡酒。這很棒！ ！ ！ ！ ！ ！ ！ ！", :strInstructionsZH-HANS "与凯匹林纳鸡尾酒相同，但您添加的是白朗姆酒而不是卡查卡酒。这很棒！！！！！！！！", :strMeasure9 nil, :strMeasure7 nil, :strInstructionsIT "Come la Caipirinha ma al posto della cachaca aggiungi del rum bianco.\r\nÈ ottimo!", :strMeasure2 "2 tblsp ", :strMeasure12 nil, :strMeasure10 nil, :dateModified "2017-08-24 10:05:15", :strMeasure8 nil, :strCategory "Ordinary Drink", :strMeasure6 nil, :strMeasure14 nil, :strIngredient2 "Sugar", :strMeasure4 "crushed ", :strMeasure5 nil, :strIngredient6 nil, :strImageSource nil, :strIngredient8 nil, :strGlass "Collins Glass", :strInstructionsDE "Wie Caipirinha, aber anstelle von Cachaca fügen Sie WHITE RUM hinzu. Es ist großartig!!!!!!!!", :strDrinkAlternate nil, :strIngredient3 "White rum", :strCreativeCommonsConfirmed "No", :strAlcoholic "Alcoholic", :strIngredient14 nil} {:strIngredient4 nil, :strMeasure11 nil, :strInstructionsFR "Dans un shaker à moitié rempli de glaçons, mélanger tous les ingrédients. Bien agiter. Filtrer dans un verre à cocktail.", :strVideo nil, :strInstructions "In a shaker half-filled with ice cubes, combine all of the ingredients. Shake well. Strain into a cocktail glass.", :strIngredient10 nil, :strMeasure13 nil, :strIngredient12 nil, :strTags nil, :strMeasure1 "2 oz ", :strIngredient9 nil, :strIngredient13 nil, :strIngredient5 nil, :strImageAttribution nil, :s